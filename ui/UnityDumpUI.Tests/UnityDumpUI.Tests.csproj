<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UnityDumpUI.Tests</RootNamespace>
    <AssemblyName>UnityDumpUI.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Test project doesn't need AOT — disable inherited analyzers that would
         choke on xUnit's reflection-based discovery. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>

    <!-- .NET 10 SDK + Microsoft.Testing.Platform.MSBuild 2.2.3 disabled
         the legacy VSTest target. Opt into the Microsoft Testing Platform
         runner (xunit.v3 ships native MTP support so no test-code change
         needed). `dotnet test` now drives the new runner directly. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3 (per project decision) -->
    <PackageReference Include="Avalonia.Angle.Windows.Natives" Version="2.1.27548.20260419" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.5" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.5" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="8.3.1.5" />
    <PackageReference Include="MicroCom.Runtime" Version="0.11.6" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.8" />
    <!-- Microsoft.Testing.Platform.* packages intentionally NOT pinned —
         xunit.v3 brings in a compatible Microsoft.Testing.Platform
         version transitively. Pinning 2.2.3 explicitly here broke two
         things: (1) Microsoft.Testing.Platform.MSBuild 2.2.3 refuses the
         classic `dotnet test` VSTest path on .NET 10 SDK; (2)
         Microsoft.Testing.Platform 2.2.3's IOutputDevice.DisplayAsync
         signature drifted from what xunit.v3 3.2.2 was built against
         (MissingMethodException at runtime). Let xunit.v3 own the
         testing-platform version selection. -->
    <!-- Newtonsoft.Json kept explicit — bumped to a non-vulnerable
         version above the transitive default. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageReference Include="xunit.v3" Version="3.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityDumpUI.Core\UnityDumpUI.Core.csproj" />
    <!-- Phase 29c-8: persistence integration tests construct
         SnapshotViewModel directly. The UI exe project is referenced as
         a library here — the WinExe output type doesn't interfere with
         consuming it via ProjectReference. -->
    <ProjectReference Include="..\UnityDumpUI\UnityDumpUI.csproj" />
  </ItemGroup>
</Project>
