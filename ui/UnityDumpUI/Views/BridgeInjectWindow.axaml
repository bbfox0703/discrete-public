<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UnityDumpUI.Views.BridgeInjectWindow"
        Title="Inject Discrete Bridge"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel Margin="14">
        <!-- Footer buttons -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,14,0,0">
            <Button Content="Cancel" Click="OnCancelClicked" MinWidth="80"/>
            <Button Content="Inject" Click="OnInjectClicked" MinWidth="80" IsDefault="True"/>
        </StackPanel>

        <StackPanel Spacing="12">
            <TextBlock Text="Pick which Lua tools to embed in the open CE table. Only the selected files are injected and loaded by the &quot;Load Discrete Bridge&quot; AA script — leave out what this table doesn't use."
                       TextWrapping="Wrap" Opacity="0.8" FontSize="12"/>

            <!-- Core — always included, shown disabled so the user knows it's mandatory -->
            <StackPanel Spacing="2">
                <CheckBox Content="Core — inject backend DLL + start pipe"
                          IsChecked="True" IsEnabled="False"
                          FontWeight="SemiBold"/>
                <TextBlock Text="utils.lua + unity_dump.lua. Always included — the bridge does nothing without them."
                           TextWrapping="Wrap" Opacity="0.65" FontSize="11"
                           Margin="22,0,0,0"/>
            </StackPanel>

            <!-- Optional features -->
            <StackPanel Spacing="2">
                <TextBlock Text="Optional tools" FontWeight="SemiBold"/>

                <CheckBox Name="DissectCheckbox" IsChecked="True"
                          Content="Structure Dissect (unity_dissect.lua)"/>
                <CheckBox Name="SymbolsCheckbox" IsChecked="True"
                          Content="Symbol registration (unity_symbols.lua + mono helpers)"/>
                <CheckBox Name="AddressFinderCheckbox" IsChecked="True"
                          Content="Reverse address lookup (unity_addrfind.lua)"/>
                <CheckBox Name="InvokeCheckbox" IsChecked="True"
                          Content="Call managed methods (unity_invoke.lua)"/>
                <CheckBox Name="SceneCheckbox" IsChecked="True"
                          Content="Scene / GameObject explorer (unity_scene.lua)"/>
            </StackPanel>

            <TextBlock Text="Ship the backend DLLs next to your .CT: Discrete-Mono.dll, Discrete-IL2CPP.dll, and Discrete-Mono-x86.dll (32-bit Mono). The bridge picks the right one by backend + bitness at runtime."
                       TextWrapping="Wrap" Opacity="0.6" FontSize="11"/>
        </StackPanel>
    </DockPanel>
</Window>
