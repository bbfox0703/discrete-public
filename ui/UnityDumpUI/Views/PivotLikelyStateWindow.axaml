<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnityDumpUI.ViewModels"
        x:Class="UnityDumpUI.Views.PivotLikelyStateWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="900" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="Likely game-state — stable-key + drifting-value classes">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Close" Click="OnCloseClicked" Padding="14,4"/>
    </StackPanel>
    <Border Padding="6" Background="#1F808080" CornerRadius="3">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
          <Button Content="🏅 Rank likely game-state"
                  Command="{Binding ClassPivot.RankLikelyGameStateCommand}" Padding="10,4"/>
          <TextBlock Text="Top-N classes:" VerticalAlignment="Center" Margin="8,0,0,0"/>
          <NumericUpDown Value="{Binding ClassPivot.InterestTopN, Mode=TwoWay}"
                         Minimum="1" Maximum="500" Increment="10"
                         FormatString="0" Width="120" VerticalAlignment="Center"
                         ToolTip.Tip="How many candidates the (slower) volatility pass scores. Higher = broader but slower."/>
          <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBox Text="{Binding ClassPivot.InterestFilter, Mode=TwoWay}"
                   PlaceholderText="class name substring" Width="180" VerticalAlignment="Center"
                   ToolTip.Tip="Case-insensitive substring filter on the ranked class FQN."/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ClassPivot.InterestStatus}"
                   Opacity="0.75" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,2" FontWeight="SemiBold" FontSize="11" Opacity="0.8"
                   Text="Preview — best key : value trajectory (select a row above; double-tap loads it)"/>
        <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding ClassPivot.InterestPreview}"
                 MaxHeight="120" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"/>
        <DataGrid Name="PivotInterestGrid"
                  ItemsSource="{Binding ClassPivot.InterestRows}"
                  SelectedItem="{Binding ClassPivot.SelectedInterestRow, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True" CanUserSortColumns="True"
                  DoubleTapped="OnPivotInterestDoubleTapped">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Class FQN" Binding="{Binding ClassFqn}" Width="Auto" MinWidth="220" SortMemberPath="ClassFqn" CanUserSort="True"/>
            <DataGridTextColumn Header="Assembly" Binding="{Binding Assembly}" Width="Auto" MinWidth="120" SortMemberPath="Assembly" CanUserSort="True"/>
            <DataGridTextColumn Header="Interest" Binding="{Binding InterestDisplay}" Width="75" SortMemberPath="InterestScore" CanUserSort="True"/>
            <DataGridTextColumn Header="KeyScore" Binding="{Binding KeyScoreDisplay}" Width="75" SortMemberPath="BestKeyScore" CanUserSort="True"/>
            <DataGridTextColumn Header="Vol" Binding="{Binding VolDisplay}" Width="60" SortMemberPath="MaxVolatility" CanUserSort="True"/>
            <DataGridTextColumn Header="Key" Binding="{Binding KeyDisplay}" Width="Auto" MinWidth="140"/>
            <DataGridTextColumn Header="Top values" Binding="{Binding ValuesDisplay}" Width="Auto" MinWidth="160"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
