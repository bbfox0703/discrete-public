<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnityDumpUI.ViewModels"
        x:Class="UnityDumpUI.Views.ProcessPickerWindow"
        x:DataType="vm:ProcessPickerViewModel"
        Width="640" Height="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="{StaticResource Picker.Title}">
  <DockPanel LastChildFill="True" Margin="12">

    <!-- Top bar: filter + show-all + refresh -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
      <TextBox Grid.Column="0"
               PlaceholderText="{StaticResource Picker.FilterWatermark}"
               Text="{Binding Filter, Mode=TwoWay}" />
      <CheckBox Grid.Column="1"
                Content="{StaticResource Picker.ShowAll}"
                IsChecked="{Binding ShowAll, Mode=TwoWay}"
                Margin="8,0,0,0" VerticalAlignment="Center" />
      <Button   Grid.Column="2"
                Content="{StaticResource Picker.Refresh}"
                Command="{Binding RefreshCommand}"
                Margin="8,0,0,0" />
    </Grid>

    <ProgressBar DockPanel.Dock="Top"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsLoading}"
                 Height="3" Margin="0,0,0,4" />

    <Border DockPanel.Dock="Top"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="#33D32F2F" BorderBrush="#88D32F2F"
            BorderThickness="1" CornerRadius="4" Padding="10,6"
            Margin="0,0,0,8">
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="#FFD32F2F" TextWrapping="Wrap" />
    </Border>

    <!-- Bottom: cancel + inject -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="{StaticResource Picker.Cancel}"
              Click="OnCancelClicked" />
      <Button Content="{StaticResource Picker.InjectAndConnect}"
              IsEnabled="{Binding HasSelection}"
              Classes="accent"
              Click="OnAcceptClicked" />
    </StackPanel>

    <!-- Process grid -->
    <DataGrid ItemsSource="{Binding FilteredProcesses}"
              SelectedItem="{Binding Selected, Mode=TwoWay}"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              GridLinesVisibility="Horizontal"
              x:DataType="vm:ProcessPickerViewModel">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource Picker.ColPid}"     Width="80"
                            Binding="{Binding Pid, x:DataType=vm:ProcessRow}" />
        <DataGridTextColumn Header="{StaticResource Picker.ColName}"    Width="180"
                            Binding="{Binding Name, x:DataType=vm:ProcessRow}" />
        <DataGridTextColumn Header="{StaticResource Picker.ColBackend}" Width="90"
                            Binding="{Binding BackendLabel, x:DataType=vm:ProcessRow}" />
        <DataGridTextColumn Header="{StaticResource Picker.ColPath}"    Width="*"
                            Binding="{Binding Path, x:DataType=vm:ProcessRow}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
