<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnityDumpUI.ViewModels"
        x:Class="UnityDumpUI.Views.PivotArrayWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="900" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="Pivot array elements by an inner field">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Close" Click="OnCloseClicked" Padding="14,4"/>
    </StackPanel>
    <Border Padding="6" Background="#1F808080" CornerRadius="3">
      <DockPanel>
        <CheckBox DockPanel.Dock="Top"
                  Content="Enable — pivot a reference array's elements by an inner field"
                  IsChecked="{Binding ClassPivot.ArrayPivotMode, Mode=TwoWay}"
                  ToolTip.Tip="Pivot the ELEMENTS of a reference-type array field by a field INSIDE each element. The Pivot query's 'Key fields' become the outer owner-instance key (may be empty); the fields here key/value the element. Needs snapshots captured with 'Capture array element fields'."/>
        <Grid DockPanel.Dock="Top" Margin="0,6,0,0"
              ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto"
              ColumnSpacing="6" IsVisible="{Binding ClassPivot.ArrayPivotMode}">
          <TextBlock Grid.Column="0" Text="Array field:" VerticalAlignment="Center"/>
          <AutoCompleteBox Grid.Column="1" Text="{Binding ClassPivot.ArrayFieldName, Mode=TwoWay}"
                           ItemsSource="{Binding ClassPivot.KnownArrayFields}"
                           PlaceholderText="_statAdditionData" MinimumPrefixLength="0"
                           FilterMode="ContainsOrdinal"
                           ToolTip.Tip="Reference-type array field whose elements to pivot."/>
          <TextBlock Grid.Column="2" Text="Inner key:" VerticalAlignment="Center"/>
          <AutoCompleteBox Grid.Column="3" Text="{Binding ClassPivot.InnerKeyFieldsText, Mode=TwoWay}"
                           ItemsSource="{Binding ClassPivot.KnownElementFieldNames}"
                           PlaceholderText="_propertyID" MinimumPrefixLength="0"
                           FilterMode="ContainsOrdinal"
                           ToolTip.Tip="Field name(s) INSIDE each array element that identify it."/>
          <TextBlock Grid.Column="4" Text="Inner value:" VerticalAlignment="Center"/>
          <AutoCompleteBox Grid.Column="5" Text="{Binding ClassPivot.InnerValueFieldsText, Mode=TwoWay}"
                           ItemsSource="{Binding ClassPivot.KnownElementFieldNames}"
                           PlaceholderText="_amount" MinimumPrefixLength="0"
                           FilterMode="ContainsOrdinal"
                           ToolTip.Tip="Field name(s) INSIDE each array element whose trajectory to track."/>
        </Grid>
        <DockPanel IsVisible="{Binding ClassPivot.ArrayPivotMode}">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,8,0,4">
            <Button Content="⟳ Score element fields"
                    Command="{Binding ClassPivot.ScoreElementFieldsCommand}" Padding="10,4"/>
            <TextBlock Text="Filter:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding ClassPivot.ElementFieldScoreFilter, Mode=TwoWay}"
                     PlaceholderText="field name" Width="140" VerticalAlignment="Center"/>
            <TextBlock Text="Suggested inner key:" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding ClassPivot.SuggestedInnerKeyDisplay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Button Content="Apply suggested inner key"
                    Command="{Binding ClassPivot.ApplySuggestedInnerKeyCommand}" Padding="8,3"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding ClassPivot.SuggestedInnerKeyReason}"
                     Opacity="0.75" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding ClassPivot.ElementFieldScoreStatus}"
                     Opacity="0.75" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <DataGrid Name="PivotElementFieldScoreGrid"
                    ItemsSource="{Binding ClassPivot.ElementFieldScores}"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    CanUserResizeColumns="True" CanUserSortColumns="True"
                    DoubleTapped="OnPivotElementFieldScoreDoubleTapped">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Add to Inner key fields" Click="OnPivotElementFieldAddToInnerKeysClicked"/>
                <MenuItem Header="Add to Inner value fields" Click="OnPivotElementFieldAddToInnerValuesClicked"/>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="Auto" MinWidth="200" SortMemberPath="FieldName" CanUserSort="True"/>
              <DataGridTextColumn Header="Type" Binding="{Binding FieldType}" Width="Auto" MinWidth="160" SortMemberPath="FieldType" CanUserSort="True"/>
              <DataGridTextColumn Header="Score" Binding="{Binding ScoreDisplay}" Width="70" SortMemberPath="Score" CanUserSort="True"/>
              <DataGridTextColumn Header="Stable" Binding="{Binding StablePctDisplay}" Width="70" SortMemberPath="SStable" CanUserSort="True"/>
              <DataGridTextColumn Header="Card" Binding="{Binding CardPctDisplay}" Width="70" SortMemberPath="SCardinality" CanUserSort="True"/>
              <DataGridTextColumn Header="Type pr." Binding="{Binding TypePriorDisplay}" Width="70" SortMemberPath="TypePrior" CanUserSort="True"/>
              <DataGridTextColumn Header="Name pr." Binding="{Binding NamePriorDisplay}" Width="70" SortMemberPath="NamePrior" CanUserSort="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
