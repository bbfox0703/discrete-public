<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnityDumpUI.ViewModels"
        xmlns:services="using:UnityDumpUI.Core.Services"
        xmlns:controls="using:UnityDumpUI.Controls"
        xmlns:converters="using:UnityDumpUI.Views.Converters"
        x:Class="UnityDumpUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="780"
        Icon="avares://DiscreteUI/Assets/MainIcon.ico"
        Title="{StaticResource App.Title}">
  <!-- Five-pane shell:
         Assemblies | Classes | Fields/Methods detail (with handshake summary on top)
       Each list has its own filter; the right pane is driven by the
       AssemblyBrowserViewModel selection cascade. -->
  <DockPanel LastChildFill="True">

    <!-- Top connection bar -->
    <Border DockPanel.Dock="Top"
            BorderBrush="#22000000" BorderThickness="0,0,0,1"
            Padding="12,8">
    <!-- Single-cell overlay. The dev-tool reminder is declared FIRST (lowest
         Z-order) and right-aligned; the functional controls StackPanel is
         declared AFTER (higher Z-order), so when the window is too narrow to
         show both the controls draw on top of — i.e. cover — the reminder
         rather than pushing it off-screen. -->
    <Grid>
      <!-- Dev-tool reminder. DiscreteUI is for developers + power users;
           CE-table publishers should embed the backend DLL + scripts inside
           their .CT (see scripts/ce_table_bootstrap.lua) instead of
           distributing DiscreteUI.exe to end users. Subtle, never dismissable,
           lowest Z-order so functional controls win the space when it's tight. -->
      <TextBlock Text="{StaticResource App.DevToolWarning}"
                 ToolTip.Tip="{StaticResource App.DevToolWarningTooltip}"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Right"
                 ZIndex="0"
                 Opacity="0.55"
                 Foreground="#FFE0A02C" />
      <StackPanel Orientation="Horizontal" Spacing="12" ZIndex="1">
        <Button Content="{StaticResource Conn.Inject}"
                Command="{Binding InjectAndConnectCommand}" />
        <Button Content="{StaticResource Conn.Connect}"
                Command="{Binding ConnectCommand}" />
        <Button Content="{StaticResource Conn.Disconnect}"
                Command="{Binding DisconnectCommand}" />

        <!-- Phase 12c (v2): proxy deploy is a dedicated multi-select panel.
             Click opens ProxyDeployWindow non-modally so the user can keep
             it open while connecting / browsing in this window. -->
        <Button Content="{StaticResource Conn.ProxyDeploy}"
                Command="{Binding OpenProxyDeployCommand}" />

        <!-- Open the log root (%LOCALAPPDATA%\Discrete_Dumper\Logs) in Explorer —
             holds the UI's `ui\` tree and the DLL's per-PID folders. Code-behind
             Click (shell-open is a view concern); folder is created on demand so
             the shell call never sees a missing path. -->
        <Button Content="{StaticResource Conn.OpenLogFolder}"
                Click="OnOpenLogFolderClicked"
                ToolTip.Tip="Open the log folder (%LOCALAPPDATA%\Discrete_Dumper\Logs) — UI logs under ui\, DLL logs under &lt;pid&gt;\." />

        <!-- Phase 22d: Tools menu. Currently houses one entry (Inject
             Discrete Bridge); future entries (Phase 22e per-feature
             "Send to CE Table" actions) will join here. The button
             stays clickable even when AOBMaker isn't reachable; the
             menu item itself surfaces the plugin-not-connected case
             via BridgeInjectStatus rather than greying out the menu
             (avoids a chicken-and-egg "open CE first to enable the
             menu, but the menu is what asks you to open CE" loop). -->
        <Button Content="{StaticResource Conn.ToolsMenu}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{StaticResource Tools.InjectDiscreteBridge}"
                        Command="{Binding InjectDiscreteBridgeCommand}"
                        ToolTip.Tip="{StaticResource Tools.InjectDiscreteBridgeTooltip}" />
              <Separator/>
              <MenuItem Header="{StaticResource Tools.ExportSymbolsX64dbg}"
                        Command="{Binding ExportSymbolsX64dbgCommand}"
                        ToolTip.Tip="{StaticResource Tools.ExportSymbolsTooltip}" />
              <MenuItem Header="{StaticResource Tools.ExportSymbolsGhidra}"
                        Command="{Binding ExportSymbolsGhidraCommand}"
                        ToolTip.Tip="{StaticResource Tools.ExportSymbolsTooltip}" />
              <MenuItem Header="{StaticResource Tools.ExportSymbolsIda}"
                        Command="{Binding ExportSymbolsIdaCommand}"
                        ToolTip.Tip="{StaticResource Tools.ExportSymbolsTooltip}" />
              <Separator/>
              <MenuItem Header="{StaticResource Tools.ExportIl2cppHeader}"
                        Command="{Binding ExportIl2cppHeaderCommand}"
                        ToolTip.Tip="{StaticResource Tools.ExportIl2cppHeaderTooltip}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- Handshake summary moved out of the right-pane (was an
             Expander above the tab strip eating a whole row).  Now
             sits as a Flyout button on the top toolbar — same content
             grid, one click reveals; click anywhere outside dismisses.
             Keeps the right pane focused on its tabs. -->
        <Button Content="ℹ Handshake"
                ToolTip.Tip="Engine / Backend / DllVariant / GameModule / UnityVersion / MetadataVersion / AssembliesCount / Build / Protocol — the post-connect inventory the DLL reports back.">
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <Grid ColumnDefinitions="180,260"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="6" Margin="4">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource Handshake.Engine}"          Opacity="0.7" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Engine}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource Handshake.Backend}"         Opacity="0.7" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Backend2}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource Handshake.DllVariant}"      Opacity="0.7" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DllVariant}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{StaticResource Handshake.GameModule}"      Opacity="0.7" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GameModule}" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{StaticResource Handshake.UnityVersion}"    Opacity="0.7" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UnityVersion}" />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="{StaticResource Handshake.MetadataVersion}" Opacity="0.7" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MetadataVersion}" />
                <TextBlock Grid.Row="6" Grid.Column="0" Text="{StaticResource Handshake.AssembliesCount}" Opacity="0.7" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AssembliesCount}" />
                <TextBlock Grid.Row="7" Grid.Column="0" Text="{StaticResource Handshake.Build}"           Opacity="0.7" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Build}" />
                <TextBlock Grid.Row="8" Grid.Column="0" Text="{StaticResource Handshake.Protocol}"        Opacity="0.7" />
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Protocol}" />
              </Grid>
            </Flyout>
          </Button.Flyout>
        </Button>

        <TextBlock Text="{StaticResource Conn.StatusLabel}"
                   VerticalAlignment="Center"
                   Opacity="0.7" />
        <TextBlock Text="{Binding ConnectionStatus}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold" />
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}"
                     Width="120" Height="6"
                     VerticalAlignment="Center" />

        <!-- Phase 22d: AOBMaker pipe availability indicator. Subtle
             dot + label so the user can tell "Tools menu actions will
             reach CE" at a glance without clicking the menu first.
             Updated on every successful/failed AOBMaker request +
             the opportunistic startup probe. -->
        <StackPanel Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="{StaticResource Tools.AobMakerStatusLabel}"
                     Opacity="0.7" />
          <TextBlock Text="{StaticResource Tools.AobMakerConnected}"
                     Foreground="#FF35A744"
                     FontWeight="SemiBold"
                     IsVisible="{Binding IsAobMakerAvailable}" />
          <TextBlock Text="{StaticResource Tools.AobMakerNotConnected}"
                     Opacity="0.55"
                     IsVisible="{Binding !IsAobMakerAvailable}" />
          <!-- Re-probe the AOBMaker CE-plugin pipe on demand (e.g. after loading
               the plugin in CE) instead of waiting for the next request. -->
          <Button Content="↻" FontSize="11" Padding="5,0" MinHeight="18"
                  Command="{Binding RefreshAobMakerCommand}"
                  ToolTip.Tip="{StaticResource Tools.AobMakerRefreshTooltip}" />
        </StackPanel>

        <!-- AOBMaker standalone-app pipe availability (\\.\pipe\AOBMaker →
             GenerateAob). Separate from the CE-plugin DLL indicator above:
             when this is connected, "Copy: aobscan" / "Push aobscan to CE"
             ask the app for a UNIQUE AOB (Mode D) instead of the DLL's
             method-prologue pattern. Same subtle dot + label + ↻ shape. -->
        <StackPanel Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="{StaticResource Tools.AobMakerAppStatusLabel}"
                     Opacity="0.7" />
          <TextBlock Text="{StaticResource Tools.AobMakerAppConnected}"
                     Foreground="#FF35A744"
                     FontWeight="SemiBold"
                     IsVisible="{Binding IsAobMakerAppAvailable}" />
          <TextBlock Text="{StaticResource Tools.AobMakerAppNotConnected}"
                     Opacity="0.55"
                     IsVisible="{Binding !IsAobMakerAppAvailable}" />
          <Button Content="↻" FontSize="11" Padding="5,0" MinHeight="18"
                  Command="{Binding RefreshAobMakerAppCommand}"
                  ToolTip.Tip="{StaticResource Tools.AobMakerAppRefreshTooltip}" />
        </StackPanel>
      </StackPanel>
    </Grid>
    </Border>

    <!-- Phase 22d: bridge inject status line. Appears only after the
         user has clicked Tools→Inject Discrete Bridge once this
         session. Stays put after success/failure so the user can read
         the outcome without timing pressure. Distinct from the
         connection bar's ConnectionStatus (DLL pipe lifecycle) — the
         bridge inject is a separate concern. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding BridgeInjectStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="#1135A744" BorderBrush="#5535A744"
            BorderThickness="0,0,0,1" Padding="12,4">
      <TextBlock Text="{Binding BridgeInjectStatus}"
                 Foreground="#FF35A744" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
    </Border>

    <!-- Bulk-lane busy hint. Shown while a long bulk op (snapshot /
         value-scan) runs; the other bulk start-buttons grey out via their
         CanExecute. Light browse stays usable on the interactive pipe. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding BulkBusyHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="#11D9A406" BorderBrush="#55D9A406"
            BorderThickness="0,0,0,1" Padding="12,4">
      <TextBlock Text="{Binding BulkBusyHint}"
                 Foreground="#FFD9A406" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
    </Border>

    <!-- Phase 14b: stripped/obfuscated metadata warning. Yellow strip
         appears below the connection bar when getMetadataStats reports
         partial_strip / heavy_strip; cleared on disconnect. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasStripWarning}"
            Background="#33D4A017" BorderBrush="#88D4A017"
            BorderThickness="0,0,0,1" Padding="12,6">
      <TextBlock Text="{Binding MetadataWarning}"
                 Foreground="#FFD4A017" TextWrapping="Wrap"
                 FontWeight="SemiBold" />
    </Border>

    <!-- Low-RAM advisory strip. Machine-static (total physical RAM tier),
         set once at startup. Severe (≤16 GB) gets a red tint; caution
         (≤32 GB) the standard yellow. Warns that Snapshot / SPC Query /
         Class Pivot are the memory-heavy operations. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasMemoryWarning}"
            Background="#332E9BD6" BorderBrush="#882E9BD6"
            BorderThickness="0,0,0,1" Padding="12,6">
      <Panel>
        <TextBlock Text="{StaticResource App.MemoryWarningSevere}"
                   IsVisible="{Binding IsMemoryWarningSevere}"
                   Foreground="#FFE03C3C" TextWrapping="Wrap"
                   FontWeight="SemiBold" />
        <TextBlock Text="{StaticResource App.MemoryWarningCaution}"
                   IsVisible="{Binding IsMemoryWarningCaution}"
                   Foreground="#FFD4A017" TextWrapping="Wrap"
                   FontWeight="SemiBold" />
      </Panel>
    </Border>

    <!-- Phase 20-MT v2: auto-prompt runInBackground banner. Surfaces after
         the connect-time dispatcher health probe (CheckDispatcherHealthAsync)
         sees hook_installed=true but is_healthy=false — i.e. the engine is
         alive but Update() isn't ticking, almost always because
         Application.runInBackground=false + the game has lost focus.
         One-shot fix below; dismissable. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding DispatcherBannerVisible}"
            Background="#33D4A017" BorderBrush="#88D4A017"
            BorderThickness="0,0,0,1" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding DispatcherBannerMessage}"
                   Foreground="#FFD4A017" TextWrapping="Wrap"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Grid.Column="1"
                Content="{StaticResource Dispatcher.EnableButton}"
                Command="{Binding EnableRunInBackgroundFromBannerCommand}"
                ToolTip.Tip="{StaticResource Dispatcher.EnableTooltip}"
                Classes="accent"
                Margin="0,0,8,0" />
        <Button Grid.Column="2"
                Content="{StaticResource Dispatcher.DismissButton}"
                Command="{Binding DismissDispatcherBannerCommand}" />
      </Grid>
    </Border>

    <!-- Footer credit — XOR-shielded at rest (see StringShield.cs); decoded
         lazily by the VM. Subtle so it doesn't compete with the connection
         bar; click target only via "Copy text" if the user wants the URL. -->
    <Border DockPanel.Dock="Bottom"
            BorderBrush="#22000000" BorderThickness="0,1,0,0"
            Padding="12,4">
      <!-- Centered group: faint, label-less opt-in for the experimental tabs
           (Snapshot / SPC Query / Class Pivot, hidden by default) sits directly
           to the LEFT of the copyright line. Disables itself once checked →
           ON-only for the session, so a visible experimental tab never needs
           tearing down. Hint only via tooltip. -->
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="6">
        <CheckBox VerticalAlignment="Center"
                  MinWidth="0" Padding="0"
                  Opacity="0.2"
                  IsChecked="{Binding ExperimentalEnabled, Mode=TwoWay}"
                  IsEnabled="{Binding !ExperimentalEnabled}"
                  ToolTip.Tip="Enable experimental features" />
        <TextBlock Text="{Binding CopyrightText}"
                   VerticalAlignment="Center"
                   Opacity="0.55"
                   FontSize="11" />
      </StackPanel>
    </Border>

    <!-- Body -->
    <Grid x:Name="BodyGrid">
      <!-- Column widths are user-resizable via the GridSplitters between
           panes. MinWidth keeps each pane usable; "*" lets the right pane
           absorb whatever's left. -->
      <!-- Column widths get rewritten by MainWindow code-behind on
           IsAssembliesPaneCollapsed / IsClassesPaneCollapsed toggle so
           the user can reclaim the space for the Inspector / Detail pane.
           Initial widths match the historical layout. The code-behind
           reaches each ColumnDefinition by index (0=Assemblies,
           2=Classes) — Avalonia's compiled XAML rejects x:Name on
           ColumnDefinition under Native AOT (it's not a Control with a
           NameScope), hence the index-based access. -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="28" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="280" MinWidth="28" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*"   MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- Pane 1: Assemblies -->
      <DockPanel Grid.Column="0" Margin="8">
        <!-- Header row: title + collapse toggle. The chevron flips between
             ◀ (collapse) and ▶ (expand). Title text is replaced with a
             vertical "A" mnemonic when collapsed so the rail still
             communicates "this is the Assemblies pane". -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock Grid.Column="0"
                     Text="{StaticResource Browser.AssembliesTitle}"
                     FontWeight="SemiBold"
                     IsVisible="{Binding !IsAssembliesPaneCollapsed}" />
          <TextBlock Grid.Column="0"
                     Text="A" FontWeight="Bold" Opacity="0.6"
                     HorizontalAlignment="Center"
                     IsVisible="{Binding IsAssembliesPaneCollapsed}" />
          <Button    Grid.Column="1"
                     Content="◀" FontSize="10" Padding="4,0" MinHeight="20"
                     Command="{Binding ToggleAssembliesPaneCommand}"
                     ToolTip.Tip="{StaticResource Browser.CollapsePaneTooltip}"
                     IsVisible="{Binding !IsAssembliesPaneCollapsed}" />
          <Button    Grid.Column="1"
                     Content="▶" FontSize="10" Padding="4,0" MinHeight="20"
                     Command="{Binding ToggleAssembliesPaneCommand}"
                     ToolTip.Tip="{StaticResource Browser.ExpandPaneTooltip}"
                     IsVisible="{Binding IsAssembliesPaneCollapsed}" />
        </Grid>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4"
              IsVisible="{Binding !IsAssembliesPaneCollapsed}">
          <TextBox x:Name="AssemblyFilterBox"
                   Grid.Column="0"
                   PlaceholderText="{StaticResource Browser.FilterWatermark}"
                   Text="{Binding Browser.AssemblyFilter, Mode=TwoWay}" />
          <Button  Grid.Column="1"
                   Content="{StaticResource Browser.Refresh}"
                   Margin="6,0,0,0"
                   Command="{Binding Browser.RefreshAssembliesCommand}" />
        </Grid>
        <CheckBox DockPanel.Dock="Top" Margin="0,0,0,4"
                  Content="Exclude system assemblies"
                  IsChecked="{Binding Browser.ExcludeSystemAssemblies, Mode=TwoWay}"
                  IsVisible="{Binding !IsAssembliesPaneCollapsed}"
                  ToolTip.Tip="Hide Unity engine / BCL / Microsoft / Mono system assemblies from the list. Assembly-CSharp and third-party gameplay DLLs stay. Composes with the text filter." />
        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding Browser.IsLoadingAssemblies}"
                     Height="3" Margin="0,0,0,4" />
        <ListBox ItemsSource="{Binding Browser.FilteredAssemblies}"
                 SelectedItem="{Binding Browser.SelectedAssembly, Mode=TwoWay}"
                 IsVisible="{Binding !IsAssembliesPaneCollapsed}"
                 x:DataType="vm:MainWindowViewModel">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AssemblyItem">
              <controls:HighlightedTextBlock SourceText="{Binding Name}"
                                             Highlight="{Binding #AssemblyFilterBox.Text}"
                                             TextTrimming="CharacterEllipsis"
                                             ToolTip.Tip="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4"
                    Background="#22000000"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Columns"
                    IsVisible="{Binding !IsAssembliesPaneCollapsed}" />

      <!-- Pane 2: Classes -->
      <DockPanel Grid.Column="2" Margin="8">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock Grid.Column="0"
                     Text="{StaticResource Browser.ClassesTitle}"
                     FontWeight="SemiBold"
                     IsVisible="{Binding !IsClassesPaneCollapsed}" />
          <TextBlock Grid.Column="0"
                     Text="C" FontWeight="Bold" Opacity="0.6"
                     HorizontalAlignment="Center"
                     IsVisible="{Binding IsClassesPaneCollapsed}" />
          <Button    Grid.Column="1"
                     Content="◀" FontSize="10" Padding="4,0" MinHeight="20"
                     Command="{Binding ToggleClassesPaneCommand}"
                     ToolTip.Tip="{StaticResource Browser.CollapsePaneTooltip}"
                     IsVisible="{Binding !IsClassesPaneCollapsed}" />
          <Button    Grid.Column="1"
                     Content="▶" FontSize="10" Padding="4,0" MinHeight="20"
                     Command="{Binding ToggleClassesPaneCommand}"
                     ToolTip.Tip="{StaticResource Browser.ExpandPaneTooltip}"
                     IsVisible="{Binding IsClassesPaneCollapsed}" />
        </Grid>
        <TextBox x:Name="ClassFilterBox"
                 DockPanel.Dock="Top"
                 PlaceholderText="{StaticResource Browser.FilterWatermark}"
                 Text="{Binding Browser.ClassFilter, Mode=TwoWay}"
                 IsVisible="{Binding !IsClassesPaneCollapsed}"
                 Margin="0,0,0,4" />
        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding Browser.IsLoadingClasses}"
                     Height="3" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding Browser.FilteredClasses.Count, StringFormat='\{0\} classes'}"
                   IsVisible="{Binding !IsClassesPaneCollapsed}"
                   Opacity="0.6" FontSize="11" Margin="0,4,0,0" />
        <ListBox ItemsSource="{Binding Browser.FilteredClasses}"
                 SelectedItem="{Binding Browser.SelectedClass, Mode=TwoWay}"
                 IsVisible="{Binding !IsClassesPaneCollapsed}"
                 x:DataType="vm:MainWindowViewModel">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{StaticResource Browser.InspectMenuItem}"
                        Command="{Binding InspectSelectedClassCommand}" />
              <MenuItem Header="Pivot this class…"
                        IsVisible="{Binding ExperimentalEnabled}"
                        Click="OnPivotThisClassFromBrowserClicked" />
              <MenuItem Header="{StaticResource Browser.CopyClassNameMenu}"
                        Click="OnCopyClassNameClicked" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ClassItem">
              <StackPanel ToolTip.Tip="{Binding Tooltip}">
                <controls:HighlightedTextBlock SourceText="{Binding FriendlyName}"
                                               Highlight="{Binding #ClassFilterBox.Text}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                <controls:HighlightedTextBlock SourceText="{Binding Namespace}"
                                               Highlight="{Binding #ClassFilterBox.Text}"
                                               Opacity="0.55" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="3" Width="4"
                    Background="#22000000"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Columns"
                    IsVisible="{Binding !IsClassesPaneCollapsed}" />

      <!-- Pane 3: Detail (fields/methods/etc tabs). Handshake summary
           lives on the top toolbar now (ℹ Handshake flyout button) so
           the right pane goes straight to errors + tabs. -->
      <DockPanel Grid.Column="4" Margin="8">

        <!-- Top errors banner -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#33D32F2F" BorderBrush="#88D32F2F"
                BorderThickness="1" CornerRadius="4" Padding="10,6"
                Margin="0,0,0,8">
          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="#FFD32F2F"
                     TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top"
                IsVisible="{Binding Browser.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#33D32F2F" BorderBrush="#88D32F2F"
                BorderThickness="1" CornerRadius="4" Padding="10,6"
                Margin="0,0,0,8">
          <TextBlock Text="{Binding Browser.ErrorMessage}"
                     Foreground="#FFD32F2F"
                     TextWrapping="Wrap" />
        </Border>

        <!-- Class detail header -->
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
          <TextBlock Text="{Binding Browser.SelectedClass.DisplayName, FallbackValue='—'}"
                     FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Browser.ParentChain}"
                     Opacity="0.6" FontSize="11"
                     IsVisible="{Binding Browser.ShowInherited}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    Spacing="8" Margin="0,0,0,6">
          <CheckBox Content="{StaticResource Browser.ShowInherited}"
                    IsChecked="{Binding Browser.ShowInherited, Mode=TwoWay}" />
          <Button Content="{StaticResource Browser.ExportSdkHeader}"
                  Command="{Binding Browser.ExportSdkHeaderCommand}" />
          <Button Content="{StaticResource Browser.ExportCsx}"
                  Command="{Binding Browser.ExportCsxCommand}" />
          <!-- "Export .CT…" file-save button disabled 2026-06-04: redundant with
               the clipboard "Copy CE XML" / "Copy CE field" paste-to-CE flow.
               Code kept intact (Browser.ExportCeXmlCommand / ExportCeXmlAsync /
               ExportAsync + the Browser.ExportCeXml string resource) — re-enable
               by restoring the button:
               <Button Content="{StaticResource Browser.ExportCeXml}"
                       Command="{Binding Browser.ExportCeXmlCommand}" /> -->
          <!-- Class-level "Copy CE XML" removed: it used the template exporter
               (instance-agnostic), so a concrete Vector3 / nested struct never
               expanded and it was disabled when the Inspector was reached via
               navigation. The single Copy CE XML now lives in the Inspector
               toolbar (live-instance exporter — expands value structs and
               matches the walked grid). Class-level CE table → "Export .CT". -->
          <Button Content="{StaticResource Browser.ExportOptions}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Margin="6" Spacing="6">
                  <Grid ColumnDefinitions="200,160" RowDefinitions="Auto,Auto"
                        RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{StaticResource Browser.OptDrilldownDepth}"
                               VerticalAlignment="Center" Opacity="0.8" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                   Value="{Binding Browser.DrilldownDepth, Mode=TwoWay}"
                                   Minimum="0" Maximum="6" Increment="1" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{StaticResource Browser.OptArrayLimit}"
                               VerticalAlignment="Center" Opacity="0.8" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Value="{Binding Browser.ArrayLimit, Mode=TwoWay}"
                                   Minimum="0" Maximum="256" Increment="8" />
                  </Grid>

                  <CheckBox Content="{StaticResource Browser.OptCollapse}"
                            IsChecked="{Binding Browser.CollapsePointerNodes, Mode=TwoWay}" />
                  <CheckBox Content="{StaticResource Browser.OptUseLiveData}"
                            IsChecked="{Binding Browser.UseLiveData, Mode=TwoWay}" />
                  <CheckBox Content="{StaticResource Browser.OptVerboseDesc}"
                            IsChecked="{Binding Browser.VerboseCeXmlDescription, Mode=TwoWay}"
                            ToolTip.Tip="On: each CE entry's Description is the full &quot;name : Type = value&quot;. Off (default): just the bare field name, for a terser CE address list. Affects descriptions only — addresses, offsets and types are unchanged." />

                  <Grid ColumnDefinitions="200,160">
                    <TextBlock Grid.Column="0"
                               Text="{StaticResource Browser.OptCeXmlBase}"
                               VerticalAlignment="Center" Opacity="0.8" />
                    <TextBox  Grid.Column="1"
                              Text="{Binding Browser.CeXmlBaseAddress, Mode=TwoWay}"
                              FontFamily="Consolas,Cascadia Mono,monospace" />
                  </Grid>

                  <!-- Collapse / flatten knobs (UE5CEDumper-style). Live CE XML
                       only — they reshape the walked field tree, so they have no
                       effect when "Use live data" is off. -->
                  <Separator />
                  <TextBlock Text="{StaticResource Browser.OptFlattenHeader}"
                             Opacity="0.6" FontSize="11" />
                  <CheckBox Content="{StaticResource Browser.OptDescShowOffset}"
                            IsChecked="{Binding Browser.DescShowOffset, Mode=TwoWay}"
                            ToolTip.Tip="Append the field's offset-within-parent to every CE Description, e.g. &quot;hp (+0x18)&quot;. Description text only — addresses and offsets emitted into CE are unchanged." />
                  <CheckBox Content="{StaticResource Browser.OptFlattenValueStructs}"
                            IsChecked="{Binding Browser.FlattenValueStructs, Mode=TwoWay}"
                            ToolTip.Tip="Promote a value struct whose members are all primitive scalars (Vector3, a custom int/float struct) into sibling leaves at the combined offset instead of a nested group. A member that is itself a struct / pointer / collection keeps the struct nested." />
                  <CheckBox Content="{StaticResource Browser.OptFlattenLeafRecords}"
                            IsChecked="{Binding Browser.FlattenLeafRecords, Mode=TwoWay}"
                            ToolTip.Tip="Superset of the above: also flatten structs whose members include managed string fields (a save-data &quot;record&quot;). String members emit the usual length / chars deref leaf at the combined offset." />
                  <CheckBox Content="{StaticResource Browser.OptCollapseLeafPointers}"
                            IsChecked="{Binding Browser.CollapseLeafPointers, Mode=TwoWay}"
                            ToolTip.Tip="When a pointer dereferences to an object with exactly one primitive scalar field, fold it into a single CE record (Address=+ptrOff, Offsets=[fieldOff]) instead of a one-child group." />
                  <CheckBox Content="{StaticResource Browser.OptCollapseChain}"
                            IsChecked="{Binding Browser.CollapseChain, Mode=TwoWay}"
                            ToolTip.Tip="Fold a spine of single-child pointer dereferences (A → B → C, each object holding one pointer) into ONE CE multi-level-pointer entry with a combined Offsets chain. Needs Drilldown depth &gt; 1 to have a chain to fold." />
                  <CheckBox Content="{StaticResource Browser.OptFillEmptyArraySlots}"
                            IsChecked="{Binding Browser.FillEmptyArraySlots, Mode=TwoWay}"
                            ToolTip.Tip="Assume every array slot holds data even when a slot is a null pointer or the whole collection is empty/unallocated (the game hasn't loaded that record yet). Null pointer slots + empty collections are filled from the element class's metadata layout so the CE table has the full per-element structure ready for any save; string slots reserve the longest length seen in the array. Polymorphic collections (a base-typed array holding subclass instances, e.g. LibraryItemData[] holding Book) are normalised so every slot uses the richest subclass found; monomorphic arrays keep their own per-slot live walk. Never expands framework types (List&lt;Transform&gt; etc. stay leaves)." />

                  <!-- Feature 1: minimum CE String buffer length. -->
                  <CheckBox Content="{StaticResource Browser.OptEnforceMinStringLength}"
                            IsChecked="{Binding Browser.EnforceMinStringLength, Mode=TwoWay}"
                            ToolTip.Tip="Reserve at least this many UTF-16 characters for every CE String field/element. A currently-short string still displays a longer value under a different save; a string already at or above the floor is left as-is. Off = each string uses exactly its decoded length." />
                  <Grid ColumnDefinitions="200,160"
                        IsEnabled="{Binding Browser.EnforceMinStringLength}">
                    <TextBlock Grid.Column="0"
                               Text="{StaticResource Browser.OptMinStringLength}"
                               VerticalAlignment="Center" Opacity="0.8" />
                    <NumericUpDown Grid.Column="1"
                                   Value="{Binding Browser.MinStringLength, Mode=TwoWay}"
                                   Minimum="0" Maximum="1024" Increment="8" />
                  </Grid>

                  <Separator />
                  <CheckBox Content="{StaticResource Browser.OptRecordColors}"
                            IsChecked="{Binding Browser.RecordColors, Mode=TwoWay}"
                            ToolTip.Tip="Tint alternating array element rows ([0],[2],… vs [1],[3],…) with a CE Color so big arrays read as banded rows. Colours are RRGGBB hex; the odd colour can be left blank to use CE's theme." />
                  <Grid ColumnDefinitions="120,90,Auto,90" ColumnSpacing="6"
                        IsEnabled="{Binding Browser.RecordColors}">
                    <TextBlock Grid.Column="0"
                               Text="{StaticResource Browser.OptRecordColorEven}"
                               VerticalAlignment="Center" Opacity="0.8" />
                    <TextBox  Grid.Column="1"
                              Text="{Binding Browser.RecordColorEven, Mode=TwoWay}"
                              FontFamily="Consolas,Cascadia Mono,monospace" />
                    <TextBlock Grid.Column="2"
                               Text="{StaticResource Browser.OptRecordColorOdd}"
                               VerticalAlignment="Center" Opacity="0.8" />
                    <TextBox  Grid.Column="3"
                              Text="{Binding Browser.RecordColorOdd, Mode=TwoWay}"
                              FontFamily="Consolas,Cascadia Mono,monospace"
                              PlaceholderText="theme" />
                  </Grid>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <TextBlock Text="{Binding Browser.CopyCeXmlProgress}"
                     VerticalAlignment="Center" Opacity="0.75" FontSize="11"
                     IsVisible="{Binding Browser.CopyCeXmlProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     ToolTip.Tip="Copy CE XML progress — live entry count while exporting, then the final line count." />
          <Button Content="Cancel"
                  VerticalAlignment="Center" Margin="4,0,0,0"
                  IsVisible="{Binding Browser.IsExporting}"
                  Command="{Binding Browser.CancelExportCommand}"
                  ToolTip.Tip="Abort the in-progress Copy CE XML / Copy CE field export." />
          <ProgressBar IsIndeterminate="True"
                       IsVisible="{Binding Browser.IsLoadingDetail}"
                       Width="120" Height="4"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Tabs: Fields / Inspector / Methods / Address Lookup. SelectedIndex
             is bound to the VM so cross-tab handoffs (Inspector right-click
             → Address Lookup, Address Lookup → Inspector) can switch tabs
             from the VM layer.
             Logo watermark sits behind the TabControl and is mutually
             exclusive with it on IsConnected — at startup (no inject)
             the right pane shows just the branding image; after the
             user injects + connects the DataGrid tabs take over. -->
        <Grid>
          <!-- Watermark holder — pure-XAML 75%-of-parent sizing: a
               3-column / 3-row star grid (1*,6*,1*) makes the image
               cell exactly 6/8 = 75% of width AND height. Stretch=
               Uniform preserves aspect ratio inside that bounding box. -->
          <Grid ColumnDefinitions="1*,6*,1*"
                RowDefinitions="1*,6*,1*"
                IsHitTestVisible="False"
                IsVisible="{Binding !IsConnected}">
            <Image Grid.Column="1" Grid.Row="1"
                   Source="avares://DiscreteUI/Assets/Logo.webp"
                   Stretch="Uniform"
                   Opacity="0.5"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
          </Grid>
          <TabControl SelectedIndex="{Binding SelectedDetailTabIndex, Mode=TwoWay}"
                      IsVisible="{Binding IsConnected}">
          <TabItem Header="{StaticResource Browser.FieldsTab}">
            <DockPanel>
              <!-- Filter is UI-only — exports + Copy CE field operate on
                   the unfiltered Fields collection. Matches name OR type
                   (case-insensitive substring) so a search like "vector"
                   surfaces every Vector3 field across the inheritance chain. -->
              <TextBox x:Name="FieldFilterBox"
                       DockPanel.Dock="Top"
                       PlaceholderText="{StaticResource Browser.FilterFieldsWatermark}"
                       Text="{Binding Browser.FieldFilter, Mode=TwoWay}"
                       Margin="0,0,0,4" />
              <DataGrid x:Name="BrowserFieldsDataGrid"
                        ItemsSource="{Binding Browser.FilteredFields}"
                        SelectedItem="{Binding Browser.SelectedFieldRow, Mode=TwoWay}"
                        SelectionMode="Extended"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="True"
                        CanUserReorderColumns="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="Horizontal">
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{StaticResource Browser.CopyCeField}"
                              Command="{Binding Browser.CopyCeFieldCommand}" />
                    <Separator />
                    <!-- Per-cell clipboard helpers. Single-select only;
                         multi-select copy is a follow-up (would need to
                         join row values with newline + handle mixed
                         columns). Handlers live in MainWindow.axaml.cs. -->
                    <MenuItem Header="{StaticResource Browser.CopyFieldNameMenu}"
                              Click="OnCopyFieldNameClicked" />
                    <MenuItem Header="{StaticResource Browser.CopyFieldTypeMenu}"
                              Click="OnCopyFieldTypeClicked" />
                    <MenuItem Header="{StaticResource Browser.CopyFieldDeclaredInMenu}"
                              Click="OnCopyFieldDeclaredInClicked" />
                    <Separator />
                    <!-- Phase 28 — same modal as Inspector + Symbol Finder. -->
                    <MenuItem Header="{StaticResource FieldRefs.FindMethodsMenu}"
                              Click="OnFindFieldReferencesFromFieldsTabClicked" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{StaticResource Browser.ColName}"
                                          Width="Auto" MinWidth="200" SortMemberPath="Name" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:FieldRow">
                        <controls:HighlightedTextBlock SourceText="{Binding FriendlyName}"
                                                       Highlight="{Binding #FieldFilterBox.Text}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Tooltip}"
                                                       Margin="4,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{StaticResource Browser.ColOffset}" Width="80"
                                      Binding="{Binding OffsetHex}"
                                      SortMemberPath="Offset" CanUserSort="True" />
                  <DataGridTemplateColumn Header="{StaticResource Browser.ColType}"
                                          Width="Auto" MinWidth="180" SortMemberPath="Type" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:FieldRow">
                        <controls:HighlightedTextBlock SourceText="{Binding FriendlyType}"
                                                       Highlight="{Binding #FieldFilterBox.Text}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Type}"
                                                       Margin="4,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{StaticResource Browser.ColFlags}"  Width="80"
                                      Binding="{Binding FlagsHex}"
                                      SortMemberPath="Flags" CanUserSort="True" />
                  <DataGridCheckBoxColumn Header="{StaticResource Browser.ColStatic}" Width="60"
                                          Binding="{Binding IsStatic}"
                                          SortMemberPath="IsStatic" CanUserSort="True" />
                  <DataGridTextColumn Header="{StaticResource Browser.ColDeclaredIn}" Width="160"
                                      Binding="{Binding FriendlyDeclaredIn}"
                                      SortMemberPath="DeclaredIn" CanUserSort="True" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="{StaticResource Inspector.Tab}">
            <DockPanel Margin="0,4,0,0">

              <!-- Inspector toolbar -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="8" Margin="0,0,0,6">
                <Button Content="{StaticResource Inspector.SetTarget}"
                        Command="{Binding InspectSelectedClassCommand}" />
                <Button Content="{StaticResource Inspector.Find}"
                        Command="{Binding FindInspectorInstancesCommand}" />
                <Button Content="{StaticResource Inspector.RefreshWalk}"
                        Command="{Binding Inspector.RefreshWalkCommand}" />
                <Button Content="{StaticResource Inspector.Clear}"
                        Command="{Binding Inspector.ClearCommand}" />
                <Button Content="{StaticResource Inspector.SendToBrowser}"
                        ToolTip.Tip="{StaticResource Inspector.SendToBrowserTooltip}"
                        Command="{Binding Inspector.SendToBrowserCommand}" />
                <Button Content="→ Pivot"
                        IsVisible="{Binding ExperimentalEnabled}"
                        ToolTip.Tip="Send this class to the Class Pivot tab (fills the Class FQN; pick snapshots + key/value there)."
                        Command="{Binding Inspector.SendToPivotCommand}" />
                <Button Content="{StaticResource Inspector.CopyCeXmlInstance}"
                        ToolTip.Tip="{StaticResource Inspector.CopyCeXmlInstanceTooltip}"
                        Command="{Binding Inspector.CopyCeXmlInstanceCommand}" />
                <TextBlock Text="{Binding Inspector.CopyCeXmlProgress}"
                           VerticalAlignment="Center" Opacity="0.75" FontSize="11"
                           IsVisible="{Binding Inspector.CopyCeXmlProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           ToolTip.Tip="Copy CE XML / field progress — live entry count while exporting, then the final line count." />
                <Button Content="Cancel"
                        VerticalAlignment="Center" Margin="4,0,0,0"
                        IsVisible="{Binding Inspector.IsExporting}"
                        Command="{Binding Inspector.CancelExportCommand}"
                        ToolTip.Tip="Abort the in-progress Copy CE XML / Copy CE field export." />
                <TextBlock Text="{StaticResource Inspector.LimitLabel}"
                           VerticalAlignment="Center" Opacity="0.7" Margin="8,0,0,0" />
                <NumericUpDown Value="{Binding Inspector.InstanceLimit, Mode=TwoWay}"
                               Minimum="1" Maximum="4096" Increment="64"
                               MinWidth="150" Width="160" />
                <CheckBox Content="Alive only"
                          IsChecked="{Binding Inspector.AliveOnly, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Drop destroyed Unity shells (m_CachedPtr == 0). Applies on the next Find." />
                <CheckBox Content="Sane"
                          IsChecked="{Binding Inspector.Sane, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Drop stale/torn objects: any managed reference field holding a non-null but unreadable pointer (garbage). Generic, no per-class config. Applies on the next Find." />
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding Inspector.IsLoadingInstances}"
                             Width="80" Height="4" VerticalAlignment="Center" />
              </StackPanel>

              <!-- Field-filter builder: compose numeric predicates without
                   hand-writing JSON. Pick a numeric field → operator → value;
                   "between" reveals a second box for a closed range. Each Add
                   appends to the JSON row below; the next Find applies them
                   AND-combined. Options populate after the first walk. -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="6" Margin="0,0,0,6">
                <TextBlock Text="Filter builder" VerticalAlignment="Center" Opacity="0.7" />
                <!-- AutoCompleteBox (was ComboBox): fixed Width keeps the box +
                     dropdown from resizing per class, and FilterMode=Contains
                     lets the user type any part of the field NAME to narrow a
                     long list instead of scrolling offset order (2026-06-08). -->
                <AutoCompleteBox Width="280"
                          ItemsSource="{Binding Inspector.FilterFieldOptions}"
                          SelectedItem="{Binding Inspector.SelectedFilterField, Mode=TwoWay}"
                          FilterMode="Contains"
                          MinimumPrefixLength="0"
                          PlaceholderText="type a field name…"
                          VerticalAlignment="Center">
                  <AutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterFieldOption">
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
                <ComboBox Width="92"
                          ItemsSource="{Binding Inspector.FilterOps}"
                          SelectedItem="{Binding Inspector.FilterOp, Mode=TwoWay}" />
                <TextBox Width="84" VerticalAlignment="Center"
                         Text="{Binding Inspector.FilterValue1, Mode=TwoWay}"
                         PlaceholderText="value" />
                <TextBox Width="84" VerticalAlignment="Center"
                         Text="{Binding Inspector.FilterValue2, Mode=TwoWay}"
                         PlaceholderText="high"
                         IsVisible="{Binding Inspector.IsRangeOp}" />
                <Button Content="Add"
                        Command="{Binding Inspector.AddFilterPredicateCommand}"
                        ToolTip.Tip="Append this predicate to the field filter below. The next Find applies them." />
                <Button Content="Clear"
                        Command="{Binding Inspector.ClearFieldFilterCommand}"
                        ToolTip.Tip="Remove all field-filter predicates." />
                <Button Content="Apply ↻"
                        Command="{Binding FindInspectorInstancesCommand}"
                        ToolTip.Tip="Re-run Find instances now with the current field filter (the filter applies during the heap scan)." />
              </StackPanel>

              <!-- Phase 32 — field-filter row (generic per-class predicate). -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="6" Margin="0,0,0,6">
                <TextBlock Text="Field filter" VerticalAlignment="Center" Opacity="0.7" />
                <TextBox Text="{Binding Inspector.FieldFilterJson, Mode=TwoWay}"
                         Width="560" MinWidth="320"
                         PlaceholderText="JSON predicate array, e.g. [{&quot;offset&quot;:1532,&quot;type&quot;:&quot;System.Int32&quot;,&quot;op&quot;:&quot;==&quot;,&quot;value&quot;:1}]"
                         ToolTip.Tip="AND-combined predicates evaluated per instance. Empty = no filter. type: numeric / ptr / string. op: ==,!=,&lt;,&lt;=,&gt;,&gt;=,nonzero,zero (numeric); nonnull,null,==,!= (ptr); nonempty,empty,==,!=,contains (string). Applies on the next Find." />
              </StackPanel>

              <!-- Auto-refresh row -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="6" Margin="0,0,0,6">
                <TextBlock Text="{StaticResource Inspector.AutoRefreshLabel}"
                           VerticalAlignment="Center" Opacity="0.7" />
                <Button Content="{StaticResource Inspector.AutoRefreshOff}"
                        Command="{Binding Inspector.AutoRefreshOffCommand}" />
                <Button Content="{StaticResource Inspector.AutoRefresh250}"
                        Command="{Binding Inspector.AutoRefreshFastCommand}" />
                <Button Content="{StaticResource Inspector.AutoRefresh1000}"
                        Command="{Binding Inspector.AutoRefreshSlowCommand}" />
                <TextBlock Text="{Binding Inspector.AutoRefreshIntervalMs, StringFormat='= \{0\} ms'}"
                           VerticalAlignment="Center" Opacity="0.6"
                           Margin="6,0,0,0" />
              </StackPanel>

              <!-- Target / status header -->
              <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,6">
                <TextBlock Text="{Binding Inspector.TargetLabel}"
                           FontWeight="SemiBold"
                           IsVisible="{Binding Inspector.HasTarget}" />
                <TextBlock Text="{StaticResource Inspector.NoTarget}"
                           Opacity="0.6"
                           IsVisible="{Binding !Inspector.HasTarget}" />
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding Inspector.ClassPointer, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{StaticResource Inspector.ClassPointerLabel}"
                             Opacity="0.7"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Inspector.ClassPointer}"
                             FontFamily="Consolas,Cascadia Mono,monospace"
                             VerticalAlignment="Center" />
                  <!-- Small icon-style copy buttons. Same shape as the
                       walked-field row actions (addr / ptr / name / HEX) so
                       Inspector stays visually consistent. -->
                  <Button Content="name" FontSize="10" Padding="4,0" MinHeight="20"
                          Command="{Binding Inspector.CopyClassNameCommand}"
                          ToolTip.Tip="{StaticResource Inspector.CopyClassNameTooltip}" />
                  <Button Content="addr" FontSize="10" Padding="4,0" MinHeight="20"
                          Command="{Binding Inspector.CopyClassAddressCommand}"
                          ToolTip.Tip="{StaticResource Inspector.CopyClassAddressTooltip}" />
                </StackPanel>
                <TextBlock Text="{Binding Inspector.WalkSummary}"
                           Opacity="0.6" FontSize="11"
                           IsVisible="{Binding Inspector.HasSelectedInstance}" />
              </StackPanel>

              <!-- Bookmarks: pin the inspected instance + jump back later
                   (persisted per game; re-anchors the class on recall). -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="6" Margin="0,0,0,6">
                <Button Content="★ Bookmark"
                        Command="{Binding Inspector.BookmarkCurrentCommand}"
                        ToolTip.Tip="Pin the current class + selected instance so you can jump back later (saved per game)." />
                <TextBox Width="150" VerticalAlignment="Center"
                         Text="{Binding Inspector.BookmarkLabelInput, Mode=TwoWay}"
                         PlaceholderText="label (optional)" />
                <ComboBox Width="220" VerticalAlignment="Center"
                          ItemsSource="{Binding Inspector.Bookmarks}"
                          SelectedItem="{Binding Inspector.SelectedBookmark, Mode=TwoWay}"
                          PlaceholderText="saved bookmarks…">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:InstanceBookmark">
                      <TextBlock Text="{Binding DisplayLabel}" ToolTip.Tip="{Binding ClassDisplay}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Recall"
                        Command="{Binding Inspector.RecallBookmarkCommand}"
                        CommandParameter="{Binding Inspector.SelectedBookmark}"
                        ToolTip.Tip="Re-inspect the bookmarked class and focus its instance (re-anchors after a restart)." />
                <Button Content="✕"
                        Command="{Binding Inspector.DeleteBookmarkCommand}"
                        CommandParameter="{Binding Inspector.SelectedBookmark}"
                        ToolTip.Tip="Delete the selected bookmark." />
              </StackPanel>

              <!-- Related objects: the selected instance's GameObject, parent,
                   and children — double-click a row to re-inspect it. -->
              <Expander DockPanel.Dock="Top" Margin="0,0,0,6"
                        Header="🔗 Related objects (GameObject / parent / children)">
                <StackPanel Spacing="6" Margin="0,6,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Show related"
                            Command="{Binding Inspector.ShowRelatedCommand}" />
                    <TextBlock Text="{Binding Inspector.RelatedStatus}"
                               VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
                  </StackPanel>
                  <DataGrid x:Name="RelatedObjectsGrid"
                            ItemsSource="{Binding Inspector.RelatedObjects}"
                            IsReadOnly="True" AutoGenerateColumns="False"
                            CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                            MaxHeight="220"
                            DoubleTapped="OnRelatedObjectActivated">
                    <DataGrid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Go (re-inspect)" Click="OnRelatedObjectGoMenu" />
                      </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Kind"    Binding="{Binding KindLabel}"    Width="Auto" MinWidth="80" />
                      <DataGridTextColumn Header="Name"    Binding="{Binding Label}"        Width="Auto" MinWidth="140" />
                      <DataGridTextColumn Header="Class"   Binding="{Binding ClassDisplay}" Width="Auto" MinWidth="120" />
                      <DataGridTextColumn Header="Address" Binding="{Binding Address}"      Width="Auto" MinWidth="120" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Expander>

              <!-- Inspector error banner -->
              <Border DockPanel.Dock="Top"
                      IsVisible="{Binding Inspector.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Background="#33D32F2F" BorderBrush="#88D32F2F"
                      BorderThickness="1" CornerRadius="4" Padding="10,6"
                      Margin="0,0,0,6">
                <TextBlock Text="{Binding Inspector.ErrorMessage}"
                           Foreground="#FFD32F2F" TextWrapping="Wrap" />
              </Border>

              <!-- Instances + walked-fields split (resizable). -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240" MinWidth="160" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*"   MinWidth="240" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                  <TextBlock DockPanel.Dock="Top"
                             Text="{StaticResource Inspector.InstancesTitle}"
                             FontWeight="SemiBold" Margin="0,0,0,4" />
                  <TextBlock DockPanel.Dock="Bottom"
                             Text="{Binding Inspector.Instances.Count, StringFormat='\{0\} matches'}"
                             Opacity="0.6" FontSize="11" Margin="0,4,0,0" />
                  <ListBox ItemsSource="{Binding Inspector.Instances}"
                           SelectedItem="{Binding Inspector.SelectedInstance, Mode=TwoWay}"
                           x:DataType="vm:MainWindowViewModel">
                    <!-- Phase 19d-2: right-click any instance → "Call method
                         on this instance…". Switches to the Methods tab and
                         remembers this instance so the subsequent
                         "Call method… (pick overload)" right-click on any
                         method pre-fills its `this` pointer (no manual
                         paste). The handler lives in the code-behind and
                         resolves the right-clicked row via the ListBox's
                         SelectedItem (Avalonia auto-selects on right-click
                         before showing the menu). -->
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{StaticResource Inspector.CallMethodOnInstanceMenu}"
                                  Click="OnCallMethodOnInstanceClicked" />
                        <MenuItem Header="{StaticResource Inspector.CopyInstanceAddressMenu}"
                                  Click="OnCopyInstanceAddressClicked" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:InstanceItem">
                        <TextBlock Text="{Binding Label}"
                                   FontFamily="Consolas,Cascadia Mono,monospace" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="4"
                              Background="#22000000"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" />

                <DockPanel Grid.Column="2" Margin="6,0,0,0">
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{StaticResource Inspector.FieldsTitle}"
                               FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ProgressBar Grid.Column="1" IsIndeterminate="True"
                                 IsVisible="{Binding Inspector.IsLoadingWalk}"
                                 Width="80" Height="4" VerticalAlignment="Center" />
                  </Grid>

                  <!-- Field filter is UI-only — Copy CE XML / Copy CE field
                       still operate on the unfiltered tree, mirroring the
                       Assemblies / Classes filter precedent. Substring match
                       on Name OR Type, applied uniformly across top-level
                       and any expanded children rows. -->
                  <TextBox DockPanel.Dock="Top"
                           PlaceholderText="{StaticResource Inspector.FilterWatermark}"
                           Text="{Binding Inspector.Filter, Mode=TwoWay}"
                           Margin="0,0,0,4" />

                  <!-- Phase 11.5: hierarchical field grid. Sorting is OFF
                       because rows are positioned relative to their parent
                       (parent first, then indented children). Expand chevron
                       lives in the Name column; right-click any row to copy
                       a CE XML / CE field rooted at that node's effective
                       address. -->
                  <!-- CanUserSortColumns=True drives Avalonia's built-in sort
                       through a DataGridCollectionView wrapper, which sorts
                       the visual layer only — the underlying `Fields`
                       observable stays in offset order so the VM's
                       expand / collapse / scroll-into-view logic (which
                       indexes into Fields directly) continues to work.
                       SortMemberPath on the Offset and Name columns points
                       at the int / string properties so numeric / textual
                       sort behaves naturally; the OffsetHex display string
                       would otherwise sort lexicographically ("0x100" before
                       "0x80"). -->
                  <DataGrid x:Name="FieldsDataGrid"
                            ItemsSource="{Binding Inspector.FilteredFields}"
                            SelectedItem="{Binding Inspector.SelectedNode, Mode=TwoWay}"
                            SelectionMode="Extended"
                            IsReadOnly="True"
                            AutoGenerateColumns="False"
                            CanUserResizeColumns="True"
                            CanUserReorderColumns="True"
                            CanUserSortColumns="True"
                            Sorting="OnInspectorFieldsSorting"
                            GridLinesVisibility="Horizontal">
                    <DataGrid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{StaticResource Inspector.CopyCeFieldNode}"
                                  Command="{Binding Inspector.CopyCeFieldNodeCommand}" />
                        <MenuItem Header="{StaticResource Inspector.CopyCeFieldNodeRelative}"
                                  ToolTip.Tip="Root entry uses +offset (the field's offset within its parent) instead of an absolute address, so you can paste it directly under the parent struct in CE."
                                  Command="{Binding Inspector.CopyCeFieldNodeRelativeCommand}" />
                        <Separator />
                        <!-- Phase 17c — Inspector right-click reverse address
                             lookup. Pre-fills the Address Lookup tab's input
                             with the row's effective address (deref pointer
                             for pointer rows, storage address otherwise) and
                             switches tabs. Code-behind reads the right-clicked
                             row's Address from the DataGrid since the menu
                             command can't easily bind to the row context
                             through MainWindowViewModel. -->
                        <MenuItem Header="{StaticResource Inspector.LookupAddressMenu}"
                                  Click="OnLookupInspectorAddressClicked" />
                        <!-- Phase 21a — Reverse-property lookup: given the
                             selected field, list its address + value across
                             every live instance of the inspector's target
                             class. Bails (with a soft MessageBox-style note)
                             when the selection crosses a pointer-traversal
                             or collection-element ancestor — see
                             InspectorFieldOffsetResolver. -->
                        <MenuItem Header="{StaticResource Inspector.ListFieldAcrossInstancesMenu}"
                                  Click="OnListFieldAcrossInstancesClicked" />
                        <!-- Phase 28 — Field → Methods cross-reference. Same
                             code-behind handler shared with Symbol Finder
                             + Fields tab; opens FieldReferencesWindow modal
                             seeded with the row's class + field name +
                             type + isStatic flag. Inspector path needs the
                             selected node's name / declared-in chain to
                             pin down the declaring class (which may differ
                             from the inspector's TargetClass when the row
                             is inherited from a parent). -->
                        <MenuItem Header="{StaticResource FieldRefs.FindMethodsMenu}"
                                  Click="OnFindFieldReferencesFromInspectorClicked" />
                        <!-- Phase 21b — write-back. Code-behind reads the
                             selected WalkedFieldNode and opens the
                             FieldWriteWindow modal seeded with field
                             name / type / address / current display. Modal
                             gates Write on InspectorWriteTypeMap.Supported,
                             so reference / value-struct / collection rows
                             open but show the unsupported banner instead
                             of letting the user click Write. -->
                        <MenuItem Header="{StaticResource Inspector.WriteFieldMenu}"
                                  Click="OnWriteFieldClicked" />
                      </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="{StaticResource Browser.ColName}"
                                              Width="Auto" MinWidth="120"
                                              SortMemberPath="Name" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="vm:WalkedFieldNode">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                              <Border Width="{Binding IndentPx}" />
                              <Button Content="{Binding ExpandGlyph}"
                                      Command="{Binding ToggleCommand}"
                                      Padding="2,0"
                                      MinWidth="18" Height="18"
                                      FontSize="10"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsEnabled="{Binding CanExpand}"
                                      VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Name}"
                                         VerticalAlignment="Center" />
                              <TextBlock Text="{Binding LoadHint}"
                                         Opacity="0.55"
                                         FontSize="11"
                                         Margin="6,0,0,0"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="{StaticResource Browser.ColOffset}" Width="80"
                                          Binding="{Binding OffsetHex}"
                                          SortMemberPath="Offset" CanUserSort="True" />
                      <!-- Field storage address. Live + per-instance, so a
                           glance at the column lets the user spot which
                           rows share an instance memory page (handy when
                           cross-referencing with CE's memory viewer). The
                           pointer dereference value, when relevant, lives
                           in the Value column so it's not duplicated here. -->
                      <DataGridTextColumn Header="{StaticResource Inspector.ColAddress}" Width="155"
                                          Binding="{Binding Address}"
                                          SortMemberPath="Address" CanUserSort="True"
                                          FontFamily="Consolas,Cascadia Mono,monospace" />
                      <DataGridTextColumn Header="{StaticResource Browser.ColType}"
                                          Width="Auto" MinWidth="110"
                                          Binding="{Binding Type}"
                                          SortMemberPath="Type" CanUserSort="True" />
                      <!-- Value: Auto-sizes to content (NOT star) so the grid's
                           total column width can EXCEED the pane and a horizontal
                           scrollbar appears, instead of a star column clamping
                           the whole grid to the viewport and squeezing long
                           values. MinWidth keeps a readable floor; MaxWidth caps
                           a pathologically long string (~2× a typical pane) so
                           one row can't blow the grid out unboundedly. Matches
                           the auto-width pattern the Symbol Finder / Browser
                           grids already use. -->
                      <DataGridTextColumn Header="{StaticResource Inspector.ColValue}"
                                          Width="Auto" MinWidth="140" MaxWidth="1200"
                                          Binding="{Binding DisplayValue}"
                                          SortMemberPath="DisplayValue" CanUserSort="True" />
                      <DataGridTextColumn Header="{StaticResource Browser.ColDeclaredIn}" Width="160"
                                          Binding="{Binding DeclaredIn}"
                                          SortMemberPath="DeclaredIn" CanUserSort="True" />
                      <!-- Phase 11.6: per-row action buttons. addr / ptr /
                           name copy the corresponding string to clipboard;
                           HEX hands the row's effective address to AOBMaker's
                           CE plugin (named pipe \\.\pipe\AOBMakerCEBridge)
                           so the open Memory View jumps to it. AOBMaker is
                           optional — when not running the HEX call no-ops
                           and logs to ui/view; the other three work
                           unconditionally. IsEnabled bindings hide the
                           buttons that have no payload (e.g. ptr is
                           disabled for primitive rows whose Ptr is empty). -->
                      <DataGridTemplateColumn Header="{StaticResource Inspector.ColActions}"
                                              Width="200" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="vm:WalkedFieldNode">
                            <StackPanel Orientation="Horizontal" Spacing="2"
                                        VerticalAlignment="Center">
                              <Button Content="addr" FontSize="10" Padding="4,0" MinHeight="20"
                                      Command="{Binding CopyAddrCommand}"
                                      IsEnabled="{Binding CanCopyAddr}"
                                      ToolTip.Tip="{StaticResource Inspector.CopyAddrTooltip}" />
                              <Button Content="ptr"  FontSize="10" Padding="4,0" MinHeight="20"
                                      Command="{Binding CopyPtrCommand}"
                                      IsEnabled="{Binding CanCopyPtr}"
                                      ToolTip.Tip="{StaticResource Inspector.CopyPtrTooltip}" />
                              <Button Content="name" FontSize="10" Padding="4,0" MinHeight="20"
                                      Command="{Binding CopyNameCommand}"
                                      ToolTip.Tip="{StaticResource Inspector.CopyNameTooltip}" />
                              <Button Content="HEX"  FontSize="10" Padding="4,0" MinHeight="20"
                                      Command="{Binding NavigateHexCommand}"
                                      IsEnabled="{Binding CanNavigateHex}"
                                      ToolTip.Tip="{StaticResource Inspector.NavigateHexTooltip}" />
                              <Button Content="→ptr" FontSize="10" Padding="4,0" MinHeight="20"
                                      Command="{Binding NavigatePtrHexCommand}"
                                      IsEnabled="{Binding CanNavigatePtrHex}"
                                      ToolTip.Tip="{StaticResource Inspector.NavigatePtrHexTooltip}" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Grid>
            </DockPanel>
          </TabItem>
          <TabItem Header="{StaticResource Browser.MethodsTab}">
            <DockPanel>
              <TextBox x:Name="MethodFilterBox"
                       DockPanel.Dock="Top"
                       PlaceholderText="{StaticResource Browser.FilterMethodsWatermark}"
                       Text="{Binding Browser.MethodFilter, Mode=TwoWay}"
                       Margin="0,0,0,4" />
              <DataGrid x:Name="MethodsDataGrid"
                        ItemsSource="{Binding Browser.FilteredMethods}"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="True"
                        CanUserReorderColumns="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="Horizontal">
                <DataGrid.ContextMenu>
                  <!-- Phase 18c / 19d / 19d-2: right-click any row →
                       enumerate every overload of this method on the
                       selected class. Two paths:
                       • "Find overloads…" always opens the picker modal
                         (where the user can copy AOB / registerSymbol AA
                         scripts, or right-click a single overload to call
                         it via `callMethod`).
                       • "Call method… (pick overload)" probes
                         findMethodInstances first; when count==1 it skips
                         the picker and jumps straight to the
                         MethodCallWindow seeded from that single overload.
                         Multi-overload methods (Mathf.Abs, String.Concat)
                         still drop into the picker for the user to choose. -->
                  <ContextMenu>
                    <MenuItem Header="{StaticResource Browser.MethodFindOverloadsMenu}"
                              Click="OnMethodFindOverloadsClicked" />
                    <MenuItem Header="{StaticResource Browser.MethodCallMethodMenu}"
                              Click="OnMethodCallMethodClicked" />
                    <!-- 18e-B: jump CE's disassembler to this method's native
                         entry. IL2CPP uses the row's AOT address directly;
                         Mono has no address until JIT'd, so this issues a
                         findMethodInstances RPC (which mono_compile_method's
                         every overload) and matches the row by token. -->
                    <MenuItem Header="{StaticResource Browser.MethodGotoAddressMenu}"
                              Click="OnMethodGotoAddressClicked" />
                    <Separator />
                    <!-- Per-cell clipboard helpers. MethodRow has no return
                         type (only the overload-picker RPC carries that), so
                         the 3rd item copies the row's Address column instead.
                         Single-select only; multi-select is a follow-up. -->
                    <MenuItem Header="{StaticResource Browser.CopyMethodNameMenu}"
                              Click="OnCopyMethodNameClicked" />
                    <MenuItem Header="{StaticResource Browser.CopyMethodAddressMenu}"
                              Click="OnCopyMethodAddressClicked" />
                    <MenuItem Header="{StaticResource Browser.CopyMethodDeclaredInMenu}"
                              Click="OnCopyMethodDeclaredInClicked" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{StaticResource Browser.ColName}"
                                          Width="Auto" MinWidth="140" SortMemberPath="Name" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:MethodRow">
                        <controls:HighlightedTextBlock SourceText="{Binding FriendlyName}"
                                                       Highlight="{Binding #MethodFilterBox.Text}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Tooltip}"
                                                       Margin="4,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{StaticResource Browser.ColAddress}" Width="160"
                                      Binding="{Binding Address}"
                                      SortMemberPath="Address" CanUserSort="True" />
                  <DataGridTextColumn Header="{StaticResource Browser.ColToken}"   Width="100"
                                      Binding="{Binding TokenHex}"
                                      SortMemberPath="Token" CanUserSort="True" />
                  <DataGridTextColumn Header="{StaticResource Browser.ColFlags}"   Width="80"
                                      Binding="{Binding FlagsHex}"
                                      SortMemberPath="Flags" CanUserSort="True" />
                  <DataGridCheckBoxColumn Header="{StaticResource Browser.ColStatic}" Width="60"
                                          Binding="{Binding IsStatic}"
                                          SortMemberPath="IsStatic" CanUserSort="True" />
                  <DataGridTextColumn Header="{StaticResource Browser.ColDeclaredIn}" Width="160"
                                      Binding="{Binding FriendlyDeclaredIn}"
                                      SortMemberPath="DeclaredIn" CanUserSort="True" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <!-- Phase 25 — Symbol Finder tab. Wraps the `searchSymbols`
               RPC so the user can hunt a field/method name across every
               class in an assembly with one keystroke. Replaces the
               historical "click each class in turn" loop. Row activation
               (double-click) jumps back to the Browser's Fields/Methods
               tab with the class pre-selected and the field/method
               filter pre-filled. -->
          <TabItem Header="{StaticResource SymbolFinder.Tab}">
            <DockPanel Margin="0,4,0,0">
              <!-- Top two rows: row 0 = assembly picker + "all user" toggle,
                   row 1 = pattern + kind/limit + Search.
                   The "Search all user assemblies" CheckBox lives on row 0
                   next to the assembly ComboBox so the user immediately sees
                   that the ComboBox greys out when the toggle is on. -->
              <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                <!-- Row 0: assembly picker + multi-assembly toggle. -->
                <Grid ColumnDefinitions="Auto,220,Auto,*">
                  <TextBlock Grid.Column="0"
                             Text="{StaticResource SymbolFinder.AssemblyLabel}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding SymbolFinder.Assemblies}"
                            SelectedItem="{Binding SymbolFinder.SelectedAssembly, Mode=TwoWay}"
                            IsEnabled="{Binding SymbolFinder.IsAssemblyPickerEnabled}"
                            Margin="0,0,12,0">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AssemblyItem">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox Grid.Column="2"
                            Content="{StaticResource SymbolFinder.SearchAllUserAssemblies}"
                            ToolTip.Tip="{StaticResource SymbolFinder.SearchAllUserAssembliesTooltip}"
                            IsChecked="{Binding SymbolFinder.SearchAllUserAssemblies, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </Grid>
                <!-- Row 1: pattern + kinds + static-only + limit + Search. -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,140,Auto">
                  <TextBox Grid.Column="0"
                           PlaceholderText="{StaticResource SymbolFinder.PatternWatermark}"
                           Text="{Binding SymbolFinder.Pattern, Mode=TwoWay}"
                           KeyDown="OnSymbolFinderPatternKeyDown"
                           Margin="0,0,8,0" />
                  <CheckBox Grid.Column="1"
                            Content="{StaticResource SymbolFinder.IncludeFields}"
                            IsChecked="{Binding SymbolFinder.IncludeFields, Mode=TwoWay}"
                            VerticalAlignment="Center" Margin="0,0,8,0" />
                  <CheckBox Grid.Column="2"
                            Content="{StaticResource SymbolFinder.IncludeMethods}"
                            IsChecked="{Binding SymbolFinder.IncludeMethods, Mode=TwoWay}"
                            VerticalAlignment="Center" Margin="0,0,12,0" />
                  <CheckBox Grid.Column="3"
                            Content="{StaticResource SymbolFinder.StaticOnly}"
                            ToolTip.Tip="{StaticResource SymbolFinder.StaticOnlyTooltip}"
                            IsChecked="{Binding SymbolFinder.StaticOnly, Mode=TwoWay}"
                            VerticalAlignment="Center" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="4"
                             Text="{StaticResource SymbolFinder.LimitLabel}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                  <NumericUpDown Grid.Column="5"
                                 Value="{Binding SymbolFinder.Limit, Mode=TwoWay}"
                                 Minimum="1" Maximum="5000" Increment="100"
                                 FormatString="0"
                                 MinWidth="120"
                                 Margin="0,0,8,0" />
                  <Button Grid.Column="6"
                          Content="{StaticResource SymbolFinder.SearchButton}"
                          Command="{Binding SymbolFinder.SearchCommand}"
                          Classes="accent" />
                </Grid>
              </StackPanel>

              <!-- Auto-find gameplay fields: keyword-scored (HP/Gold/Damage/…),
                   optionally live-confirmed. No pattern needed. -->
              <Expander DockPanel.Dock="Top" Margin="0,0,0,8"
                        Header="🎯 Auto-find gameplay fields (keyword-scored; optionally live-confirmed)">
                <StackPanel Spacing="6" Margin="0,6,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Find gameplay fields"
                            Command="{Binding SymbolFinder.FindGameplayFieldsCommand}"
                            Classes="accent" />
                    <CheckBox Content="Confirm live values (resolve an instance + read the current value)"
                              IsChecked="{Binding SymbolFinder.ConfirmLive, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding SymbolFinder.FindingsStatus}"
                             TextWrapping="Wrap" Opacity="0.75" />
                  <DataGrid x:Name="StatFindingsGrid"
                            ItemsSource="{Binding SymbolFinder.Findings}"
                            IsReadOnly="True" AutoGenerateColumns="False"
                            CanUserResizeColumns="True" CanUserSortColumns="True"
                            GridLinesVisibility="Horizontal" MaxHeight="360">
                    <DataGrid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Send class to Browser"
                                  Click="OnStatFindingSendToBrowserMenu" />
                      </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="✓"        Binding="{Binding ConfirmedMark}" Width="Auto" MinWidth="28" />
                      <DataGridTextColumn Header="Category"  Binding="{Binding Category}"      Width="Auto" MinWidth="80"  SortMemberPath="Category" />
                      <DataGridTextColumn Header="Class"     Binding="{Binding ClassDisplay}"  Width="Auto" MinWidth="160" SortMemberPath="ClassDisplay" />
                      <DataGridTextColumn Header="Field"     Binding="{Binding Member}"        Width="Auto" MinWidth="120" SortMemberPath="Member" />
                      <DataGridTextColumn Header="Type"      Binding="{Binding Type}"          Width="Auto" MinWidth="90"  SortMemberPath="Type" />
                      <DataGridTextColumn Header="Offset"    Binding="{Binding OffsetLabel}"   Width="Auto" MinWidth="64" />
                      <DataGridTextColumn Header="Value"     Binding="{Binding LiveValue}"     Width="Auto" MinWidth="60" />
                      <DataGridTextColumn Header="Score"     Binding="{Binding Score}"         Width="Auto" MinWidth="50" SortMemberPath="Score" />
                      <DataGridTextColumn Header="Conf"      Binding="{Binding Confidence}"    Width="Auto" MinWidth="50" SortMemberPath="Confidence" />
                      <DataGridTextColumn Header="Keywords"  Binding="{Binding Keywords}"      Width="Auto" MinWidth="120" />
                      <DataGridTextColumn Header="Static"    Binding="{Binding StaticLabel}"   Width="Auto" MinWidth="48" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Expander>

              <!-- Auto-find gameplay METHODS: keyword-scored invoke targets
                   (SetHealth / AddGold / Teleport / Kill / God). No pattern. -->
              <Expander DockPanel.Dock="Top" Margin="0,0,0,8"
                        Header="🎮 Auto-find gameplay methods (invoke targets — keyword-scored)">
                <StackPanel Spacing="6" Margin="0,6,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Find gameplay methods"
                            Command="{Binding SymbolFinder.FindGameplayMethodsCommand}"
                            Classes="accent" />
                    <CheckBox Content="Include gameplay actions (Dash / Interact / Buy / Sell — noisier)"
                              IsChecked="{Binding SymbolFinder.IncludeGameplayActions, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding SymbolFinder.MethodFindingsStatus}"
                             TextWrapping="Wrap" Opacity="0.75" />
                  <DataGrid x:Name="MethodFindingsGrid"
                            ItemsSource="{Binding SymbolFinder.MethodFindings}"
                            IsReadOnly="True" AutoGenerateColumns="False"
                            CanUserResizeColumns="True" CanUserSortColumns="True"
                            GridLinesVisibility="Horizontal" MaxHeight="360">
                    <DataGrid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Send class to Browser"
                                  Click="OnMethodFindingSendToBrowserMenu" />
                      </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Category" Binding="{Binding Category}"     Width="Auto" MinWidth="90"  SortMemberPath="Category" />
                      <DataGridTextColumn Header="Class"    Binding="{Binding ClassDisplay}" Width="Auto" MinWidth="160" SortMemberPath="ClassDisplay" />
                      <DataGridTextColumn Header="Method"   Binding="{Binding Method}"       Width="Auto" MinWidth="140" SortMemberPath="Method" />
                      <DataGridTextColumn Header="Score"    Binding="{Binding Score}"        Width="Auto" MinWidth="50"  SortMemberPath="Score" />
                      <DataGridTextColumn Header="Keywords" Binding="{Binding Keywords}"     Width="Auto" MinWidth="120" />
                      <DataGridTextColumn Header="Static"   Binding="{Binding StaticLabel}"  Width="Auto" MinWidth="48" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Expander>

              <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                           IsVisible="{Binding SymbolFinder.IsBusy}"
                           Height="3" Margin="0,0,0,4" />

              <Border DockPanel.Dock="Top"
                      IsVisible="{Binding SymbolFinder.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Background="#33D32F2F" BorderBrush="#88D32F2F"
                      BorderThickness="1" CornerRadius="4" Padding="10,6"
                      Margin="0,0,0,8">
                <TextBlock Text="{Binding SymbolFinder.ErrorMessage}"
                           Foreground="#FFD32F2F" TextWrapping="Wrap" />
              </Border>

              <TextBlock DockPanel.Dock="Bottom"
                         Text="{Binding SymbolFinder.StatusMessage}"
                         Foreground="#FF7B7B7B"
                         Margin="0,4,0,0" />

              <!-- Post-search client-side filter: substring + numeric-only.
                   Narrows the already-loaded results without re-running the RPC. -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="8" Margin="0,0,0,6">
                <TextBox Width="320" VerticalAlignment="Center"
                         Text="{Binding SymbolFinder.ResultFilter, Mode=TwoWay}"
                         PlaceholderText="filter results (member / class / type)…" />
                <CheckBox Content="Numeric types only (bool / byte / int / single / double / …)"
                          IsChecked="{Binding SymbolFinder.NumericTypesOnly, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <!-- Class-facet noise filter: tick classes to hide (display-only). -->
                <Button VerticalAlignment="Center"
                        IsVisible="{Binding SymbolFinder.ClassFacets.AnyFacets}"
                        Content="Hide classes ▾">
                  <Button.Flyout>
                    <Flyout>
                      <StackPanel Spacing="6" MinWidth="260">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="Auto-hide engine noise"
                                  Command="{Binding SymbolFinder.AutoHideNoiseClassesCommand}" />
                          <Button Content="Clear"
                                  Command="{Binding SymbolFinder.ClearHiddenClassesCommand}" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="320">
                          <ItemsControl ItemsSource="{Binding SymbolFinder.ClassFacets.Facets}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ClassFacet">
                                <CheckBox Content="{Binding Display}"
                                          IsChecked="{Binding IsHidden, Mode=TwoWay}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>

              <!-- Results — double-click navigates back to the Browser. -->
              <DataGrid x:Name="SymbolFinderResultsGrid"
                        ItemsSource="{Binding SymbolFinder.FilteredMatches}"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="True"
                        CanUserReorderColumns="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="Horizontal"
                        DoubleTapped="OnSymbolFinderResultDoubleTapped">
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{StaticResource SymbolFinder.NavigateMenu}"
                              Click="OnSymbolFinderNavigateMenu" />
                    <MenuItem Header="Send class to Browser"
                              Click="OnSymbolFinderSendToBrowserMenu" />
                    <!-- Phase 28 — Field → Methods cross-reference. Same modal
                         as the Inspector + Browser Fields tab path. Menu item
                         shows for any row but the handler short-circuits with
                         a soft banner when the right-clicked row's Kind isn't
                         a field. -->
                    <MenuItem Header="{StaticResource FieldRefs.FindMethodsMenu}"
                              Click="OnFindFieldReferencesFromSymbolFinderClicked" />
                    <Separator />
                    <MenuItem Header="{StaticResource SymbolFinder.CopyClassMenu}"
                              Click="OnSymbolFinderCopyClassMenu" />
                    <MenuItem Header="{StaticResource SymbolFinder.CopyMemberMenu}"
                              Click="OnSymbolFinderCopyMemberMenu" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{StaticResource SymbolFinder.ColKind}"
                                      Binding="{Binding KindLabel}" Width="110"
                                      SortMemberPath="KindLabel" CanUserSort="True" />
                  <!-- Assembly column lights up in multi-assembly mode; in
                       single-assembly mode every row repeats the same value
                       but the column is still useful for sorting / filtering. -->
                  <DataGridTextColumn Header="{StaticResource SymbolFinder.ColAssembly}"
                                      Binding="{Binding Assembly}" Width="160"
                                      SortMemberPath="Assembly" CanUserSort="True"
                                      FontFamily="Consolas,Cascadia Mono,monospace" />
                  <DataGridTextColumn Header="{StaticResource SymbolFinder.ColClass}"
                                      Binding="{Binding ClassDisplay}" Width="Auto" MinWidth="200"
                                      SortMemberPath="ClassDisplay" CanUserSort="True"
                                      FontFamily="Consolas,Cascadia Mono,monospace" />
                  <DataGridTextColumn Header="{StaticResource SymbolFinder.ColMember}"
                                      Binding="{Binding Member}" Width="Auto" MinWidth="240"
                                      SortMemberPath="Member" CanUserSort="True"
                                      FontFamily="Consolas,Cascadia Mono,monospace" />
                  <DataGridTextColumn Header="{StaticResource SymbolFinder.ColType}"
                                      Binding="{Binding Type}" Width="Auto" MinWidth="160"
                                      SortMemberPath="Type" CanUserSort="True"
                                      FontFamily="Consolas,Cascadia Mono,monospace" />
                  <DataGridTextColumn Header="{StaticResource SymbolFinder.ColOffset}"
                                      Binding="{Binding OffsetLabel}" Width="90"
                                      SortMemberPath="OffsetLabel" CanUserSort="True"
                                      FontFamily="Consolas,Cascadia Mono,monospace" />
                  <DataGridTextColumn Header="{StaticResource SymbolFinder.ColAddress}"
                                      Binding="{Binding Address}" Width="170"
                                      SortMemberPath="Address" CanUserSort="True"
                                      FontFamily="Consolas,Cascadia Mono,monospace" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <!-- Phase 17c — Address Lookup tab. Wraps the `whatIsAt` RPC:
               paste any process address (typically from CE's *Find what
               writes / accesses* or pointer scan) and the backend walks
               back to identify the containing managed instance + class +
               declared field. The "Inspect this instance" button hands
               the result over to the Inspector tab via
               AddressLookupViewModel.InspectInstanceRequested. -->
          <TabItem Header="{StaticResource AddrLookup.Tab}">
            <DockPanel Margin="0,4,0,0">
              <!-- Input row -->
              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto"
                    Margin="0,0,0,8">
                <TextBlock Grid.Column="0"
                           Text="{StaticResource AddrLookup.AddressLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         PlaceholderText="{StaticResource AddrLookup.AddressWatermark}"
                         Text="{Binding AddressLookup.AddressInput, Mode=TwoWay}"
                         FontFamily="Consolas,Cascadia Mono,monospace" />
                <Button Grid.Column="2"
                        Content="{StaticResource AddrLookup.LookupButton}"
                        Command="{Binding AddressLookup.LookupCommand}"
                        Margin="6,0,0,0" />
                <Button Grid.Column="3"
                        Content="{StaticResource AddrLookup.ClearButton}"
                        Command="{Binding AddressLookup.ClearCommand}"
                        Margin="6,0,0,0" />
              </Grid>

              <!-- Tunables row -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="8" Margin="0,0,0,8">
                <TextBlock Text="{StaticResource AddrLookup.ScanLabel}"
                           VerticalAlignment="Center" Opacity="0.7"
                           ToolTip.Tip="{StaticResource AddrLookup.ScanTooltip}" />
                <NumericUpDown Value="{Binding AddressLookup.MaxBackwardScan, Mode=TwoWay}"
                               Minimum="64" Maximum="16384" Increment="1024"
                               Width="130"
                               ToolTip.Tip="{StaticResource AddrLookup.ScanTooltip}" />
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding AddressLookup.IsBusy}"
                             Width="80" Height="4" VerticalAlignment="Center" />
              </StackPanel>

              <!-- Error banner -->
              <Border DockPanel.Dock="Top"
                      IsVisible="{Binding AddressLookup.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Background="#33D44017" BorderBrush="#88D44017"
                      BorderThickness="1" Padding="8,4" Margin="0,0,0,8"
                      CornerRadius="3">
                <TextBlock Text="{Binding AddressLookup.ErrorMessage}"
                           Foreground="#FFD44017" TextWrapping="Wrap" />
              </Border>

              <!-- Result panel -->
              <ScrollViewer>
                <StackPanel Spacing="6">

                  <!-- "no result" hint when the backend returned !found -->
                  <Border Background="#22808080" BorderBrush="#44808080"
                          BorderThickness="1" Padding="10,6" CornerRadius="3"
                          IsVisible="{Binding AddressLookup.Result.Found, Converter={x:Static BoolConverters.Not}, FallbackValue=False}">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{StaticResource AddrLookup.NoResult}"
                                 TextWrapping="Wrap" Opacity="0.85" />
                      <StackPanel Orientation="Horizontal" Spacing="6"
                                  IsVisible="{Binding AddressLookup.Result.Reason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{StaticResource AddrLookup.NotFoundReason}"
                                   Opacity="0.7" />
                        <TextBlock Text="{Binding AddressLookup.Result.Reason}"
                                   FontFamily="Consolas,Cascadia Mono,monospace" />
                      </StackPanel>
                      <TextBlock Text="{Binding AddressLookup.ScannedLabel}"
                                 Opacity="0.6" FontSize="11" />
                    </StackPanel>
                  </Border>

                  <!-- Found result -->
                  <Border BorderBrush="#44808080" BorderThickness="1"
                          Padding="10" CornerRadius="3"
                          IsVisible="{Binding AddressLookup.HasResult}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{StaticResource AddrLookup.ResultHeader}"
                                 FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                            Margin="0,4,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.InstanceLabel}"
                                   Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding AddressLookup.InstanceLabel}"
                                   FontFamily="Consolas,Cascadia Mono,monospace" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.ClassLabel}"
                                   Opacity="0.7" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding AddressLookup.ClassLabel}"
                                   Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.OffsetLabel}"
                                   Opacity="0.7" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding AddressLookup.FieldOffsetLabel}"
                                   FontFamily="Consolas,Cascadia Mono,monospace"
                                   Margin="0,4,0,0" />

                        <!-- Field row (exact match) -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.FieldLabel}"
                                   Opacity="0.7" Margin="0,4,0,0"
                                   IsVisible="{Binding AddressLookup.HasField}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding AddressLookup.FieldLabel}"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding AddressLookup.HasField}" />

                        <!-- Nearest field row (no exact match) -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.NearestLabel}"
                                   Opacity="0.7" Margin="0,4,0,0"
                                   IsVisible="{Binding AddressLookup.HasNearestField}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding AddressLookup.NearestFieldLabel}"
                                   Margin="0,4,0,0" Opacity="0.85"
                                   IsVisible="{Binding AddressLookup.HasNearestField}" />

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.KindLabel}"
                                   Opacity="0.7" Margin="0,4,0,0"
                                   IsVisible="{Binding AddressLookup.HasField}" />
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding AddressLookup.KindLabel}"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding AddressLookup.HasField}" />

                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.ScannedLabel}"
                                   Opacity="0.7" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1"
                                   Text="{Binding AddressLookup.ScannedLabel}"
                                   Opacity="0.6" FontSize="11"
                                   Margin="0,4,0,0" />
                      </Grid>

                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="{StaticResource AddrLookup.InspectInstance}"
                                Command="{Binding AddressLookup.InspectInstanceCommand}" />
                        <Button Content="{StaticResource AddrLookup.CopyInstance}"
                                Command="{Binding AddressLookup.CopyInstanceAddrCommand}" />
                        <!-- Phase 22e: push the lookup result (instance pointer
                             + resolved field) to CE's address list as a
                             parent AA + child memory record. Hidden when the
                             session has no AOBMaker bridge. -->
                        <Button Content="{StaticResource AddrLookup.SendToCe}"
                                Command="{Binding AddressLookup.SendToCeTableCommand}"
                                IsVisible="{Binding AddressLookup.HasAobMaker}"
                                ToolTip.Tip="{StaticResource AddrLookup.SendToCeTooltip}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

          <!-- Phase 20b — Scene Explorer tab. Filter-driven TreeView
               walking Unity's authoritative scene graph via
               Object.FindObjects* (Type) + Transform.GetChild (lazy
               per-node expand). All icalls main-thread-routed (Phase
               20-MT) — see SceneEnumerator. Right-click a row →
               "Inspect this GameObject" flips to Inspector with the
               GameObject's address pre-populated. -->
          <TabItem Header="{StaticResource Scene.Tab}">
            <DockPanel Margin="0,4,0,0">
              <!-- Top control row: pattern + Limit + Focus delay + Enable
                   runInBackground + Search. Focus delay is the Phase 20-MT
                   runInBackground workaround (per-call countdown). The
                   "Enable runInBackground" button is the one-shot fix:
                   call it once (with Focus delay if needed for the very
                   first call), and the engine stops pausing Update() on
                   focus loss for the rest of the session. Button greys
                   out once successfully applied. -->
              <Grid DockPanel.Dock="Top"
                    ColumnDefinitions="*,Auto,140,Auto,140,Auto,Auto"
                    Margin="0,0,0,8">
                <TextBox Grid.Column="0"
                         PlaceholderText="{StaticResource Scene.PatternWatermark}"
                         Text="{Binding Scene.Pattern, Mode=TwoWay}"
                         KeyDown="OnScenePatternKeyDown"
                         Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="{StaticResource Scene.LimitLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <NumericUpDown Grid.Column="2"
                               Value="{Binding Scene.Limit, Mode=TwoWay}"
                               Minimum="1" Maximum="500" Increment="50"
                               FormatString="0"
                               MinWidth="120"
                               Margin="0,0,8,0" />
                <TextBlock Grid.Column="3"
                           Text="{StaticResource Scene.FocusDelayLabel}"
                           ToolTip.Tip="{StaticResource Scene.FocusDelayTooltip}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <!-- Width matches Limit's 140 / MinWidth 120 — narrower
                     NumericUpDowns hide the numeric value behind the
                     up/down spinner widget (Phase 25 Symbol Finder Limit
                     hit this trap; recorded in lessons-learned.md). -->
                <NumericUpDown Grid.Column="4"
                               Value="{Binding Scene.FocusDelaySeconds, Mode=TwoWay}"
                               Minimum="0" Maximum="10" Increment="1"
                               FormatString="0"
                               ToolTip.Tip="{StaticResource Scene.FocusDelayTooltip}"
                               MinWidth="120"
                               Margin="0,0,8,0" />
                <Button Grid.Column="5"
                        Content="{StaticResource Scene.EnableRunInBackgroundButton}"
                        Command="{Binding Scene.EnableRunInBackgroundCommand}"
                        ToolTip.Tip="{StaticResource Scene.EnableRunInBackgroundTooltip}"
                        Margin="0,0,8,0" />
                <Button Grid.Column="6"
                        Content="{StaticResource Scene.SearchButton}"
                        Command="{Binding Scene.SearchCommand}"
                        Classes="accent" />
              </Grid>

              <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                           IsVisible="{Binding Scene.IsBusy}"
                           Height="3" Margin="0,0,0,4" />

              <Border DockPanel.Dock="Top"
                      IsVisible="{Binding Scene.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Background="#33D32F2F" BorderBrush="#88D32F2F"
                      BorderThickness="1" CornerRadius="4" Padding="10,6"
                      Margin="0,0,0,8">
                <TextBlock Text="{Binding Scene.ErrorMessage}"
                           Foreground="#FFD32F2F" TextWrapping="Wrap" />
              </Border>

              <TextBlock DockPanel.Dock="Bottom"
                         Text="{Binding Scene.StatusMessage}"
                         Foreground="#FF7B7B7B"
                         Margin="0,4,0,0" />

              <!-- TreeView with HierarchicalDataTemplate for lazy
                   children. ItemsSource binds to Scene.Roots; each
                   SceneNode exposes a Children collection that's
                   replaced wholesale on first IsExpanded=true. -->
              <TreeView x:Name="SceneTreeView"
                        ItemsSource="{Binding Scene.Roots}"
                        SelectedItem="{Binding Scene.SelectedNode, Mode=TwoWay}">
                <TreeView.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{StaticResource Scene.InspectMenu}"
                              Click="OnSceneInspectMenu" />
                    <Separator />
                    <MenuItem Header="{StaticResource Scene.CopyAddressMenu}"
                              Click="OnSceneCopyAddressMenu" />
                    <MenuItem Header="{StaticResource Scene.CopyNameMenu}"
                              Click="OnSceneCopyNameMenu" />
                  </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate DataType="vm:SceneNode" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding DisplayLabel}"
                               FontFamily="Consolas,Cascadia Mono,monospace" />
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
                <!-- Wire IsExpanded TwoWay so the SceneNode's
                     OnIsExpandedChanged hook kicks off lazy load. The
                     DataType pin lets compiled bindings resolve against
                     the per-item SceneNode (not the Window's
                     MainWindowViewModel DataContext). -->
                <TreeView.Styles>
                  <Style Selector="TreeViewItem" x:DataType="vm:SceneNode">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  </Style>
                </TreeView.Styles>
              </TreeView>
            </DockPanel>
          </TabItem>

          <!-- Phase 27d — Value Search tab. CE-style First Scan / Next Scan
               via the beginValueScan / refineValueScan / endValueScan
               pipe RPCs. Inline (no separate axaml file) per the Symbol
               Finder / Scene Explorer convention. -->
          <TabItem Header="Value Search">
            <DockPanel Margin="6">
              <!-- Single / Group mode toggle. Group = CE-style "Group Scan":
                   find instances holding 2..4 values at distinct fields. -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10"
                          Margin="0,0,0,6">
                <ToggleSwitch OffContent="Single value" OnContent="Group (multiple values)"
                              IsChecked="{Binding ValueSearch.IsGroupMode, Mode=TwoWay}"
                              ToolTip.Tip="Group scan finds instances that hold ALL of 2–4 values at distinct numeric fields (any order), in one shared heap walk. Far more selective than a single value."/>
              </StackPanel>

              <!-- Top bar: dataType + scanType + Value + ValueTo + Limit + buttons -->
              <Grid DockPanel.Dock="Top" Margin="0,0,0,6"
                    IsVisible="{Binding !ValueSearch.IsGroupMode}"
                    ColumnDefinitions="Auto,*,Auto,*,Auto,2*,Auto"
                    RowDefinitions="Auto,Auto,Auto">

                <!-- Row 0: dataType + scanType -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding ValueSearch.DataTypes}"
                          SelectedItem="{Binding ValueSearch.SelectedDataType, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" Margin="0,0,12,0"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Scan:"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Row="0" Grid.Column="3"
                          ItemsSource="{Binding ValueSearch.ScanTypes}"
                          SelectedItem="{Binding ValueSearch.SelectedScanType, Mode=TwoWay}"
                          IsVisible="{Binding ValueSearch.IsNumericMode}"
                          HorizontalAlignment="Stretch" Margin="0,0,12,0"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Limit:"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal"
                            Spacing="6" HorizontalAlignment="Left" Margin="0,0,12,0">
                  <NumericUpDown Value="{Binding ValueSearch.Limit, Mode=TwoWay}"
                                 Minimum="10" Maximum="50000" Increment="50"
                                 ClipValueToMinMax="True" MinWidth="92"
                                 ToolTip.Tip="Max result ROWS shown in the grid (display only). The DLL now RETAINS more candidates for refine than it displays (see 'Max:'), so a common value's instance survives the first scan even when it isn't shown — refine to narrow it into view."/>
                  <TextBlock Text="Max:" VerticalAlignment="Center"/>
                  <NumericUpDown Value="{Binding ValueSearch.MaxCandidates, Mode=TwoWay}"
                                 Minimum="50000" Maximum="1000000" Increment="50000"
                                 ClipValueToMinMax="True" MinWidth="108"
                                 ToolTip.Tip="Max managed candidates the DLL RETAINS for refine (separate from the display Limit). Higher = a COMMON value's specific instance is more likely kept past the first scan. The DLL clamps by bitness: 32-bit Mono → 50,000 (the DLL shares the game's restricted address space); x64 → up to 1,000,000. Costs game-process memory while a scan session is open."/>
                  <CheckBox Content="Parallel"
                            IsChecked="{Binding ValueSearch.ParallelScan, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Scan with multiple worker threads (cores − 2) — much faster. ON by default. Turn OFF for games whose anti-tamper reacts to many threads hammering memory in parallel: the scan then runs single-threaded (slower but lower-profile). Safe on Mono either way — the parallel work only reads process memory, so no GC/BDWGC interaction."/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6" Orientation="Horizontal" Spacing="6">
                  <Button Content="First Scan"
                          Command="{Binding ValueSearch.FirstScanCommand}"
                          MinWidth="100"/>
                  <Button Content="End Session"
                          Command="{Binding ValueSearch.EndSessionCommand}"
                          MinWidth="100"/>
                </StackPanel>

                <!-- Row 1: Value + ValueTo -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Value:"
                           VerticalAlignment="Center" Margin="0,6,6,0"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding ValueSearch.ValueText, Mode=TwoWay}"
                         Margin="0,6,12,0"
                         PlaceholderText="100  or  GameOver  for strings"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="To:"
                           VerticalAlignment="Center" Margin="0,6,6,0"
                           IsVisible="{Binding ValueSearch.NeedsValueTo}"/>
                <TextBox Grid.Row="1" Grid.Column="3"
                         Text="{Binding ValueSearch.ValueToText, Mode=TwoWay}"
                         IsVisible="{Binding ValueSearch.NeedsValueTo}"
                         Margin="0,6,12,0"
                         PlaceholderText="upper bound"/>

                <TextBlock Grid.Row="1" Grid.Column="4" Text="Tol:"
                           VerticalAlignment="Center" Margin="0,6,6,0"/>
                <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal"
                            Spacing="6" Margin="0,6,12,0">
                  <TextBox Text="{Binding ValueSearch.ToleranceText, Mode=TwoWay}"
                           MinWidth="120"
                           PlaceholderText="0.5"
                           ToolTip.Tip="Float / double epsilon — only used for float/double scanning. Default 0.5 matches CE's 'Rounded (default)' float semantics: searching for 32 catches anything that displays as 32 (i.e. 31.5 to 32.5). Set to 0 for bit-exact match."/>
                  <!-- Cancel lives here (not the crowded button row) so it stays
                       on-screen; visible only while a scan is running. -->
                  <Button Content="⛔ Cancel"
                          Command="{Binding ValueSearch.CancelScanCommand}"
                          IsVisible="{Binding ValueSearch.IsBusy}"
                          MinWidth="90"
                          ToolTip.Tip="Abort the in-flight scan. Stops both the UI wait AND the DLL's scan (which otherwise runs to completion in the game process), freeing its work."/>
                </StackPanel>

                <!-- Row 2: encoding/matchMode (string mode) OR refine controls -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7"
                            Orientation="Horizontal" Spacing="6" Margin="0,6,0,0"
                            IsVisible="{Binding ValueSearch.IsStringMode}">
                  <TextBlock Text="Encoding:" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding ValueSearch.Encodings}"
                            SelectedItem="{Binding ValueSearch.SelectedEncoding, Mode=TwoWay}"
                            MinWidth="100"/>
                  <TextBlock Text="Match:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  <ComboBox ItemsSource="{Binding ValueSearch.MatchModes}"
                            SelectedItem="{Binding ValueSearch.SelectedMatchMode, Mode=TwoWay}"
                            MinWidth="100"/>
                  <TextBlock Text="(string scans are one-shot — no session / next-scan support)"
                             VerticalAlignment="Center" FontStyle="Italic" Opacity="0.6"
                             Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7"
                            Orientation="Horizontal" Spacing="6" Margin="0,6,0,0"
                            IsVisible="{Binding ValueSearch.IsNumericMode}">
                  <TextBlock Text="Next Scan:" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding ValueSearch.RefineTypes}"
                            SelectedItem="{Binding ValueSearch.SelectedRefineType, Mode=TwoWay}"
                            MinWidth="120"/>
                  <Button Content="Next Scan"
                          Command="{Binding ValueSearch.NextScanCommand}"
                          MinWidth="100"/>
                  <TextBlock Text="(session active)"
                             VerticalAlignment="Center" Foreground="LimeGreen"
                             Margin="12,0,0,0"
                             IsVisible="{Binding ValueSearch.HasSession}"/>
                </StackPanel>
              </Grid>

              <!-- Group mode: 2..4 slot input rows + scan buttons -->
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6" Spacing="6"
                          IsVisible="{Binding ValueSearch.IsGroupMode}">
                <ItemsControl ItemsSource="{Binding ValueSearch.GroupInputs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupSlotInput">
                      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Value:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1" Width="96" Margin="0,0,8,0"
                                  ItemsSource="{Binding DataTypes}"
                                  SelectedItem="{Binding DataType, Mode=TwoWay}"
                                  ToolTip.Tip="This value's data type / width."/>
                        <ComboBox Grid.Column="2" Width="110" Margin="0,0,8,0"
                                  ItemsSource="{Binding ScanTypes}"
                                  SelectedItem="{Binding ScanType, Mode=TwoWay}"
                                  ToolTip.Tip="First Scan uses exact / range. Next Scan also accepts changed / unchanged / increased / decreased / newValue (per row)."/>
                        <TextBox Grid.Column="3" Margin="0,0,8,0"
                                 Text="{Binding Value, Mode=TwoWay}"
                                 IsVisible="{Binding RequiresValueInput}"
                                 PlaceholderText="value"/>
                        <TextBlock Grid.Column="4" Text="to" VerticalAlignment="Center" Margin="0,0,8,0"
                                   IsVisible="{Binding RequiresValue2Input}"/>
                        <TextBox Grid.Column="5"
                                 Text="{Binding ValueTo, Mode=TwoWay}"
                                 IsVisible="{Binding RequiresValue2Input}"
                                 PlaceholderText="upper bound"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="＋ Add value" Command="{Binding ValueSearch.AddSlotCommand}"/>
                  <Button Content="－ Remove"   Command="{Binding ValueSearch.RemoveSlotCommand}"/>
                  <Border Width="1" Background="#40808080" Margin="6,2"/>
                  <Button Content="First Scan"  Command="{Binding ValueSearch.GroupFirstScanCommand}" MinWidth="100"/>
                  <Button Content="Next Scan"   Command="{Binding ValueSearch.GroupNextScanCommand}" MinWidth="100"
                          ToolTip.Tip="Refine using each row's mode — e.g. row 1 'decreased' + row 2 'unchanged' (Current HP fell, Max HP didn't). A candidate survives only while every value still maps to a distinct field."/>
                  <Button Content="End Session" Command="{Binding ValueSearch.GroupEndSessionCommand}" MinWidth="100"/>
                  <Button Content="⛔ Cancel"   Command="{Binding ValueSearch.CancelScanCommand}"
                          IsVisible="{Binding ValueSearch.IsBusy}" MinWidth="90"/>
                  <TextBlock Text="(session active)" VerticalAlignment="Center" Foreground="LimeGreen"
                             Margin="6,0,0,0" IsVisible="{Binding ValueSearch.HasGroupSession}"/>
                </StackPanel>
                <CheckBox Content="Ignore system assemblies (Unity*/System*/…)"
                          IsChecked="{Binding ValueSearch.IgnoreSystemAssembliesGroup, Mode=TwoWay}"
                          ToolTip.Tip="Conservative opt-in (ON by default): hide group candidates in engine / framework assemblies (Unity*, System*, Cinemachine*, TMPro, …) so the grid shows game-code objects. Re-derives the view without re-scanning."/>
              </StackPanel>

              <!-- Status / error band -->
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1F808080" CornerRadius="3">
                <TextBlock Text="{Binding ValueSearch.StatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="11"/>
              </Border>
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1FFF6060" CornerRadius="3"
                      IsVisible="{Binding ValueSearch.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ValueSearch.ErrorMessage}"
                           Foreground="#FF8060" TextWrapping="Wrap" FontSize="11"/>
              </Border>

              <!-- Results filter bar: hide engine/framework hits + substring
                   filter. Both re-derive the grid view from the unfiltered
                   scan results client-side (no re-scan). -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="8" Margin="0,0,0,6"
                          IsVisible="{Binding !ValueSearch.IsGroupMode}">
                <CheckBox Content="Ignore system assemblies (Unity*/System*/…)"
                          IsChecked="{Binding ValueSearch.IgnoreSystemAssemblies, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
                <TextBox Width="300"
                         Text="{Binding ValueSearch.ResultFilter, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         PlaceholderText="filter results (class / field / type / address)…"/>
              </StackPanel>

              <!-- Results: single grid (Single mode) OR group master-detail (Group mode),
                   overlaid in one fill cell; only the active mode's grid is visible. -->
              <Grid>
              <DataGrid ItemsSource="{Binding ValueSearch.FilteredResults}"
                        SelectedItem="{Binding ValueSearch.SelectedRow, Mode=TwoWay}"
                        AutoGenerateColumns="False" CanUserReorderColumns="True"
                        CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                        IsReadOnly="True"
                        CanUserSortColumns="True"
                        IsVisible="{Binding !ValueSearch.IsGroupMode}"
                        DoubleTapped="OnValueSearchRowActivated"
                        Name="ValueSearchGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Class" Binding="{Binding ClassDisplay}"
                                       Width="220" SortMemberPath="ClassDisplay" CanUserSort="True"/>
                  <DataGridTextColumn Header="Field" Binding="{Binding Field}"
                                       Width="180" SortMemberPath="Field" CanUserSort="True"/>
                  <DataGridTextColumn Header="Type" Binding="{Binding FieldType}"
                                       Width="120" SortMemberPath="FieldType" CanUserSort="True"/>
                  <DataGridTextColumn Header="Offset" Binding="{Binding OffsetLabel}"
                                       Width="80" SortMemberPath="FieldOffset" CanUserSort="True"/>
                  <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValue}"
                                       Width="120" SortMemberPath="CurrentValue" CanUserSort="True"/>
                  <DataGridTextColumn Header="Instance" Binding="{Binding InstanceAddr}"
                                       Width="180" FontFamily="Consolas,Menlo,monospace"
                                       SortMemberPath="InstanceAddr" CanUserSort="True"/>
                  <DataGridTextColumn Header="Address" Binding="{Binding Address}"
                                       Width="180" FontFamily="Consolas,Menlo,monospace"
                                       SortMemberPath="Address" CanUserSort="True"/>
                  <DataGridTextColumn Header="Kind" Binding="{Binding FieldKind}"
                                       Width="100" SortMemberPath="FieldKind" CanUserSort="True"/>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Inspect this instance"
                              Click="OnValueSearchInspectInstance"/>
                    <Separator/>
                    <MenuItem Header="Copy instance address"
                              Click="OnValueSearchCopyInstanceAddr"/>
                    <MenuItem Header="Copy field address"
                              Click="OnValueSearchCopyFieldAddr"/>
                    <MenuItem Header="Copy class name"
                              Click="OnValueSearchCopyClass"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
              </DataGrid>

              <!-- Group master-detail results (Group mode) -->
              <DataGrid ItemsSource="{Binding ValueSearch.GroupResults}"
                        SelectedItem="{Binding ValueSearch.SelectedGroupRow, Mode=TwoWay}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        CanUserResizeColumns="True" CanUserSortColumns="True"
                        RowDetailsVisibilityMode="VisibleWhenSelected"
                        IsVisible="{Binding ValueSearch.IsGroupMode}"
                        DoubleTapped="OnGroupCandidateActivated"
                        Name="GroupResultsGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Class" Binding="{Binding ClassDisplay}"
                                       Width="260" MinWidth="120"/>
                  <DataGridTextColumn Header="Instance" Binding="{Binding InstanceAddr}"
                                       Width="180" MinWidth="120"
                                       FontFamily="Consolas,Menlo,monospace"/>
                  <DataGridTextColumn Header="Matched (each value → field=value)"
                                       Binding="{Binding Summary}" Width="540" MinWidth="240"/>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                  <DataTemplate x:DataType="vm:GroupCandidateRow">
                    <StackPanel Margin="20,4,4,8" Spacing="4">
                      <TextBlock Text="{Binding LockSummary}" FontWeight="Bold"
                                 Foreground="LimeGreen" IsVisible="{Binding AllLocked}"/>
                      <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GroupSlotMatchRow">
                            <Grid ColumnDefinitions="Auto,200,120,90,140,Auto" Margin="0,1">
                              <TextBlock Grid.Column="0" Text="{Binding SlotIndex, StringFormat='#{0}'}"
                                         Margin="0,0,10,0" Opacity="0.7"/>
                              <TextBlock Grid.Column="1" Text="{Binding FieldOrSlot}"/>
                              <TextBlock Grid.Column="2" Text="{Binding FieldType}" Opacity="0.7"/>
                              <TextBlock Grid.Column="3" Text="{Binding OffsetLabel}"
                                         FontFamily="Consolas,Menlo,monospace"/>
                              <TextBlock Grid.Column="4" Text="{Binding CurrentValue}"/>
                              <TextBlock Grid.Column="5" Text="{Binding LockLabel}" Opacity="0.7"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Inspect this instance" Click="OnGroupCandidateInspect"/>
                    <Separator/>
                    <MenuItem Header="Copy instance address" Click="OnGroupCandidateCopyInstance"/>
                    <MenuItem Header="Copy class name" Click="OnGroupCandidateCopyClass"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
              </DataGrid>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- Phase 29b — Snapshot &amp; Diff tab. Default "全抓" capture
               scope (every assembly the runtime reports) + diff between
               any two snapshots in memory. UI strategy C: synthetic-type
               filtering is local (checkbox), not DLL-side. -->
          <TabItem Header="Snapshot" IsVisible="{Binding ExperimentalEnabled}">
            <Grid RowDefinitions="Auto,*">
            <ToggleSwitch Grid.Row="0" Margin="6,6,6,0"
                          OffContent="Diff" OnContent="Group (multiple values)"
                          IsChecked="{Binding Snapshot.IsGroupMode, Mode=TwoWay}"
                          ToolTip.Tip="Diff compares two snapshots field-by-field. Group finds objects that hold ALL of 2–4 values at distinct numeric fields — in one snapshot (absolute) or across two (temporal: Changed/Unchanged/Increased/Decreased)."/>
            <DockPanel Grid.Row="1" Margin="6" IsVisible="{Binding !Snapshot.IsGroupMode}">

              <!-- Top action row (2026-06-05): capture config moved to the
                   modeless CaptureWindow (📸 New snapshot…); the Snapshot-debug
                   flyout sits on the SAME row so neither steals a line from the
                   result grid. Progress + Cancel live in the capture window; the
                   status strip below mirrors it. -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="8" Margin="0,0,0,6">
                <Button Content="📸 New snapshot…"
                        Click="OnNewSnapshotClicked"
                        ToolTip.Tip="Open the capture window: caps, scope, array-element fields, decode budget, targets, and Take Snapshot. Opens as a separate window so the diff result grid below stays full-height. The captured snapshot lands in the A/B dropdowns."/>
                <Button Content="🔍 Snapshot debug — instance &amp; class lookup ▾"
                        ToolTip.Tip="Open a diagnostic flyout: look up a captured instance address or list a class's captured instances across the selected A/B snapshots. Opens as an overlay so it doesn't shrink the result grid.">
                  <Button.Flyout>
                    <Flyout Placement="Bottom">
                      <Border Padding="6" Background="#1F808080" CornerRadius="3" Width="720">
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="Address:" VerticalAlignment="Center" Width="60"/>
                              <TextBox Text="{Binding Snapshot.DebugLookupAddress, Mode=TwoWay}"
                                       Width="280"
                                       FontFamily="Consolas,Menlo,monospace"
                                       PlaceholderText="e.g. 0x000000002986ACC0 or 2986ACC0"/>
                              <Button Content="Compare in A &amp; B"
                                      Command="{Binding Snapshot.DebugLookupInstanceCommand}"
                                      MinWidth="140"
                                      ToolTip.Tip="Normalises the address, then walks both selected snapshots' FieldIndex for matching keys. Output below shows every captured field for this instance + per-field changed/added/removed/unchanged tally."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="Class:" VerticalAlignment="Center" Width="60"/>
                              <TextBox Text="{Binding Snapshot.DebugLookupClass, Mode=TwoWay}"
                                       Width="280"
                                       PlaceholderText="e.g. Mortal.Core.GameStat or just GameStat"/>
                              <Button Content="List captured instances"
                                      Command="{Binding Snapshot.DebugLookupClassInstancesCommand}"
                                      MinWidth="170"
                                      ToolTip.Tip="Walks each snapshot's Classes list for matches, dumps every captured instance address sorted numerically with a few spotlight fields (_name, _value). Use to confirm whether the snapshot saw the full instance set — e.g. 'live game has 152 GameStat instances, snap #2 only captured 80, and 0x2962ACC0 isn't among them'."/>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.7"
                                       Text="Pick A and B above first — empty selection = empty result."/>
                          </StackPanel>
                          <TextBox Text="{Binding Snapshot.DebugLookupOutput}"
                                   IsReadOnly="True"
                                   AcceptsReturn="True"
                                   FontFamily="Consolas,Menlo,monospace"
                                   FontSize="11"
                                   TextWrapping="NoWrap"
                                   MinHeight="200"
                                   MaxHeight="400"
                                   VerticalContentAlignment="Top"
                                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                      </Border>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>

              <!-- Status + error. Two-row layout: Diff/Take/Drop summary
                   on top (overwritten by command actions), live filter
                   tally underneath (auto-refreshed every RebuildFilteredRows
                   pass so the breakdown stays current as the user toggles
                   filters). Empty FilterResultLine collapses cleanly. -->
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1F808080" CornerRadius="3">
                <StackPanel>
                  <TextBlock Text="{Binding Snapshot.StatusMessage}"
                             TextWrapping="Wrap" FontSize="11"/>
                  <TextBlock Text="{Binding Snapshot.FilterResultLine}"
                             FontSize="11" Opacity="0.85"
                             IsVisible="{Binding Snapshot.FilterResultLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
              </Border>

              <!-- Phase 29c-7: DB status line + folder / settings buttons.
                   Auto-hides when no game is connected (DbStatusLine empty). -->
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1F60C0FF" CornerRadius="3"
                      IsVisible="{Binding Snapshot.DbStatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Snapshot.DbStatusLine}"
                             FontSize="11" VerticalAlignment="Center"
                             TextWrapping="NoWrap"/>
                  <Button Content="📁 Open folder"
                          Click="OnOpenSnapshotDbFolderClicked"
                          Padding="6,2" Margin="6,0,0,0"
                          ToolTip.Tip="Open the snapshots directory in Explorer."/>
                  <Button Content="⚙ Settings…"
                          Click="OnSnapshotSettingsClicked"
                          Padding="6,2"
                          ToolTip.Tip="Configure snapshot DB directory, auto-save, and auto-prune threshold."/>
                  <!-- Cumulative UI-memory of held snapshots, folded into the DB
                       strip (2026-06-05) so store + memory info is one row. -->
                  <TextBlock Text="{Binding Snapshot.TotalSnapshotsMemoryBanner}"
                             FontSize="11" VerticalAlignment="Center" Opacity="0.75"
                             Margin="8,0,0,0" TextWrapping="NoWrap"
                             IsVisible="{Binding Snapshot.TotalSnapshotsMemoryBanner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
              </Border>

              <!-- Phase 29c-5: cross-session / cross-build banner. Color
                   shifts from blue (info, statics-only auto-applied) to
                   yellow (cross-build, more aggressive warning) via a
                   simple "⚠" leading-char check; empty banner collapses. -->
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#26FFA640" CornerRadius="3"
                      IsVisible="{Binding Snapshot.CrossSessionBanner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right"
                            Content="Force include instances"
                            IsChecked="{Binding Snapshot.ForceIncludeInstancesCrossSession, Mode=TwoWay}"
                            ToolTip.Tip="Cross-session diff defaults to statics-only because instance addresses change every game launch. Tick to include instances anyway — produces add/remove noise."/>
                  <TextBlock Text="{Binding Snapshot.CrossSessionBanner}"
                             TextWrapping="Wrap" FontSize="11"/>
                </DockPanel>
              </Border>
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1FFF6060" CornerRadius="3"
                      IsVisible="{Binding Snapshot.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Snapshot.ErrorMessage}"
                           Foreground="#FF8060" TextWrapping="Wrap" FontSize="11"/>
              </Border>

              <!-- Mid: A/B selection + per-side Drop + Diff button +
                   include-unchanged toggle. Drop A / Drop B are independent
                   so the user can clear either side without swapping. -->
              <Border DockPanel.Dock="Top" Padding="6" Margin="0,0,0,6"
                      Background="#1F808080" CornerRadius="3">
                <StackPanel Spacing="4">
                  <!-- (Cumulative held-snapshot memory banner moved into the DB
                       strip above — 2026-06-05.) -->
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,*,Auto,Auto,Auto"
                        RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="A:"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Snapshot.Snapshots}"
                              SelectedItem="{Binding Snapshot.SelectedSnapshotA, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Content="Drop A"
                            Command="{Binding Snapshot.DropSnapshotACommand}"
                            MinWidth="70" Margin="0,0,4,0"
                            ToolTip.Tip="Drop the snapshot selected in A from memory. Does NOT touch the saved DB copy."/>

                    <TextBlock Grid.Column="3" Text="B:"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding Snapshot.Snapshots}"
                              SelectedItem="{Binding Snapshot.SelectedSnapshotB, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                    <Button Grid.Column="5" Content="Drop B"
                            Command="{Binding Snapshot.DropSnapshotBCommand}"
                            MinWidth="70" Margin="0,0,12,0"
                            ToolTip.Tip="Drop the snapshot selected in B. Independent from Drop A — no need to swap sides."/>

                    <CheckBox Grid.Column="6"
                              Content="Include unchanged"
                              IsChecked="{Binding Snapshot.IncludeUnchangedRows, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              ToolTip.Tip="When ON, the next Diff also emits rows where the value is identical in A and B. Lets you use the value-range / field-name filters to find fields by their value even when they didn't change between snapshots (e.g. spotting other money / HP fields in the same numeric range). Cost: 10–100× more rows on a wide diff."/>

                    <Button Grid.Column="7" Content="Diff A → B"
                            Command="{Binding Snapshot.DiffCommand}"
                            MinWidth="120"/>
                  </Grid>

                  <!-- Phase 29c-4: per-side persistence row. Save flips the
                       envelope from in-memory only ("💾 not saved") to
                       on-disk ("✓ saved"); Delete removes from BOTH memory
                       AND the DB. Drop A/B (above) only frees memory. -->
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowDefinitions="Auto" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="A:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="💾 Save A"
                            Command="{Binding Snapshot.SaveSnapshotCommand}"
                            CommandParameter="{Binding Snapshot.SelectedSnapshotA}"
                            Margin="0,0,4,0"
                            ToolTip.Tip="Persist the snapshot selected in A to the per-game DB. Idempotent — already-saved snapshots are skipped."/>
                    <Button Grid.Column="2" Content="🗑 Delete A from DB"
                            Command="{Binding Snapshot.DeleteSnapshotFromDbCommand}"
                            CommandParameter="{Binding Snapshot.SelectedSnapshotA}"
                            ToolTip.Tip="Permanently remove A from both memory AND the saved DB. Cannot be undone."/>

                    <TextBlock Grid.Column="4" Text="B:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <Button Grid.Column="5" Content="💾 Save B"
                            Command="{Binding Snapshot.SaveSnapshotCommand}"
                            CommandParameter="{Binding Snapshot.SelectedSnapshotB}"
                            Margin="0,0,4,0"/>
                    <Button Grid.Column="6" Content="🗑 Delete B from DB"
                            Command="{Binding Snapshot.DeleteSnapshotFromDbCommand}"
                            CommandParameter="{Binding Snapshot.SelectedSnapshotB}"/>
                  </Grid>

                  <!-- Persistence-status hints for the currently-selected pair.
                       Show even for envelopes the user hasn't pressed Save on
                       yet so they know what's at risk. -->
                  <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,2,0,0"
                        IsVisible="{Binding Snapshot.SelectedSnapshotA, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Grid.Column="0" Text="A status:" Opacity="0.7" FontSize="11" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Snapshot.SelectedSnapshotA.PersistenceStatus}" FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="B status:" Opacity="0.7" FontSize="11" Margin="12,0,6,0"
                               IsVisible="{Binding Snapshot.SelectedSnapshotB, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Snapshot.SelectedSnapshotB.PersistenceStatus}" FontSize="11"
                               IsVisible="{Binding Snapshot.SelectedSnapshotB, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Filter bar — Phase 29 polish: noise-reduction filters
                   layered over Strategy C synthetic-type masking. Row 1 =
                   structural toggles; Row 2 = textual / numeric narrowing.
                   Wrapped in an Expander (default open) so the user can
                   collapse it once they're settled on a filter set —
                   reclaims ~80 px of vertical space for the diff grid. -->
              <Expander DockPanel.Dock="Top" Margin="0,0,0,6"
                        IsExpanded="False"
                        Header="🔍 Filters">
              <Border Padding="6"
                      Background="#1F808080" CornerRadius="3">
                <StackPanel Spacing="6">
                  <StackPanel.Styles>
                    <!-- WrapPanel has no Spacing; give wrapped children a uniform
                         gap so the filter rows WRAP instead of overflowing the
                         window at high DPI (2026-06-05). -->
                    <Style Selector="WrapPanel > :is(Control)">
                      <Setter Property="Margin" Value="0,0,12,4"/>
                    </Style>
                  </StackPanel.Styles>
                  <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="Hide synthetic types"
                              IsChecked="{Binding Snapshot.HideSyntheticTypes, Mode=TwoWay}"
                              ToolTip.Tip="Hide rows whose class name starts with '&lt;' (compiler-generated: &lt;Module&gt;, &lt;&gt;f__AnonymousType*, &lt;&gt;c, &lt;Start&gt;d__N, async-state-machines). These are usually false-positive 'instances' from wide-scan picking up metadata references — not real game objects."/>
                    <!-- "Changed" trichotomy (Phase 29-polish 2026-05-29):
                         the single Changed checkbox was split into three
                         sub-toggles so the user can express direction
                         filters via set unions with Unchanged:
                           ≥  →  Unchanged + Increased
                           ≤  →  Unchanged + Decreased
                         Combined with the numeric Value-range filter below,
                         this answers "I don't know the exact value but it's
                         somewhere in 0-1000 and it just went down". -->
                    <CheckBox Content="↑ Increased"
                              IsChecked="{Binding Snapshot.ShowIncreased, Mode=TwoWay}"
                              ToolTip.Tip="Show numeric rows where the new value is greater than the old value. Combine with 'Unchanged' to express ≥ (value grew or stayed the same)."/>
                    <CheckBox Content="↓ Decreased"
                              IsChecked="{Binding Snapshot.ShowDecreased, Mode=TwoWay}"
                              ToolTip.Tip="Show numeric rows where the new value is less than the old value. Combine with 'Unchanged' to express ≤ (value shrank or stayed the same)."/>
                    <CheckBox Content="Δ Other changed"
                              IsChecked="{Binding Snapshot.ShowOtherChanged, Mode=TwoWay}"
                              ToolTip.Tip="Show 'changed' rows that aren't numerically comparable — string content changes, pointer-address changes, error rows, or numeric rows where one side failed to parse."/>
                    <CheckBox Content="Added"
                              IsChecked="{Binding Snapshot.ShowAdded, Mode=TwoWay}"/>
                    <CheckBox Content="Removed"
                              IsChecked="{Binding Snapshot.ShowRemoved, Mode=TwoWay}"/>
                    <CheckBox Content="Unchanged"
                              IsChecked="{Binding Snapshot.ShowUnchanged, Mode=TwoWay}"
                              ToolTip.Tip="Show rows that didn't change between A and B. Only populated when the prior Diff ran with 'Include unchanged' ON — otherwise no unchanged rows exist to show. Combine with Increased/Decreased to express ≥ or ≤ semantics."/>
                    <CheckBox Content="Hide pointer-only Δ"
                              IsChecked="{Binding Snapshot.HidePointerChanges, Mode=TwoWay}"
                              ToolTip.Tip="Hide rows where both Old and New are formatted as ptr=0x… (reference fields whose pointer changed but content diff would show up separately as field-value rows). Usually re-allocation noise."/>
                    <CheckBox Content="Hide large strings &gt;"
                              IsChecked="{Binding Snapshot.HideLargeStrings, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Hide string rows whose longer side exceeds the threshold. Targets System.Exception._stackTrace / _remoteStackTraceString and similar large blob fields that drown out signal."/>
                    <NumericUpDown Value="{Binding Snapshot.LargeStringThreshold, Mode=TwoWay}"
                                   Minimum="0" Maximum="65536" Increment="64"
                                   MinWidth="110"/>
                    <TextBlock Text="chars" VerticalAlignment="Center"/>
                    <CheckBox Content="Apply field exclusions"
                              IsChecked="{Binding Snapshot.HideNoisyFields, Mode=TwoWay}"
                              ToolTip.Tip="When ON, field names you've excluded via the right-side stats panel are filtered out of the result. Turn OFF to peek at them again without losing the exclusion list."/>
                  </WrapPanel>

                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Class:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Snapshot.ClassFilterText, Mode=TwoWay}"
                             PlaceholderText="substring (case-insensitive)"
                             Width="200"/>
                    <TextBlock Text="Field:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Snapshot.FieldFilterText, Mode=TwoWay}"
                             PlaceholderText="substring (case-insensitive)"
                             Width="200"/>
                    <TextBlock Text="Value range:" VerticalAlignment="Center"
                               ToolTip.Tip="Restrict to numeric rows whose Old OR New value lies in [Min, Max]. Empty Min/Max = unbounded on that side. Non-numeric rows are filtered out as soon as either bound is set. Press Apply to commit — the range filter is intentionally NOT live (each pass walks 800K+ rows on a wide diff, real-time updating would freeze the UI)."/>
                    <NumericUpDown Value="{Binding Snapshot.PendingValueRangeMin, Mode=TwoWay}"
                                   PlaceholderText="min" MinWidth="120"/>
                    <TextBlock Text="–" VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding Snapshot.PendingValueRangeMax, Mode=TwoWay}"
                                   PlaceholderText="max" MinWidth="120"/>
                    <Button Content="Apply"
                            Command="{Binding Snapshot.ApplyValueRangeFilterCommand}"
                            MinWidth="60"
                            ToolTip.Tip="Commit the Min/Max above into the live filter. Run only when both bounds are typed in so the rebuild fires once instead of per-keystroke."/>
                    <Button Content="Clear"
                            Command="{Binding Snapshot.ClearValueRangeFilterCommand}"
                            MinWidth="60"
                            ToolTip.Tip="Reset Min and Max to empty (unbounded). NumericUpDown can't go back to empty via spinner clicks, so this is the only way out once a value is typed."/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              </Expander>

              <!-- Snapshot-debug flyout moved up to the top action row
                   (2026-06-05), sharing a line with “📸 New snapshot…”. -->

              <!-- Diff result area: DataGrid + collapsible stats panel.
                   GridSplitter lets the user resize; the stats panel can
                   also be toggled off entirely via the column-header button. -->
              <Grid ColumnDefinitions="*,Auto,Auto">
                <DataGrid Grid.Column="0"
                          ItemsSource="{Binding Snapshot.FilteredDiffRows}"
                          AutoGenerateColumns="False" CanUserReorderColumns="True"
                          CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          DoubleTapped="OnSnapshotRowActivated"
                          Name="SnapshotDiffGrid">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Class" Binding="{Binding ClassDisplay}"
                                         Width="240" SortMemberPath="ClassDisplay" CanUserSort="True"/>
                    <DataGridTextColumn Header="Field" Binding="{Binding Field}"
                                         Width="180" SortMemberPath="Field" CanUserSort="True"/>
                    <DataGridTextColumn Header="Offset" Binding="{Binding OffsetLabel}"
                                         Width="80" SortMemberPath="FieldOffset" CanUserSort="True"/>
                    <DataGridTextColumn Header="Instance" Binding="{Binding InstanceLabel}"
                                         Width="180" FontFamily="Consolas,Menlo,monospace"
                                         SortMemberPath="InstanceLabel" CanUserSort="True"/>
                    <DataGridTextColumn Header="Old" Binding="{Binding OldValue}"
                                         Width="160" SortMemberPath="OldValue" CanUserSort="True"/>
                    <DataGridTextColumn Header="New" Binding="{Binding NewValue}"
                                         Width="160" SortMemberPath="NewValue" CanUserSort="True"/>
                    <DataGridTextColumn Header="Δ" Binding="{Binding Delta}"
                                         Width="90" SortMemberPath="Delta" CanUserSort="True"/>
                    <DataGridTextColumn Header="Kind" Binding="{Binding ChangeKind}"
                                         Width="80" SortMemberPath="ChangeKind" CanUserSort="True"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding FieldType}"
                                         Width="160" SortMemberPath="FieldType" CanUserSort="True"/>
                  </DataGrid.Columns>
                  <DataGrid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Inspect this instance"
                                Click="OnSnapshotInspectInstance"/>
                      <MenuItem Header="Find what's at this address (Address Lookup)"
                                Click="OnSnapshotAddressLookup"/>
                      <MenuItem Header="Pivot this class…"
                                Click="OnSnapshotPivotClassClicked"/>
                      <Separator/>
                      <MenuItem Header="Exclude this field name from results"
                                Click="OnSnapshotExcludeFieldName"/>
                      <Separator/>
                      <MenuItem Header="Copy instance address"
                                Click="OnSnapshotCopyInstanceAddr"/>
                      <MenuItem Header="Copy class name"
                                Click="OnSnapshotCopyClass"/>
                      <MenuItem Header="Copy field name"
                                Click="OnSnapshotCopyField"/>
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                </DataGrid>

                <GridSplitter Grid.Column="1" Width="3" ResizeDirection="Columns"
                              Background="#3F808080"
                              IsVisible="{Binding #SnapshotStatsPanel.IsVisible}"/>

                <!-- Right-side stats panel — toggleable via the header button. -->
                <Border Grid.Column="2" Name="SnapshotStatsPanel"
                        Width="300" Padding="6"
                        Background="#1F808080" CornerRadius="3"
                        Margin="0,0,0,0">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto"
                          Margin="0,0,0,4">
                      <TextBlock Grid.Column="0" Text="Top field names in diff"
                                 FontWeight="Bold" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="Clear exclusions"
                              Command="{Binding Snapshot.ClearFieldExclusionsCommand}"
                              FontSize="11" Padding="6,2"
                              ToolTip.Tip="Remove every field name from the exclusion list. Excluded names are not lost when you toggle 'Apply field exclusions' off — only this button clears them."/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" FontSize="11" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Click a row to toggle exclusion. Field names that appear on many diff rows are often noise (m_CachedPtr, &lt;&gt;1__state, etc.)."/>
                    <DataGrid Name="SnapshotFieldStatsGrid"
                              ItemsSource="{Binding Snapshot.FieldNameStats}"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True" CanUserSortColumns="True"
                              IsReadOnly="True"
                              DoubleTapped="OnSnapshotFieldStatActivated">
                      <DataGrid.Columns>
                        <!-- Auto (not star) so a long field name overflows +
                             scrolls instead of clamping the grid to the pane. -->
                        <DataGridTextColumn Header="Field" Binding="{Binding FieldName}"
                                             Width="Auto" MinWidth="220" MaxWidth="700"
                                             SortMemberPath="FieldName" CanUserSort="True"/>
                        <DataGridTextColumn Header="#" Binding="{Binding Count}"
                                             Width="60" SortMemberPath="Count" CanUserSort="True"/>
                        <DataGridCheckBoxColumn Header="Excl." Binding="{Binding IsExcluded}"
                                                 Width="50" IsReadOnly="True"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Border>
              </Grid>
            </DockPanel>

            <!-- Group mode: find objects holding 2–4 values at distinct fields -->
            <DockPanel Grid.Row="1" Margin="6" IsVisible="{Binding Snapshot.IsGroupMode}">
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1F808080" CornerRadius="3">
                <TextBlock Text="{Binding Snapshot.StatusMessage}" TextWrapping="Wrap" FontSize="11"/>
              </Border>
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1FFF6060" CornerRadius="3"
                      IsVisible="{Binding Snapshot.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Snapshot.ErrorMessage}" Foreground="#FF8060" TextWrapping="Wrap" FontSize="11"/>
              </Border>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,*" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="A:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Snapshot.Snapshots}"
                          SelectedItem="{Binding Snapshot.SelectedSnapshotA, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          HorizontalAlignment="Stretch" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="B (optional — temporal):"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Snapshot.Snapshots}"
                          SelectedItem="{Binding Snapshot.SelectedSnapshotB, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          HorizontalAlignment="Stretch"/>
              </Grid>
              <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Snapshot.GroupInputs}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SnapshotGroupSlotInput">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,*" Margin="0,0,0,4">
                      <TextBlock Grid.Column="0" Text="Value:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <ComboBox Grid.Column="1" Width="150" Margin="0,0,8,0"
                                ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope, Mode=TwoWay}"/>
                      <ComboBox Grid.Column="2" Width="110" Margin="0,0,8,0"
                                ItemsSource="{Binding Predicates}" SelectedItem="{Binding Predicate, Mode=TwoWay}"
                                ToolTip.Tip="Exact/Bigger/Smaller/Between use the (newest) value; Changed/Unchanged/Increased/Decreased compare across A→B (need B)."/>
                      <TextBox Grid.Column="3" Margin="0,0,8,0" Text="{Binding Target, Mode=TwoWay}"
                               IsVisible="{Binding RequiresTarget}" PlaceholderText="value"/>
                      <TextBlock Grid.Column="4" Text="to" VerticalAlignment="Center" Margin="0,0,8,0"
                                 IsVisible="{Binding RequiresTarget2}"/>
                      <TextBox Grid.Column="5" Text="{Binding Target2, Mode=TwoWay}"
                               IsVisible="{Binding RequiresTarget2}" PlaceholderText="upper bound"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                <Button Content="＋ Add value" Command="{Binding Snapshot.AddGroupSlotCommand}"/>
                <Button Content="－ Remove"   Command="{Binding Snapshot.RemoveGroupSlotCommand}"/>
                <Border Width="1" Background="#40808080" Margin="6,2"/>
                <Button Content="Run group" Command="{Binding Snapshot.RunSnapshotGroupCommand}" MinWidth="100"/>
                <CheckBox Content="Ignore system assemblies"
                          IsChecked="{Binding Snapshot.IgnoreSystemAssembliesGroup, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
                <TextBlock Text="(relative predicates need snapshot B)" VerticalAlignment="Center"
                           Opacity="0.6" FontSize="11" Margin="6,0,0,0"/>
              </StackPanel>
              <DataGrid ItemsSource="{Binding Snapshot.GroupResults}"
                        SelectedItem="{Binding Snapshot.SelectedGroupRow, Mode=TwoWay}"
                        AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                        CanUserResizeColumns="True" CanUserSortColumns="True"
                        RowDetailsVisibilityMode="VisibleWhenSelected"
                        Name="SnapshotGroupGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Class" Binding="{Binding ClassDisplay}" Width="260" MinWidth="120"/>
                  <DataGridTextColumn Header="Instance" Binding="{Binding InstanceAddr}" Width="180" MinWidth="120"
                                       FontFamily="Consolas,Menlo,monospace"/>
                  <DataGridTextColumn Header="Matched (each value → field=value)"
                                       Binding="{Binding Summary}" Width="540" MinWidth="240"/>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                  <DataTemplate x:DataType="vm:GroupCandidateRow">
                    <StackPanel Margin="20,4,4,8" Spacing="4">
                      <TextBlock Text="{Binding LockSummary}" FontWeight="Bold"
                                 Foreground="LimeGreen" IsVisible="{Binding AllLocked}"/>
                      <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GroupSlotMatchRow">
                            <Grid ColumnDefinitions="Auto,200,120,90,140,Auto" Margin="0,1">
                              <TextBlock Grid.Column="0" Text="{Binding SlotIndex, StringFormat='#{0}'}"
                                         Margin="0,0,10,0" Opacity="0.7"/>
                              <TextBlock Grid.Column="1" Text="{Binding FieldOrSlot}"/>
                              <TextBlock Grid.Column="2" Text="{Binding FieldType}" Opacity="0.7"/>
                              <TextBlock Grid.Column="3" Text="{Binding OffsetLabel}"
                                         FontFamily="Consolas,Menlo,monospace"/>
                              <TextBlock Grid.Column="4" Text="{Binding CurrentValue}"/>
                              <TextBlock Grid.Column="5" Text="{Binding LockLabel}" Opacity="0.7"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </DataGrid.RowDetailsTemplate>
              </DataGrid>
            </DockPanel>
            </Grid>
          </TabItem>

          <!-- Phase 29d — SPC Query tab. N snapshots × N predicates
               killer use case: identify a field by its value SIGNATURE
               across multiple game sessions (e.g. 10160 → 9910 → 9410
               → 9410 across 4 sessions uniquely locates the 銀兩
               GameStat by its spending pattern, no matter how much
               noise is in the heap). -->
          <TabItem Header="SPC Query" IsVisible="{Binding ExperimentalEnabled}">
            <Grid RowDefinitions="Auto,*">
            <ToggleSwitch Grid.Row="0" Margin="6,6,6,0"
                          OffContent="Single field" OnContent="Group (multiple values)"
                          IsChecked="{Binding SpcQuery.IsGroupMode, Mode=TwoWay}"
                          ToolTip.Tip="Single = one field's value sequence vs a per-snapshot predicate chain. Group = find objects where 2–4 fields EACH follow their own chain across the snapshots, at distinct offsets."/>
            <DockPanel Grid.Row="1" Margin="6" IsVisible="{Binding !SpcQuery.IsGroupMode}">
              <!-- Wave A — busy indicator (engine compute runs off the UI thread). -->
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,4"
                      Background="#264080FF" CornerRadius="3"
                      IsVisible="{Binding SpcQuery.IsRunning}">
                <StackPanel Orientation="Vertical" Spacing="3">
                  <TextBlock Text="Working… computing in the background — the UI stays responsive."
                             FontSize="11" FontWeight="SemiBold"/>
                  <ProgressBar IsIndeterminate="True" Height="4" Minimum="0" Maximum="100"/>
                </StackPanel>
              </Border>
              <!-- Status + error + mode banner -->
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1F808080" CornerRadius="3">
                <TextBlock Text="{Binding SpcQuery.StatusMessage}"
                           TextWrapping="Wrap" FontSize="11"/>
              </Border>
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1FFF6060" CornerRadius="3"
                      IsVisible="{Binding SpcQuery.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding SpcQuery.ErrorMessage}"
                           Foreground="#FF8060" TextWrapping="Wrap" FontSize="11"/>
              </Border>
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#26FFA640" CornerRadius="3"
                      IsVisible="{Binding SpcQuery.ModeBanner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding SpcQuery.ModeBanner}"
                           TextWrapping="Wrap" FontSize="11"/>
              </Border>

              <!-- Filters row -->
              <Expander DockPanel.Dock="Top" Margin="0,0,0,6"
                        IsExpanded="True" Header="🔍 Filters">
                <Border Padding="6" Background="#1F808080" CornerRadius="3">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="Statics only"
                              IsChecked="{Binding SpcQuery.StaticsOnly, Mode=TwoWay}"
                              ToolTip.Tip="Match only static-field rows. Auto-enabled when selected snapshots span multiple game sessions (instance addresses don't survive game launches)."/>
                    <CheckBox Content="Exclude synthetic"
                              IsChecked="{Binding SpcQuery.ExcludeSynthetic, Mode=TwoWay}"
                              ToolTip.Tip="Skip rows whose class name starts with '&lt;' (compiler-generated types)."/>
                    <CheckBox Content="Numeric only"
                              IsChecked="{Binding SpcQuery.NumericOnly, Mode=TwoWay}"
                              ToolTip.Tip="Drop rows where any snapshot's value doesn't parse as a finite double. Required for Increased / Decreased / Delta predicates to mean anything; leave OFF when chasing string fields via Exact / Unchanged."/>
                    <TextBlock Text="Class:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <!-- AutoCompleteBox dropdown is populated from KnownClasses,
                         which RefreshKnownTypesAndClasses fills with every
                         ClassFqn seen across hydrated snapshots. Empty until
                         the first Run hydrates at least one snap — the
                         control still works as a plain TextBox until then. -->
                    <AutoCompleteBox Text="{Binding SpcQuery.ClassFilter, Mode=TwoWay}"
                                     ItemsSource="{Binding SpcQuery.KnownClasses}"
                                     PlaceholderText="substring"
                                     MinimumPrefixLength="1"
                                     FilterMode="ContainsOrdinal"
                                     Width="240"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="Substring match against the class fully-qualified name. Dropdown suggestions are sourced from snapshots already loaded into memory; if the list is short, run the query once to hydrate snapshots + populate it."/>
                    <TextBlock Text="Type:" VerticalAlignment="Center"/>
                    <!-- KnownTypes is seeded with the curated managed-primitive
                         list (System.Int32 / UInt32 / Single / etc.) so even
                         before any hydrate the user gets useful suggestions
                         for the common types. Hydrate union adds game-specific
                         types (UnityEngine.Color, Mortal.Core.GameStat, ...). -->
                    <AutoCompleteBox Text="{Binding SpcQuery.TypeFilter, Mode=TwoWay}"
                                     ItemsSource="{Binding SpcQuery.KnownTypes}"
                                     PlaceholderText="e.g. Int32"
                                     MinimumPrefixLength="1"
                                     FilterMode="ContainsOrdinal"
                                     Width="180"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="Substring match against the field type. Type 'u' to surface System.UInt16 / UInt32 / UInt64; type 'Vector' for the Unity vector types. Suggestions come from a curated primitive list plus types observed in already-hydrated snapshots."/>
                  </StackPanel>
                </Border>
              </Expander>

              <!-- Run button row -->
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6"
                      Background="#1F808080" CornerRadius="3">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="▶ Run SPC Query"
                          Command="{Binding SpcQuery.RunCommand}"
                          MinWidth="180" Padding="10,4"/>
                  <TextBlock VerticalAlignment="Center" Opacity="0.7" FontSize="11"
                             Text="Tip: at least 2 snapshots; first predicate must be absolute (Any / Exact / Range / NotEqual)."/>
                </StackPanel>
              </Border>

              <!-- Snapshot picker + predicates grid (top half) and
                   Results grid (bottom half) split via Grid rows. -->
              <Grid RowDefinitions="*,6,*">
                <!-- Top: snapshot rows with per-row predicate editor -->
                <Border Grid.Row="0" Padding="0"
                        Background="#1F808080" CornerRadius="3">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Snapshots + per-snapshot predicate"
                               FontWeight="SemiBold" Margin="6,4,6,4"/>
                    <DataGrid ItemsSource="{Binding SpcQuery.SelectionRows}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True">
                      <DataGrid.Columns>
                        <!-- Use-column: same single-click fix as the
                             Operand cells below. DataGridCheckBoxColumn
                             would force the user to click twice (first
                             click selects the row, second toggles). Live
                             CheckBox in a template column makes the first
                             click flip Include. -->
                        <DataGridTemplateColumn Header="Use" Width="50">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <CheckBox IsChecked="{Binding Include, Mode=TwoWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Snapshot"
                                            Binding="{Binding DisplayLabel}"
                                            IsReadOnly="True"
                                            Width="2*"/>
                        <DataGridTemplateColumn Header="Predicate" Width="170">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <ComboBox SelectedItem="{Binding PredicateKind, Mode=TwoWay}"
                                        ItemsSource="{x:Static vm:SpcQueryViewModel.AllPredicateKinds}"
                                        Margin="2"/>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Operand 1 + 2: TemplateColumn with a live TextBox
                             rather than DataGridTextColumn. DataGridTextColumn
                             needs double-click to enter edit mode before
                             typing works — surprised users into thinking
                             the field was read-only. Live TextBox accepts
                             typing on first click. -->
                        <DataGridTemplateColumn Header="Operand" Width="130">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBox Text="{Binding OperandText, Mode=TwoWay}"
                                       Margin="2"
                                       VerticalAlignment="Center"/>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Operand 2 (Range / DeltaRange only)" Width="220">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBox Text="{Binding Operand2Text, Mode=TwoWay}"
                                       Margin="2"
                                       VerticalAlignment="Center"/>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" ResizeDirection="Rows"
                              Height="6" Background="#33808080"/>

                <!-- Bottom: results -->
                <Border Grid.Row="2" Padding="0"
                        Background="#1F808080" CornerRadius="3">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Results"
                               FontWeight="SemiBold" Margin="6,4,6,4"/>
                    <DataGrid Name="SpcResultsGrid"
                              ItemsSource="{Binding SpcQuery.Results}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True"
                              DoubleTapped="OnSpcResultDoubleTapped">
                      <DataGrid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Inspect this instance"
                                    Click="OnSpcInspectInstanceClicked"/>
                          <Separator/>
                          <MenuItem Header="Copy Class.Field"
                                    Click="OnSpcCopyClassFieldClicked"/>
                          <MenuItem Header="Copy instance address"
                                    Click="OnSpcCopyInstanceAddressClicked"/>
                          <MenuItem Header="Copy value sequence"
                                    Click="OnSpcCopyValueSequenceClicked"/>
                        </ContextMenu>
                      </DataGrid.ContextMenu>
                      <!-- Auto (not star) widths so the grid's total can exceed
                           the pane and scroll horizontally; long class FQNs /
                           the N-snapshot value sequence overflow instead of
                           clamping every column to the viewport. MaxWidth caps
                           each so one long row can't blow the grid out. -->
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Class"
                                            Binding="{Binding ClassFqn}"
                                            Width="Auto" MinWidth="240" MaxWidth="600"/>
                        <DataGridTextColumn Header="Field"
                                            Binding="{Binding FieldName}"
                                            Width="Auto" MinWidth="160" MaxWidth="400"/>
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding FieldType}"
                                            Width="Auto" MinWidth="160" MaxWidth="400"/>
                        <DataGridTextColumn Header="Instance"
                                            Binding="{Binding InstanceAddress}"
                                            Width="160"/>
                        <DataGridTextColumn Header="Values (per snap →)"
                                            Binding="{Binding ValueDisplays, Converter={x:Static converters:SpcValueSequenceConverter.Instance}}"
                                            Width="Auto" MinWidth="240" MaxWidth="1200"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Border>
              </Grid>
            </DockPanel>

            <!-- Group mode: N-snapshot, per-slot predicate chain, distinct-field SDR -->
            <DockPanel Grid.Row="1" Margin="6" IsVisible="{Binding SpcQuery.IsGroupMode}">
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,4"
                      Background="#264080FF" CornerRadius="3"
                      IsVisible="{Binding SpcQuery.IsRunning}">
                <TextBlock Text="Working… computing in the background." FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1F808080" CornerRadius="3">
                <TextBlock Text="{Binding SpcQuery.StatusMessage}" TextWrapping="Wrap" FontSize="11"/>
              </Border>
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1FFF6060" CornerRadius="3"
                      IsVisible="{Binding SpcQuery.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding SpcQuery.ErrorMessage}" Foreground="#FF8060" TextWrapping="Wrap" FontSize="11"/>
              </Border>
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6" Background="#1F808080" CornerRadius="3">
                <StackPanel Spacing="4">
                  <TextBlock Text="Snapshots (tick to include, oldest → newest):" FontSize="11" Opacity="0.8"/>
                  <ItemsControl ItemsSource="{Binding SpcQuery.SelectionRows}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SpcSnapshotRow">
                        <CheckBox Margin="0,0,14,0"
                                  IsChecked="{Binding Include, Mode=TwoWay}"
                                  Content="{Binding Snapshot.DisplayName}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SpcQuery.GroupInputs}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SpcGroupSlotInput">
                    <Grid ColumnDefinitions="Auto,150,Auto,*,Auto,*,Auto,Auto" Margin="0,0,0,4">
                      <TextBlock Grid.Column="0" Text="Value:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <ComboBox Grid.Column="1" Width="150" Margin="0,0,8,0"
                                ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope, Mode=TwoWay}"/>
                      <ComboBox Grid.Column="2" Width="92" Margin="0,0,6,0"
                                ItemsSource="{Binding FirstKinds}" SelectedItem="{Binding FirstKind, Mode=TwoWay}"
                                ToolTip.Tip="Predicate for the FIRST (oldest) selected snapshot."/>
                      <TextBox Grid.Column="3" Margin="0,0,6,0" Text="{Binding Operand, Mode=TwoWay}"
                               IsVisible="{Binding RequiresOperand}" PlaceholderText="value"/>
                      <TextBlock Grid.Column="4" Text="to" VerticalAlignment="Center" Margin="0,0,6,0"
                                 IsVisible="{Binding RequiresOperand2}"/>
                      <TextBox Grid.Column="5" Margin="0,0,8,0" Text="{Binding Operand2, Mode=TwoWay}"
                               IsVisible="{Binding RequiresOperand2}" PlaceholderText="upper bound"/>
                      <TextBlock Grid.Column="6" Text="then each:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <ComboBox Grid.Column="7" Width="112"
                                ItemsSource="{Binding RestKinds}" SelectedItem="{Binding RestKind, Mode=TwoWay}"
                                ToolTip.Tip="Predicate applied to every snapshot AFTER the first (Unchanged = held, Increased = kept rising, …)."/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                <Button Content="＋ Add value" Command="{Binding SpcQuery.AddGroupSlotCommand}"/>
                <Button Content="－ Remove"   Command="{Binding SpcQuery.RemoveGroupSlotCommand}"/>
                <Border Width="1" Background="#40808080" Margin="6,2"/>
                <Button Content="Run group" Command="{Binding SpcQuery.RunGroupCommand}" MinWidth="100"/>
                <CheckBox Content="Ignore system assemblies"
                          IsChecked="{Binding SpcQuery.IgnoreSystemAssembliesGroup, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
              </StackPanel>
              <DataGrid ItemsSource="{Binding SpcQuery.GroupResults}"
                        SelectedItem="{Binding SpcQuery.SelectedGroupRow, Mode=TwoWay}"
                        AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                        CanUserResizeColumns="True" CanUserSortColumns="True"
                        RowDetailsVisibilityMode="VisibleWhenSelected"
                        Name="SpcGroupGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Class" Binding="{Binding ClassDisplay}" Width="260" MinWidth="120"/>
                  <DataGridTextColumn Header="Instance" Binding="{Binding InstanceAddr}" Width="180" MinWidth="120"
                                       FontFamily="Consolas,Menlo,monospace"/>
                  <DataGridTextColumn Header="Matched (each value → field=value)"
                                       Binding="{Binding Summary}" Width="540" MinWidth="240"/>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                  <DataTemplate x:DataType="vm:GroupCandidateRow">
                    <StackPanel Margin="20,4,4,8" Spacing="4">
                      <TextBlock Text="{Binding LockSummary}" FontWeight="Bold"
                                 Foreground="LimeGreen" IsVisible="{Binding AllLocked}"/>
                      <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GroupSlotMatchRow">
                            <Grid ColumnDefinitions="Auto,200,120,90,140,Auto" Margin="0,1">
                              <TextBlock Grid.Column="0" Text="{Binding SlotIndex, StringFormat='#{0}'}"
                                         Margin="0,0,10,0" Opacity="0.7"/>
                              <TextBlock Grid.Column="1" Text="{Binding FieldOrSlot}"/>
                              <TextBlock Grid.Column="2" Text="{Binding FieldType}" Opacity="0.7"/>
                              <TextBlock Grid.Column="3" Text="{Binding OffsetLabel}"
                                         FontFamily="Consolas,Menlo,monospace"/>
                              <TextBlock Grid.Column="4" Text="{Binding CurrentValue}"/>
                              <TextBlock Grid.Column="5" Text="{Binding LockLabel}" Opacity="0.7"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </DataGrid.RowDetailsTemplate>
              </DataGrid>
            </DockPanel>
            </Grid>
          </TabItem>

          <!-- Phase 29e-2 — Class Pivot tab. SPC asks "for every
               field, does its value sequence match these predicates?"
               Pivot asks the inverse — "for class C, group instances
               by a key field (e.g. _propertyID), and show how a value
               field (e.g. _value) trajects across N snaps for each
               key tuple". Works cross-session because keying is by
               field VALUE inside the instance, not by managed
               address (which drifts on every game launch). -->
          <TabItem Header="Class Pivot" IsVisible="{Binding ExperimentalEnabled}">
            <DockPanel Margin="6">
              <!-- Wave B — every mode lives behind a toolbar button that opens
                   a dialog (bound to the shared PivotViewModel). The tab body is
                   the busy bar + status banners + the Results grid, so results
                   get the whole height instead of being squeezed under stacked
                   panels. -->
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,4"
                      Background="#1F808080" CornerRadius="3">
                <WrapPanel Orientation="Horizontal">
                  <Button Content="🗂 Snapshots…" Click="OnPivotOpenSnapshotsClicked"
                          Margin="0,2,6,2" Padding="10,4"
                          ToolTip.Tip="Pick which captures to include in the pivot."/>
                  <Button Content="⚙ Pivot query…" Click="OnPivotOpenQueryClicked"
                          Margin="0,2,6,2" Padding="10,4"
                          ToolTip.Tip="The main action: class + key + value fields → Run. Results land in the grid below."/>
                  <Button Content="🎯 Find by value…" Click="OnPivotOpenFindByValueClicked"
                          Margin="0,2,6,2" Padding="10,4"
                          ToolTip.Tip="Know the value (money = 9410, or it dropped 750) but not the class? Locate the (class, field)."/>
                  <Button Content="🔎 Browse classes…" Click="OnPivotOpenBrowseClassesClicked"
                          Margin="0,2,6,2" Padding="10,4"
                          ToolTip.Tip="Score classes by stability and inspect their field shape to pick a pivot target."/>
                  <Button Content="🏅 Likely game-state…" Click="OnPivotOpenLikelyStateClicked"
                          Margin="0,2,6,2" Padding="10,4"
                          ToolTip.Tip="Rank classes that have a stable key + a drifting value (money / HP / exp)."/>
                  <Button Content="🔑 Pick key/value…" Click="OnPivotOpenPickFieldsClicked"
                          Margin="0,2,6,2" Padding="10,4"
                          ToolTip.Tip="Rank a class's fields by key suitability and add them to the query."/>
                  <Button Content="🧬 Array-element pivot…" Click="OnPivotOpenArrayClicked"
                          Margin="0,2,6,2" Padding="10,4"
                          ToolTip.Tip="Pivot the elements of a reference array by a field inside each element."/>
                </WrapPanel>
              </Border>
              <!-- Wave A — busy indicator. Engine compute now runs off the UI
                   thread (Task.Run), so this indeterminate bar actually animates
                   and the rest of the app stays responsive while a snapshot
                   query is running. Visible only while IsRunning. -->
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,4"
                      Background="#264080FF" CornerRadius="3"
                      IsVisible="{Binding ClassPivot.IsRunning}">
                <StackPanel Orientation="Vertical" Spacing="3">
                  <TextBlock Text="Working… computing in the background — the UI stays responsive."
                             FontSize="11" FontWeight="SemiBold"/>
                  <ProgressBar IsIndeterminate="True" Height="4" Minimum="0" Maximum="100"/>
                </StackPanel>
              </Border>
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1F808080" CornerRadius="3">
                <TextBlock Text="{Binding ClassPivot.StatusMessage}"
                           TextWrapping="Wrap" FontSize="11"/>
              </Border>
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#1FFF6060" CornerRadius="3"
                      IsVisible="{Binding ClassPivot.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ClassPivot.ErrorMessage}"
                           Foreground="#FF8060" TextWrapping="Wrap" FontSize="11"/>
              </Border>
              <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6,3"
                      Background="#264080FF" CornerRadius="3"
                      IsVisible="{Binding ClassPivot.ModeBanner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ClassPivot.ModeBanner}"
                           TextWrapping="Wrap" FontSize="11"/>
              </Border>

              <!-- Wave B — the Results grid is now the whole tab body (the
                   snapshot picker + all config panels moved into toolbar
                   dialogs above). -->
                <Border Padding="0"
                        Background="#1F808080" CornerRadius="3">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pivot results — configure via the toolbar above, then Run from “Pivot query…”"
                               FontWeight="SemiBold" Margin="6,4,6,4"/>
                    <!-- Collision + key columns are sortable via the
                         manual AOT-safe handler. Trajectory wraps + has a
                         tooltip (29e-2 polish), so it stays star-sized to
                         fill remaining width — no truncation to scroll
                         past. -->
                    <DataGrid Name="PivotResultsGrid"
                              ItemsSource="{Binding ClassPivot.Results}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              DoubleTapped="OnPivotResultDoubleTapped">
                      <DataGrid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Inspect (latest snap)"
                                    Click="OnPivotInspectInstanceClicked"/>
                          <Separator/>
                          <MenuItem Header="Copy key tuple"
                                    Click="OnPivotCopyKeyTupleClicked"/>
                          <MenuItem Header="Copy value sequence"
                                    Click="OnPivotCopyValueSequenceClicked"/>
                          <MenuItem Header="Copy instance address (latest)"
                                    Click="OnPivotCopyAddressLatestClicked"/>
                        </ContextMenu>
                      </DataGrid.ContextMenu>
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="⚠"
                                            Binding="{Binding CollisionMarker}"
                                            Width="32" SortMemberPath="HasCollision" CanUserSort="True"/>
                        <DataGridTextColumn Header="Key tuple"
                                            Binding="{Binding KeyTupleDisplay}"
                                            Width="Auto" MinWidth="180"
                                            SortMemberPath="KeyTupleDisplay" CanUserSort="True"/>
                        <!-- Single Trajectory column — pre-rendered by
                             PivotViewModel as "fieldName: v0 → v1 → …"
                             (multi-line when >1 value field).
                             AOT-safe — no reflection bindings.
                             TextWrapping + ToolTip so wide rows
                             (many snaps) and collision cells
                             (⟨N: …⟩) are fully readable rather than
                             clipped at the cell edge. SPC tab uses the
                             same value-sequence shape. -->
                        <DataGridTemplateColumn Header="Trajectory (per snap →)" Width="5*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding TrajectoryDisplay}"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center"
                                         Margin="2"
                                         ToolTip.Tip="{Binding TrajectoryDisplay}"/>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Border>
            </DockPanel>
          </TabItem>

          <!-- Teleport tab (wave 1). Gated on experimental until live-verified.
               Target is user-picked: paste a managed instance address (copied
               from Inspector / Address Lookup / Scene) since Unity has no
               universal player chain. -->
          <TabItem Header="Teleport" IsVisible="{Binding ExperimentalEnabled}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
              <StackPanel Loaded="OnTeleportContentLoaded" Margin="12" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">

                <TextBlock Text="Single-player only. Online games will rubber-band or may flag teleports."
                           FontStyle="Italic" Opacity="0.7" TextWrapping="Wrap"/>

                <!-- Target -->
                <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Target" FontWeight="Bold"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="Auto-detect scans the camera chain, the 'Player' tag, CharacterControllers, common object names and player-ish game classes, then ranks the candidates. Best guess lands on top — click Use, then verify with Refresh while moving in-game."/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Auto-detect" Command="{Binding Teleport.AutoDetectCommand}"
                              IsEnabled="{Binding !Teleport.AutoDetecting}"/>
                      <Button Content="Detect by movement" Command="{Binding Teleport.DetectByMovementCommand}"
                              IsEnabled="{Binding !Teleport.MovementDetecting}"
                              ToolTip.Tip="Samples every scene object's position while you move your character, then ranks by how far each moved. Works when names/tags don't."/>
                      <TextBlock Text="for" VerticalAlignment="Center" Opacity="0.7"/>
                      <TextBox Width="48" Text="{Binding Teleport.MovementSampleSeconds}"
                               VerticalAlignment="Center"
                               ToolTip.Tip="Seconds to keep sampling while you move (2–20)."/>
                      <TextBlock Text="s" VerticalAlignment="Center" Opacity="0.7"/>
                      <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center"
                                   IsVisible="{Binding Teleport.AutoDetecting}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Teleport.MovementStatus}" TextWrapping="Wrap"
                               FontWeight="Bold" Foreground="#E0A030"
                               IsVisible="{Binding Teleport.MovementDetecting}"/>
                    <ItemsControl ItemsSource="{Binding Teleport.AutoDetectCandidates}"
                                  IsVisible="{Binding Teleport.HasAutoDetectResults}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlayerCandidateRowViewModel">
                          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                            <TextBlock Text="{Binding Score}" Width="40" VerticalAlignment="Center"
                                       FontWeight="Bold" TextAlignment="Right"/>
                            <TextBlock Text="{Binding Confidence}" Width="56" VerticalAlignment="Center"
                                       Opacity="0.85" ToolTip.Tip="Confidence this is the player. Low usually means a camera rig."/>
                            <TextBlock Text="{Binding Name}" Width="150" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding TransformAddress}"/>
                            <TextBlock Text="{Binding Distance}" Width="80" VerticalAlignment="Center"
                                       Opacity="0.8"/>
                            <TextBlock Text="{Binding Sources}" Width="210" VerticalAlignment="Center"
                                       Opacity="0.8" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Sources}"/>
                            <Button Content="Use" Command="{Binding UseCommand}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="Or paste the player's managed instance address (copy it from Inspector / Address Lookup / Scene). Tick 'GameObject' if the address is a GameObject rather than a MonoBehaviour/Component."/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBox Width="240" PlaceholderText="0x..."
                               Text="{Binding Teleport.TargetAddressInput}"
                               FontFamily="Consolas,Cascadia Mono,monospace"/>
                      <CheckBox Content="GameObject" IsChecked="{Binding Teleport.TargetIsGameObject}"
                                VerticalAlignment="Center"/>
                      <Button Content="Set Target" Command="{Binding Teleport.SetTargetCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Actions (disabled until a target is resolved) -->
                <StackPanel Spacing="12" IsEnabled="{Binding Teleport.HasTarget}">

                  <!-- Live pose -->
                  <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Current pose" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="Refresh" Command="{Binding Teleport.RefreshCommand}"/>
                        <Button Content="Copy coords" Command="{Binding Teleport.CopyCoordsCommand}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Position:" Width="64"/>
                        <TextBlock Text="{Binding Teleport.PositionText}"
                                   FontFamily="Consolas,Cascadia Mono,monospace"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Rotation:" Width="64"/>
                        <TextBlock Text="{Binding Teleport.RotationText}"
                                   FontFamily="Consolas,Cascadia Mono,monospace"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Teleport.DriverText}" Opacity="0.7" TextWrapping="Wrap"
                                 IsVisible="{Binding Teleport.DriverText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                  </Border>

                  <!-- Markers -->
                  <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Markers" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="Undo last jump" Command="{Binding Teleport.UndoCommand}"
                                IsEnabled="{Binding Teleport.HasUndo}"/>
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Teleport.MarkerRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TeleportMarkerRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                              <TextBlock Text="{Binding SlotLabel}" Width="56" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Display}" Width="260" VerticalAlignment="Center"
                                         FontFamily="Consolas,Cascadia Mono,monospace"/>
                              <Button Content="Save"   Command="{Binding SaveCommand}"/>
                              <Button Content="Recall" Command="{Binding RecallCommand}"
                                      IsEnabled="{Binding HasMarker}"/>
                              <Button Content="Clear"  Command="{Binding ClearCommand}"
                                      IsEnabled="{Binding HasMarker}"/>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <!-- Explicit coordinates -->
                  <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Teleport to coordinates" FontWeight="Bold"/>
                      <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                 Text="Enter 3 numbers (x y z) or 6 (x y z + rotation). Accepts (1, 2, 3) and pasted 'Copy coords' output."/>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="320" PlaceholderText="x y z"
                                 Text="{Binding Teleport.CoordinateInput}"
                                 FontFamily="Consolas,Cascadia Mono,monospace"/>
                        <Button Content="Teleport" Command="{Binding Teleport.TeleportToCoordsCommand}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- Directional -->
                  <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Directional teleport" FontWeight="Bold"/>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Distance:" VerticalAlignment="Center"/>
                        <TextBox Width="90" Text="{Binding Teleport.DirectionalDistance}"/>
                        <CheckBox Content="Horizontal (ground plane)"
                                  IsChecked="{Binding Teleport.DirectionalHorizontal}"
                                  VerticalAlignment="Center"/>
                        <Button Content="Forward" Command="{Binding Teleport.TeleportForwardCommand}"/>
                        <Button Content="Back"    Command="{Binding Teleport.TeleportBackwardCommand}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Global hotkeys (independent of target — enable any time) -->
                <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="10">
                  <StackPanel Spacing="6">
                    <CheckBox Content="Enable global hotkeys (fire while the game window is focused)"
                              IsChecked="{Binding Teleport.GlobalHotkeysEnabled}"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Text="Click Set, then press the key combo (e.g. Ctrl+F5). Prefer a modifier + F-key — a bare key is captured system-wide. Defaults use the numpad and need NumLock ON."/>
                    <ItemsControl ItemsSource="{Binding Teleport.HotkeyRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeleportHotkeyRow">
                          <Grid ColumnDefinitions="150,130,Auto,Auto" Margin="0,2" ToolTip.Tip="{Binding Hint}">
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Margin="0,0,8,0" Padding="6,2"
                                    Background="#20808080" CornerRadius="3" VerticalAlignment="Center">
                              <TextBlock Text="{Binding DisplayLabel}"
                                         FontFamily="Consolas,Cascadia Mono,monospace"/>
                            </Border>
                            <Button Grid.Column="2" Content="{Binding CaptureButtonText}" Width="64"
                                    Command="{Binding BeginCaptureCommand}"/>
                            <Button Grid.Column="3" Content="Clear" Margin="4,0,0,0"
                                    Command="{Binding ClearCommand}" IsEnabled="{Binding HasBinding}"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Teleport.HotkeyStatus}" TextWrapping="Wrap" Opacity="0.75"/>
                  </StackPanel>
                </Border>

                <!-- Keep-foreground: native run-in-background Win32 hook. Works
                     even when IL2CPP strips Application.runInBackground, and
                     while the game thread is idle. -->
                <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="10">
                  <StackPanel Spacing="6">
                    <CheckBox Content="Keep the game running when unfocused (native hook)"
                              IsChecked="{Binding Teleport.KeepForegroundEnabled}"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Text="Hooks GetForegroundWindow / window activation / cursor confinement so the game keeps ticking (and the mouse is freed) while another window is focused. Native — works even when IL2CPP strips Application.runInBackground. Clears when the game restarts."/>
                    <TextBlock Text="{Binding Teleport.KeepForegroundStatus}" TextWrapping="Wrap" Opacity="0.75"/>
                  </StackPanel>
                </Border>

                <!-- World tweaks: universal speed (Time.timeScale) + gravity
                     (Physics.gravity). Both are static engine setters reached via
                     the same callMethod primitive as teleport → no per-game target. -->
                <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="World tweaks (universal — no target needed)" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="Auto,110,Auto,Auto,Auto,Auto,Auto,Auto">
                      <TextBlock Grid.Column="0" Text="Speed ×" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding Teleport.TimeScaleInput, Mode=TwoWay}"
                                     Minimum="0" Maximum="100" Increment="0.25" FormatString="0.###"/>
                      <Button Grid.Column="2" Content="Apply"  Margin="8,0,0,0" Command="{Binding Teleport.ApplyTimeScaleCommand}"/>
                      <Button Grid.Column="3" Content="1×"     Margin="4,0,0,0" Command="{Binding Teleport.ResetTimeScaleCommand}"/>
                      <Button Grid.Column="4" Content="0.25×"  Margin="4,0,0,0" Command="{Binding Teleport.ApplyTimeScalePresetCommand}" CommandParameter="0.25"/>
                      <Button Grid.Column="5" Content="0.5×"   Margin="4,0,0,0" Command="{Binding Teleport.ApplyTimeScalePresetCommand}" CommandParameter="0.5"/>
                      <Button Grid.Column="6" Content="2×"     Margin="4,0,0,0" Command="{Binding Teleport.ApplyTimeScalePresetCommand}" CommandParameter="2"/>
                      <Button Grid.Column="7" Content="4×"     Margin="4,0,0,0" Command="{Binding Teleport.ApplyTimeScalePresetCommand}" CommandParameter="4"/>
                    </Grid>
                    <TextBlock Text="{Binding Teleport.TimeScaleStatus}" TextWrapping="Wrap" Opacity="0.75"/>

                    <Grid ColumnDefinitions="Auto,110,Auto,Auto,Auto,Auto">
                      <TextBlock Grid.Column="0" Text="Gravity ×" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding Teleport.GravityScaleInput, Mode=TwoWay}"
                                     Minimum="0" Maximum="20" Increment="0.25" FormatString="0.###"/>
                      <Button Grid.Column="2" Content="Apply"      Margin="8,0,0,0" Command="{Binding Teleport.ApplyGravityCommand}"/>
                      <Button Grid.Column="3" Content="1×"         Margin="4,0,0,0" Command="{Binding Teleport.ResetGravityCommand}"/>
                      <Button Grid.Column="4" Content="Moon 0.16×" Margin="4,0,0,0" Command="{Binding Teleport.ApplyGravityPresetCommand}" CommandParameter="0.16"/>
                      <Button Grid.Column="5" Content="Zero-G"     Margin="4,0,0,0" Command="{Binding Teleport.ApplyGravityPresetCommand}" CommandParameter="0"/>
                    </Grid>
                    <TextBlock Text="{Binding Teleport.GravityStatus}" TextWrapping="Wrap" Opacity="0.75"/>

                    <TextBlock TextWrapping="Wrap" Opacity="0.6"
                               Text="Speed drives UnityEngine.Time.timeScale (0 = pause, slider is a multiplier). Gravity scales the captured Physics.gravity (0 = zero-G, &lt;1 = low-gravity). Both are engine globals — they need no target and reset when the game restarts."/>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding Teleport.StatusMessage}" TextWrapping="Wrap" Opacity="0.85"/>

              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
