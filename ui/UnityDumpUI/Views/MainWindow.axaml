<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnityDumpUI.ViewModels"
        xmlns:controls="using:UnityDumpUI.Controls"
        x:Class="UnityDumpUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="780"
        Icon="avares://DiscreteUI/Assets/MainIcon.ico"
        Title="{StaticResource App.Title}">
  <!-- Five-pane shell:
         Assemblies | Classes | Fields/Methods detail (with handshake summary on top)
       Each list has its own filter; the right pane is driven by the
       AssemblyBrowserViewModel selection cascade. -->
  <DockPanel LastChildFill="True">

    <!-- Top connection bar -->
    <Border DockPanel.Dock="Top"
            BorderBrush="#22000000" BorderThickness="0,0,0,1"
            Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="{StaticResource Conn.Inject}"
                Command="{Binding InjectAndConnectCommand}" />
        <Button Content="{StaticResource Conn.Connect}"
                Command="{Binding ConnectCommand}" />
        <Button Content="{StaticResource Conn.Disconnect}"
                Command="{Binding DisconnectCommand}" />

        <!-- Phase 12c (v2): proxy deploy is a dedicated multi-select panel.
             Click opens ProxyDeployWindow non-modally so the user can keep
             it open while connecting / browsing in this window. -->
        <Button Content="{StaticResource Conn.ProxyDeploy}"
                Command="{Binding OpenProxyDeployCommand}" />

        <!-- Phase 22d: Tools menu. Currently houses one entry (Inject
             Discrete Bridge); future entries (Phase 22e per-feature
             "Send to CE Table" actions) will join here. The button
             stays clickable even when AOBMaker isn't reachable; the
             menu item itself surfaces the plugin-not-connected case
             via BridgeInjectStatus rather than greying out the menu
             (avoids a chicken-and-egg "open CE first to enable the
             menu, but the menu is what asks you to open CE" loop). -->
        <Button Content="{StaticResource Conn.ToolsMenu}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{StaticResource Tools.InjectDiscreteBridge}"
                        Command="{Binding InjectDiscreteBridgeCommand}"
                        ToolTip.Tip="{StaticResource Tools.InjectDiscreteBridgeTooltip}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <TextBlock Text="{StaticResource Conn.StatusLabel}"
                   VerticalAlignment="Center"
                   Opacity="0.7" />
        <TextBlock Text="{Binding ConnectionStatus}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold" />
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}"
                     Width="120" Height="6"
                     VerticalAlignment="Center" />

        <!-- Phase 22d: AOBMaker pipe availability indicator. Subtle
             dot + label so the user can tell "Tools menu actions will
             reach CE" at a glance without clicking the menu first.
             Updated on every successful/failed AOBMaker request +
             the opportunistic startup probe. -->
        <StackPanel Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="{StaticResource Tools.AobMakerStatusLabel}"
                     Opacity="0.7" />
          <TextBlock Text="{StaticResource Tools.AobMakerConnected}"
                     Foreground="#FF35A744"
                     FontWeight="SemiBold"
                     IsVisible="{Binding IsAobMakerAvailable}" />
          <TextBlock Text="{StaticResource Tools.AobMakerNotConnected}"
                     Opacity="0.55"
                     IsVisible="{Binding !IsAobMakerAvailable}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Phase 22d: bridge inject status line. Appears only after the
         user has clicked Tools→Inject Discrete Bridge once this
         session. Stays put after success/failure so the user can read
         the outcome without timing pressure. Distinct from the
         connection bar's ConnectionStatus (DLL pipe lifecycle) — the
         bridge inject is a separate concern. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding BridgeInjectStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="#1135A744" BorderBrush="#5535A744"
            BorderThickness="0,0,0,1" Padding="12,4">
      <TextBlock Text="{Binding BridgeInjectStatus}"
                 Foreground="#FF35A744" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
    </Border>

    <!-- Phase 14b: stripped/obfuscated metadata warning. Yellow strip
         appears below the connection bar when getMetadataStats reports
         partial_strip / heavy_strip; cleared on disconnect. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasStripWarning}"
            Background="#33D4A017" BorderBrush="#88D4A017"
            BorderThickness="0,0,0,1" Padding="12,6">
      <TextBlock Text="{Binding MetadataWarning}"
                 Foreground="#FFD4A017" TextWrapping="Wrap"
                 FontWeight="SemiBold" />
    </Border>

    <!-- Body -->
    <Grid x:Name="BodyGrid">
      <!-- Column widths are user-resizable via the GridSplitters between
           panes. MinWidth keeps each pane usable; "*" lets the right pane
           absorb whatever's left. -->
      <!-- Column widths get rewritten by MainWindow code-behind on
           IsAssembliesPaneCollapsed / IsClassesPaneCollapsed toggle so
           the user can reclaim the space for the Inspector / Detail pane.
           Initial widths match the historical layout. The code-behind
           reaches each ColumnDefinition by index (0=Assemblies,
           2=Classes) — Avalonia's compiled XAML rejects x:Name on
           ColumnDefinition under Native AOT (it's not a Control with a
           NameScope), hence the index-based access. -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="28" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="280" MinWidth="28" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*"   MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- Pane 1: Assemblies -->
      <DockPanel Grid.Column="0" Margin="8">
        <!-- Header row: title + collapse toggle. The chevron flips between
             ◀ (collapse) and ▶ (expand). Title text is replaced with a
             vertical "A" mnemonic when collapsed so the rail still
             communicates "this is the Assemblies pane". -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock Grid.Column="0"
                     Text="{StaticResource Browser.AssembliesTitle}"
                     FontWeight="SemiBold"
                     IsVisible="{Binding !IsAssembliesPaneCollapsed}" />
          <TextBlock Grid.Column="0"
                     Text="A" FontWeight="Bold" Opacity="0.6"
                     HorizontalAlignment="Center"
                     IsVisible="{Binding IsAssembliesPaneCollapsed}" />
          <Button    Grid.Column="1"
                     Content="◀" FontSize="10" Padding="4,0" MinHeight="20"
                     Command="{Binding ToggleAssembliesPaneCommand}"
                     ToolTip.Tip="{StaticResource Browser.CollapsePaneTooltip}"
                     IsVisible="{Binding !IsAssembliesPaneCollapsed}" />
          <Button    Grid.Column="1"
                     Content="▶" FontSize="10" Padding="4,0" MinHeight="20"
                     Command="{Binding ToggleAssembliesPaneCommand}"
                     ToolTip.Tip="{StaticResource Browser.ExpandPaneTooltip}"
                     IsVisible="{Binding IsAssembliesPaneCollapsed}" />
        </Grid>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4"
              IsVisible="{Binding !IsAssembliesPaneCollapsed}">
          <TextBox x:Name="AssemblyFilterBox"
                   Grid.Column="0"
                   PlaceholderText="{StaticResource Browser.FilterWatermark}"
                   Text="{Binding Browser.AssemblyFilter, Mode=TwoWay}" />
          <Button  Grid.Column="1"
                   Content="{StaticResource Browser.Refresh}"
                   Margin="6,0,0,0"
                   Command="{Binding Browser.RefreshAssembliesCommand}" />
        </Grid>
        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding Browser.IsLoadingAssemblies}"
                     Height="3" Margin="0,0,0,4" />
        <ListBox ItemsSource="{Binding Browser.FilteredAssemblies}"
                 SelectedItem="{Binding Browser.SelectedAssembly, Mode=TwoWay}"
                 IsVisible="{Binding !IsAssembliesPaneCollapsed}"
                 x:DataType="vm:MainWindowViewModel">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AssemblyItem">
              <controls:HighlightedTextBlock SourceText="{Binding Name}"
                                             Highlight="{Binding #AssemblyFilterBox.Text}"
                                             TextTrimming="CharacterEllipsis"
                                             ToolTip.Tip="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4"
                    Background="#22000000"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Columns"
                    IsVisible="{Binding !IsAssembliesPaneCollapsed}" />

      <!-- Pane 2: Classes -->
      <DockPanel Grid.Column="2" Margin="8">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock Grid.Column="0"
                     Text="{StaticResource Browser.ClassesTitle}"
                     FontWeight="SemiBold"
                     IsVisible="{Binding !IsClassesPaneCollapsed}" />
          <TextBlock Grid.Column="0"
                     Text="C" FontWeight="Bold" Opacity="0.6"
                     HorizontalAlignment="Center"
                     IsVisible="{Binding IsClassesPaneCollapsed}" />
          <Button    Grid.Column="1"
                     Content="◀" FontSize="10" Padding="4,0" MinHeight="20"
                     Command="{Binding ToggleClassesPaneCommand}"
                     ToolTip.Tip="{StaticResource Browser.CollapsePaneTooltip}"
                     IsVisible="{Binding !IsClassesPaneCollapsed}" />
          <Button    Grid.Column="1"
                     Content="▶" FontSize="10" Padding="4,0" MinHeight="20"
                     Command="{Binding ToggleClassesPaneCommand}"
                     ToolTip.Tip="{StaticResource Browser.ExpandPaneTooltip}"
                     IsVisible="{Binding IsClassesPaneCollapsed}" />
        </Grid>
        <TextBox x:Name="ClassFilterBox"
                 DockPanel.Dock="Top"
                 PlaceholderText="{StaticResource Browser.FilterWatermark}"
                 Text="{Binding Browser.ClassFilter, Mode=TwoWay}"
                 IsVisible="{Binding !IsClassesPaneCollapsed}"
                 Margin="0,0,0,4" />
        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding Browser.IsLoadingClasses}"
                     Height="3" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding Browser.FilteredClasses.Count, StringFormat='\{0\} classes'}"
                   IsVisible="{Binding !IsClassesPaneCollapsed}"
                   Opacity="0.6" FontSize="11" Margin="0,4,0,0" />
        <ListBox ItemsSource="{Binding Browser.FilteredClasses}"
                 SelectedItem="{Binding Browser.SelectedClass, Mode=TwoWay}"
                 IsVisible="{Binding !IsClassesPaneCollapsed}"
                 x:DataType="vm:MainWindowViewModel">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{StaticResource Browser.InspectMenuItem}"
                        Command="{Binding InspectSelectedClassCommand}" />
              <MenuItem Header="{StaticResource Browser.CopyClassNameMenu}"
                        Click="OnCopyClassNameClicked" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ClassItem">
              <StackPanel ToolTip.Tip="{Binding DisplayName}">
                <controls:HighlightedTextBlock SourceText="{Binding Name}"
                                               Highlight="{Binding #ClassFilterBox.Text}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                <controls:HighlightedTextBlock SourceText="{Binding Namespace}"
                                               Highlight="{Binding #ClassFilterBox.Text}"
                                               Opacity="0.55" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="3" Width="4"
                    Background="#22000000"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Columns"
                    IsVisible="{Binding !IsClassesPaneCollapsed}" />

      <!-- Pane 3: Detail (handshake summary on top, then fields/methods) -->
      <DockPanel Grid.Column="4" Margin="8">

        <!-- Handshake summary (collapsible) -->
        <Expander DockPanel.Dock="Top"
                  Header="{StaticResource Handshake.Title}"
                  IsExpanded="False"
                  Margin="0,0,0,8">
          <Grid ColumnDefinitions="160,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                RowSpacing="4" Margin="4,4,0,4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource Handshake.Engine}"          Opacity="0.7" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Engine}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource Handshake.Backend}"         Opacity="0.7" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Backend2}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource Handshake.DllVariant}"      Opacity="0.7" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DllVariant}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{StaticResource Handshake.GameModule}"      Opacity="0.7" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GameModule}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{StaticResource Handshake.UnityVersion}"    Opacity="0.7" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UnityVersion}" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="{StaticResource Handshake.MetadataVersion}" Opacity="0.7" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MetadataVersion}" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="{StaticResource Handshake.AssembliesCount}" Opacity="0.7" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AssembliesCount}" />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="{StaticResource Handshake.Build}"           Opacity="0.7" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Build}" />
            <TextBlock Grid.Row="8" Grid.Column="0" Text="{StaticResource Handshake.Protocol}"        Opacity="0.7" />
            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Protocol}" />
          </Grid>
        </Expander>

        <!-- Top errors banner -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#33D32F2F" BorderBrush="#88D32F2F"
                BorderThickness="1" CornerRadius="4" Padding="10,6"
                Margin="0,0,0,8">
          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="#FFD32F2F"
                     TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top"
                IsVisible="{Binding Browser.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#33D32F2F" BorderBrush="#88D32F2F"
                BorderThickness="1" CornerRadius="4" Padding="10,6"
                Margin="0,0,0,8">
          <TextBlock Text="{Binding Browser.ErrorMessage}"
                     Foreground="#FFD32F2F"
                     TextWrapping="Wrap" />
        </Border>

        <!-- Class detail header -->
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
          <TextBlock Text="{Binding Browser.SelectedClass.DisplayName, FallbackValue='—'}"
                     FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Browser.ParentChain}"
                     Opacity="0.6" FontSize="11"
                     IsVisible="{Binding Browser.ShowInherited}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    Spacing="8" Margin="0,0,0,6">
          <CheckBox Content="{StaticResource Browser.ShowInherited}"
                    IsChecked="{Binding Browser.ShowInherited, Mode=TwoWay}" />
          <Button Content="{StaticResource Browser.ExportSdkHeader}"
                  Command="{Binding Browser.ExportSdkHeaderCommand}" />
          <Button Content="{StaticResource Browser.ExportCsx}"
                  Command="{Binding Browser.ExportCsxCommand}" />
          <Button Content="{StaticResource Browser.ExportCeXml}"
                  Command="{Binding Browser.ExportCeXmlCommand}" />
          <Button Content="{StaticResource Browser.CopyCeXml}"
                  Command="{Binding Browser.CopyCeXmlCommand}" />
          <Button Content="{StaticResource Browser.ExportOptions}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Margin="6" Spacing="6">
                  <Grid ColumnDefinitions="200,160" RowDefinitions="Auto,Auto"
                        RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{StaticResource Browser.OptDrilldownDepth}"
                               VerticalAlignment="Center" Opacity="0.8" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                   Value="{Binding Browser.DrilldownDepth, Mode=TwoWay}"
                                   Minimum="0" Maximum="5" Increment="1" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{StaticResource Browser.OptArrayLimit}"
                               VerticalAlignment="Center" Opacity="0.8" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Value="{Binding Browser.ArrayLimit, Mode=TwoWay}"
                                   Minimum="0" Maximum="256" Increment="8" />
                  </Grid>

                  <CheckBox Content="{StaticResource Browser.OptCollapse}"
                            IsChecked="{Binding Browser.CollapsePointerNodes, Mode=TwoWay}" />
                  <CheckBox Content="{StaticResource Browser.OptUseLiveData}"
                            IsChecked="{Binding Browser.UseLiveData, Mode=TwoWay}" />

                  <Grid ColumnDefinitions="200,160">
                    <TextBlock Grid.Column="0"
                               Text="{StaticResource Browser.OptCeXmlBase}"
                               VerticalAlignment="Center" Opacity="0.8" />
                    <TextBox  Grid.Column="1"
                              Text="{Binding Browser.CeXmlBaseAddress, Mode=TwoWay}"
                              FontFamily="Consolas,Cascadia Mono,monospace" />
                  </Grid>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <ProgressBar IsIndeterminate="True"
                       IsVisible="{Binding Browser.IsLoadingDetail}"
                       Width="120" Height="4"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Tabs: Fields / Inspector / Methods / Address Lookup. SelectedIndex
             is bound to the VM so cross-tab handoffs (Inspector right-click
             → Address Lookup, Address Lookup → Inspector) can switch tabs
             from the VM layer. -->
        <TabControl SelectedIndex="{Binding SelectedDetailTabIndex, Mode=TwoWay}">
          <TabItem Header="{StaticResource Browser.FieldsTab}">
            <DockPanel>
              <!-- Filter is UI-only — exports + Copy CE field operate on
                   the unfiltered Fields collection. Matches name OR type
                   (case-insensitive substring) so a search like "vector"
                   surfaces every Vector3 field across the inheritance chain. -->
              <TextBox x:Name="FieldFilterBox"
                       DockPanel.Dock="Top"
                       PlaceholderText="{StaticResource Browser.FilterFieldsWatermark}"
                       Text="{Binding Browser.FieldFilter, Mode=TwoWay}"
                       Margin="0,0,0,4" />
              <DataGrid x:Name="BrowserFieldsDataGrid"
                        ItemsSource="{Binding Browser.FilteredFields}"
                        SelectedItem="{Binding Browser.SelectedFieldRow, Mode=TwoWay}"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="True"
                        CanUserReorderColumns="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="Horizontal"
                        x:DataType="vm:MainWindowViewModel">
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{StaticResource Browser.CopyCeField}"
                              Command="{Binding Browser.CopyCeFieldCommand}" />
                    <Separator />
                    <!-- Per-cell clipboard helpers. Single-select only;
                         multi-select copy is a follow-up (would need to
                         join row values with newline + handle mixed
                         columns). Handlers live in MainWindow.axaml.cs. -->
                    <MenuItem Header="{StaticResource Browser.CopyFieldNameMenu}"
                              Click="OnCopyFieldNameClicked" />
                    <MenuItem Header="{StaticResource Browser.CopyFieldTypeMenu}"
                              Click="OnCopyFieldTypeClicked" />
                    <MenuItem Header="{StaticResource Browser.CopyFieldDeclaredInMenu}"
                              Click="OnCopyFieldDeclaredInClicked" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{StaticResource Browser.ColName}"
                                          Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:FieldRow">
                        <controls:HighlightedTextBlock SourceText="{Binding Name}"
                                                       Highlight="{Binding #FieldFilterBox.Text}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="4,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{StaticResource Browser.ColOffset}" Width="80"
                                      Binding="{Binding OffsetHex, x:DataType=vm:FieldRow}"
                                      SortMemberPath="Offset" />
                  <DataGridTemplateColumn Header="{StaticResource Browser.ColType}"
                                          Width="*" SortMemberPath="Type">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:FieldRow">
                        <controls:HighlightedTextBlock SourceText="{Binding Type}"
                                                       Highlight="{Binding #FieldFilterBox.Text}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="4,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{StaticResource Browser.ColFlags}"  Width="80"
                                      Binding="{Binding FlagsHex, x:DataType=vm:FieldRow}" />
                  <DataGridCheckBoxColumn Header="{StaticResource Browser.ColStatic}" Width="60"
                                          Binding="{Binding IsStatic, x:DataType=vm:FieldRow}" />
                  <DataGridTextColumn Header="{StaticResource Browser.ColDeclaredIn}" Width="160"
                                      Binding="{Binding DeclaredIn, x:DataType=vm:FieldRow}" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="{StaticResource Inspector.Tab}">
            <DockPanel Margin="0,4,0,0">

              <!-- Inspector toolbar -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="8" Margin="0,0,0,6">
                <Button Content="{StaticResource Inspector.SetTarget}"
                        Command="{Binding InspectSelectedClassCommand}" />
                <Button Content="{StaticResource Inspector.Find}"
                        Command="{Binding FindInspectorInstancesCommand}" />
                <Button Content="{StaticResource Inspector.RefreshWalk}"
                        Command="{Binding Inspector.RefreshWalkCommand}" />
                <Button Content="{StaticResource Inspector.Clear}"
                        Command="{Binding Inspector.ClearCommand}" />
                <TextBlock Text="{StaticResource Inspector.LimitLabel}"
                           VerticalAlignment="Center" Opacity="0.7" Margin="8,0,0,0" />
                <NumericUpDown Value="{Binding Inspector.InstanceLimit, Mode=TwoWay}"
                               Minimum="1" Maximum="4096" Increment="64"
                               Width="110" />
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding Inspector.IsLoadingInstances}"
                             Width="80" Height="4" VerticalAlignment="Center" />
              </StackPanel>

              <!-- Auto-refresh row -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="6" Margin="0,0,0,6">
                <TextBlock Text="{StaticResource Inspector.AutoRefreshLabel}"
                           VerticalAlignment="Center" Opacity="0.7" />
                <Button Content="{StaticResource Inspector.AutoRefreshOff}"
                        Command="{Binding Inspector.AutoRefreshOffCommand}" />
                <Button Content="{StaticResource Inspector.AutoRefresh250}"
                        Command="{Binding Inspector.AutoRefreshFastCommand}" />
                <Button Content="{StaticResource Inspector.AutoRefresh1000}"
                        Command="{Binding Inspector.AutoRefreshSlowCommand}" />
                <TextBlock Text="{Binding Inspector.AutoRefreshIntervalMs, StringFormat='= \{0\} ms'}"
                           VerticalAlignment="Center" Opacity="0.6"
                           Margin="6,0,0,0" />
              </StackPanel>

              <!-- Target / status header -->
              <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,6">
                <TextBlock Text="{Binding Inspector.TargetLabel}"
                           FontWeight="SemiBold"
                           IsVisible="{Binding Inspector.HasTarget}" />
                <TextBlock Text="{StaticResource Inspector.NoTarget}"
                           Opacity="0.6"
                           IsVisible="{Binding !Inspector.HasTarget}" />
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding Inspector.ClassPointer, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{StaticResource Inspector.ClassPointerLabel}"
                             Opacity="0.7"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Inspector.ClassPointer}"
                             FontFamily="Consolas,Cascadia Mono,monospace"
                             VerticalAlignment="Center" />
                  <!-- Small icon-style copy buttons. Same shape as the
                       walked-field row actions (addr / ptr / name / HEX) so
                       Inspector stays visually consistent. -->
                  <Button Content="name" FontSize="10" Padding="4,0" MinHeight="20"
                          Command="{Binding Inspector.CopyClassNameCommand}"
                          ToolTip.Tip="{StaticResource Inspector.CopyClassNameTooltip}" />
                  <Button Content="addr" FontSize="10" Padding="4,0" MinHeight="20"
                          Command="{Binding Inspector.CopyClassAddressCommand}"
                          ToolTip.Tip="{StaticResource Inspector.CopyClassAddressTooltip}" />
                </StackPanel>
                <TextBlock Text="{Binding Inspector.WalkSummary}"
                           Opacity="0.6" FontSize="11"
                           IsVisible="{Binding Inspector.HasSelectedInstance}" />
              </StackPanel>

              <!-- Inspector error banner -->
              <Border DockPanel.Dock="Top"
                      IsVisible="{Binding Inspector.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Background="#33D32F2F" BorderBrush="#88D32F2F"
                      BorderThickness="1" CornerRadius="4" Padding="10,6"
                      Margin="0,0,0,6">
                <TextBlock Text="{Binding Inspector.ErrorMessage}"
                           Foreground="#FFD32F2F" TextWrapping="Wrap" />
              </Border>

              <!-- Instances + walked-fields split (resizable). -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240" MinWidth="160" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*"   MinWidth="240" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                  <TextBlock DockPanel.Dock="Top"
                             Text="{StaticResource Inspector.InstancesTitle}"
                             FontWeight="SemiBold" Margin="0,0,0,4" />
                  <TextBlock DockPanel.Dock="Bottom"
                             Text="{Binding Inspector.Instances.Count, StringFormat='\{0\} matches'}"
                             Opacity="0.6" FontSize="11" Margin="0,4,0,0" />
                  <ListBox ItemsSource="{Binding Inspector.Instances}"
                           SelectedItem="{Binding Inspector.SelectedInstance, Mode=TwoWay}"
                           x:DataType="vm:MainWindowViewModel">
                    <!-- Phase 19d-2: right-click any instance → "Call method
                         on this instance…". Switches to the Methods tab and
                         remembers this instance so the subsequent
                         "Call method… (pick overload)" right-click on any
                         method pre-fills its `this` pointer (no manual
                         paste). The handler lives in the code-behind and
                         resolves the right-clicked row via the ListBox's
                         SelectedItem (Avalonia auto-selects on right-click
                         before showing the menu). -->
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{StaticResource Inspector.CallMethodOnInstanceMenu}"
                                  Click="OnCallMethodOnInstanceClicked" />
                        <MenuItem Header="{StaticResource Inspector.CopyInstanceAddressMenu}"
                                  Click="OnCopyInstanceAddressClicked" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:InstanceItem">
                        <TextBlock Text="{Binding Label}"
                                   FontFamily="Consolas,Cascadia Mono,monospace" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="4"
                              Background="#22000000"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" />

                <DockPanel Grid.Column="2" Margin="6,0,0,0">
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{StaticResource Inspector.FieldsTitle}"
                               FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ProgressBar Grid.Column="1" IsIndeterminate="True"
                                 IsVisible="{Binding Inspector.IsLoadingWalk}"
                                 Width="80" Height="4" VerticalAlignment="Center" />
                  </Grid>

                  <!-- Field filter is UI-only — Copy CE XML / Copy CE field
                       still operate on the unfiltered tree, mirroring the
                       Assemblies / Classes filter precedent. Substring match
                       on Name OR Type, applied uniformly across top-level
                       and any expanded children rows. -->
                  <TextBox DockPanel.Dock="Top"
                           PlaceholderText="{StaticResource Inspector.FilterWatermark}"
                           Text="{Binding Inspector.Filter, Mode=TwoWay}"
                           Margin="0,0,0,4" />

                  <!-- Phase 11.5: hierarchical field grid. Sorting is OFF
                       because rows are positioned relative to their parent
                       (parent first, then indented children). Expand chevron
                       lives in the Name column; right-click any row to copy
                       a CE XML / CE field rooted at that node's effective
                       address. -->
                  <!-- CanUserSortColumns=True drives Avalonia's built-in sort
                       through a DataGridCollectionView wrapper, which sorts
                       the visual layer only — the underlying `Fields`
                       observable stays in offset order so the VM's
                       expand / collapse / scroll-into-view logic (which
                       indexes into Fields directly) continues to work.
                       SortMemberPath on the Offset and Name columns points
                       at the int / string properties so numeric / textual
                       sort behaves naturally; the OffsetHex display string
                       would otherwise sort lexicographically ("0x100" before
                       "0x80"). -->
                  <DataGrid x:Name="FieldsDataGrid"
                            ItemsSource="{Binding Inspector.FilteredFields}"
                            SelectedItem="{Binding Inspector.SelectedNode, Mode=TwoWay}"
                            IsReadOnly="True"
                            AutoGenerateColumns="False"
                            CanUserResizeColumns="True"
                            CanUserReorderColumns="True"
                            CanUserSortColumns="True"
                            GridLinesVisibility="Horizontal"
                            x:DataType="vm:MainWindowViewModel">
                    <DataGrid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{StaticResource Inspector.CopyCeXmlNode}"
                                  Command="{Binding Inspector.CopyCeXmlNodeCommand}" />
                        <MenuItem Header="{StaticResource Inspector.CopyCeFieldNode}"
                                  Command="{Binding Inspector.CopyCeFieldNodeCommand}" />
                        <Separator />
                        <!-- Phase 17c — Inspector right-click reverse address
                             lookup. Pre-fills the Address Lookup tab's input
                             with the row's effective address (deref pointer
                             for pointer rows, storage address otherwise) and
                             switches tabs. Code-behind reads the right-clicked
                             row's Address from the DataGrid since the menu
                             command can't easily bind to the row context
                             through MainWindowViewModel. -->
                        <MenuItem Header="{StaticResource Inspector.LookupAddressMenu}"
                                  Click="OnLookupInspectorAddressClicked" />
                      </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="{StaticResource Browser.ColName}" Width="*"
                                              SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="vm:WalkedFieldNode">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                              <Border Width="{Binding IndentPx}" />
                              <Button Content="{Binding ExpandGlyph}"
                                      Command="{Binding ToggleCommand}"
                                      Padding="2,0"
                                      MinWidth="18" Height="18"
                                      FontSize="10"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsEnabled="{Binding CanExpand}"
                                      VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Name}"
                                         VerticalAlignment="Center" />
                              <TextBlock Text="{Binding LoadHint}"
                                         Opacity="0.55"
                                         FontSize="11"
                                         Margin="6,0,0,0"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="{StaticResource Browser.ColOffset}" Width="80"
                                          Binding="{Binding OffsetHex, x:DataType=vm:WalkedFieldNode}"
                                          SortMemberPath="Offset" />
                      <!-- Field storage address. Live + per-instance, so a
                           glance at the column lets the user spot which
                           rows share an instance memory page (handy when
                           cross-referencing with CE's memory viewer). The
                           pointer dereference value, when relevant, lives
                           in the Value column so it's not duplicated here. -->
                      <DataGridTextColumn Header="{StaticResource Inspector.ColAddress}" Width="155"
                                          Binding="{Binding Address, x:DataType=vm:WalkedFieldNode}"
                                          FontFamily="Consolas,Cascadia Mono,monospace" />
                      <DataGridTextColumn Header="{StaticResource Browser.ColType}"   Width="*"
                                          Binding="{Binding Type, x:DataType=vm:WalkedFieldNode}" />
                      <DataGridTextColumn Header="{StaticResource Inspector.ColValue}" Width="*"
                                          Binding="{Binding DisplayValue, x:DataType=vm:WalkedFieldNode}" />
                      <DataGridTextColumn Header="{StaticResource Browser.ColDeclaredIn}" Width="160"
                                          Binding="{Binding DeclaredIn, x:DataType=vm:WalkedFieldNode}" />
                      <!-- Phase 11.6: per-row action buttons. addr / ptr /
                           name copy the corresponding string to clipboard;
                           HEX hands the row's effective address to AOBMaker's
                           CE plugin (named pipe \\.\pipe\AOBMakerCEBridge)
                           so the open Memory View jumps to it. AOBMaker is
                           optional — when not running the HEX call no-ops
                           and logs to ui/view; the other three work
                           unconditionally. IsEnabled bindings hide the
                           buttons that have no payload (e.g. ptr is
                           disabled for primitive rows whose Ptr is empty). -->
                      <DataGridTemplateColumn Header="{StaticResource Inspector.ColActions}"
                                              Width="155" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="vm:WalkedFieldNode">
                            <StackPanel Orientation="Horizontal" Spacing="2"
                                        VerticalAlignment="Center">
                              <Button Content="addr" FontSize="10" Padding="4,0" MinHeight="20"
                                      Command="{Binding CopyAddrCommand}"
                                      IsEnabled="{Binding CanCopyAddr}"
                                      ToolTip.Tip="{StaticResource Inspector.CopyAddrTooltip}" />
                              <Button Content="ptr"  FontSize="10" Padding="4,0" MinHeight="20"
                                      Command="{Binding CopyPtrCommand}"
                                      IsEnabled="{Binding CanCopyPtr}"
                                      ToolTip.Tip="{StaticResource Inspector.CopyPtrTooltip}" />
                              <Button Content="name" FontSize="10" Padding="4,0" MinHeight="20"
                                      Command="{Binding CopyNameCommand}"
                                      ToolTip.Tip="{StaticResource Inspector.CopyNameTooltip}" />
                              <Button Content="HEX"  FontSize="10" Padding="4,0" MinHeight="20"
                                      Command="{Binding NavigateHexCommand}"
                                      IsEnabled="{Binding CanNavigateHex}"
                                      ToolTip.Tip="{StaticResource Inspector.NavigateHexTooltip}" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Grid>
            </DockPanel>
          </TabItem>
          <TabItem Header="{StaticResource Browser.MethodsTab}">
            <DockPanel>
              <TextBox x:Name="MethodFilterBox"
                       DockPanel.Dock="Top"
                       PlaceholderText="{StaticResource Browser.FilterMethodsWatermark}"
                       Text="{Binding Browser.MethodFilter, Mode=TwoWay}"
                       Margin="0,0,0,4" />
              <DataGrid x:Name="MethodsDataGrid"
                        ItemsSource="{Binding Browser.FilteredMethods}"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="True"
                        CanUserReorderColumns="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="Horizontal"
                        x:DataType="vm:MainWindowViewModel">
                <DataGrid.ContextMenu>
                  <!-- Phase 18c / 19d / 19d-2: right-click any row →
                       enumerate every overload of this method on the
                       selected class. Two paths:
                       • "Find overloads…" always opens the picker modal
                         (where the user can copy AOB / registerSymbol AA
                         scripts, or right-click a single overload to call
                         it via `callMethod`).
                       • "Call method… (pick overload)" probes
                         findMethodInstances first; when count==1 it skips
                         the picker and jumps straight to the
                         MethodCallWindow seeded from that single overload.
                         Multi-overload methods (Mathf.Abs, String.Concat)
                         still drop into the picker for the user to choose. -->
                  <ContextMenu>
                    <MenuItem Header="{StaticResource Browser.MethodFindOverloadsMenu}"
                              Click="OnMethodFindOverloadsClicked" />
                    <MenuItem Header="{StaticResource Browser.MethodCallMethodMenu}"
                              Click="OnMethodCallMethodClicked" />
                    <Separator />
                    <!-- Per-cell clipboard helpers. MethodRow has no return
                         type (only the overload-picker RPC carries that), so
                         the 3rd item copies the row's Address column instead.
                         Single-select only; multi-select is a follow-up. -->
                    <MenuItem Header="{StaticResource Browser.CopyMethodNameMenu}"
                              Click="OnCopyMethodNameClicked" />
                    <MenuItem Header="{StaticResource Browser.CopyMethodAddressMenu}"
                              Click="OnCopyMethodAddressClicked" />
                    <MenuItem Header="{StaticResource Browser.CopyMethodDeclaredInMenu}"
                              Click="OnCopyMethodDeclaredInClicked" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{StaticResource Browser.ColName}"
                                          Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:MethodRow">
                        <controls:HighlightedTextBlock SourceText="{Binding Name}"
                                                       Highlight="{Binding #MethodFilterBox.Text}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="4,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{StaticResource Browser.ColAddress}" Width="160"
                                      Binding="{Binding Address, x:DataType=vm:MethodRow}" />
                  <DataGridTextColumn Header="{StaticResource Browser.ColToken}"   Width="100"
                                      Binding="{Binding TokenHex, x:DataType=vm:MethodRow}" />
                  <DataGridTextColumn Header="{StaticResource Browser.ColFlags}"   Width="80"
                                      Binding="{Binding FlagsHex, x:DataType=vm:MethodRow}" />
                  <DataGridCheckBoxColumn Header="{StaticResource Browser.ColStatic}" Width="60"
                                          Binding="{Binding IsStatic, x:DataType=vm:MethodRow}" />
                  <DataGridTextColumn Header="{StaticResource Browser.ColDeclaredIn}" Width="160"
                                      Binding="{Binding DeclaredIn, x:DataType=vm:MethodRow}" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <!-- Phase 17c — Address Lookup tab. Wraps the `whatIsAt` RPC:
               paste any process address (typically from CE's *Find what
               writes / accesses* or pointer scan) and the backend walks
               back to identify the containing managed instance + class +
               declared field. The "Inspect this instance" button hands
               the result over to the Inspector tab via
               AddressLookupViewModel.InspectInstanceRequested. -->
          <TabItem Header="{StaticResource AddrLookup.Tab}">
            <DockPanel Margin="0,4,0,0">
              <!-- Input row -->
              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto"
                    Margin="0,0,0,8">
                <TextBlock Grid.Column="0"
                           Text="{StaticResource AddrLookup.AddressLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         PlaceholderText="{StaticResource AddrLookup.AddressWatermark}"
                         Text="{Binding AddressLookup.AddressInput, Mode=TwoWay}"
                         FontFamily="Consolas,Cascadia Mono,monospace" />
                <Button Grid.Column="2"
                        Content="{StaticResource AddrLookup.LookupButton}"
                        Command="{Binding AddressLookup.LookupCommand}"
                        Margin="6,0,0,0" />
                <Button Grid.Column="3"
                        Content="{StaticResource AddrLookup.ClearButton}"
                        Command="{Binding AddressLookup.ClearCommand}"
                        Margin="6,0,0,0" />
              </Grid>

              <!-- Tunables row -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                          Spacing="8" Margin="0,0,0,8">
                <TextBlock Text="{StaticResource AddrLookup.ScanLabel}"
                           VerticalAlignment="Center" Opacity="0.7"
                           ToolTip.Tip="{StaticResource AddrLookup.ScanTooltip}" />
                <NumericUpDown Value="{Binding AddressLookup.MaxBackwardScan, Mode=TwoWay}"
                               Minimum="64" Maximum="16384" Increment="1024"
                               Width="130"
                               ToolTip.Tip="{StaticResource AddrLookup.ScanTooltip}" />
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding AddressLookup.IsBusy}"
                             Width="80" Height="4" VerticalAlignment="Center" />
              </StackPanel>

              <!-- Error banner -->
              <Border DockPanel.Dock="Top"
                      IsVisible="{Binding AddressLookup.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Background="#33D44017" BorderBrush="#88D44017"
                      BorderThickness="1" Padding="8,4" Margin="0,0,0,8"
                      CornerRadius="3">
                <TextBlock Text="{Binding AddressLookup.ErrorMessage}"
                           Foreground="#FFD44017" TextWrapping="Wrap" />
              </Border>

              <!-- Result panel -->
              <ScrollViewer>
                <StackPanel Spacing="6">

                  <!-- "no result" hint when the backend returned !found -->
                  <Border Background="#22808080" BorderBrush="#44808080"
                          BorderThickness="1" Padding="10,6" CornerRadius="3"
                          IsVisible="{Binding AddressLookup.Result.Found, Converter={x:Static BoolConverters.Not}, FallbackValue=False}">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{StaticResource AddrLookup.NoResult}"
                                 TextWrapping="Wrap" Opacity="0.85" />
                      <StackPanel Orientation="Horizontal" Spacing="6"
                                  IsVisible="{Binding AddressLookup.Result.Reason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{StaticResource AddrLookup.NotFoundReason}"
                                   Opacity="0.7" />
                        <TextBlock Text="{Binding AddressLookup.Result.Reason}"
                                   FontFamily="Consolas,Cascadia Mono,monospace" />
                      </StackPanel>
                      <TextBlock Text="{Binding AddressLookup.ScannedLabel}"
                                 Opacity="0.6" FontSize="11" />
                    </StackPanel>
                  </Border>

                  <!-- Found result -->
                  <Border BorderBrush="#44808080" BorderThickness="1"
                          Padding="10" CornerRadius="3"
                          IsVisible="{Binding AddressLookup.HasResult}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{StaticResource AddrLookup.ResultHeader}"
                                 FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                            Margin="0,4,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.InstanceLabel}"
                                   Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding AddressLookup.InstanceLabel}"
                                   FontFamily="Consolas,Cascadia Mono,monospace" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.ClassLabel}"
                                   Opacity="0.7" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding AddressLookup.ClassLabel}"
                                   Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.OffsetLabel}"
                                   Opacity="0.7" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding AddressLookup.FieldOffsetLabel}"
                                   FontFamily="Consolas,Cascadia Mono,monospace"
                                   Margin="0,4,0,0" />

                        <!-- Field row (exact match) -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.FieldLabel}"
                                   Opacity="0.7" Margin="0,4,0,0"
                                   IsVisible="{Binding AddressLookup.HasField}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding AddressLookup.FieldLabel}"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding AddressLookup.HasField}" />

                        <!-- Nearest field row (no exact match) -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.NearestLabel}"
                                   Opacity="0.7" Margin="0,4,0,0"
                                   IsVisible="{Binding AddressLookup.HasNearestField}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding AddressLookup.NearestFieldLabel}"
                                   Margin="0,4,0,0" Opacity="0.85"
                                   IsVisible="{Binding AddressLookup.HasNearestField}" />

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.KindLabel}"
                                   Opacity="0.7" Margin="0,4,0,0"
                                   IsVisible="{Binding AddressLookup.HasField}" />
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding AddressLookup.KindLabel}"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding AddressLookup.HasField}" />

                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="{StaticResource AddrLookup.ScannedLabel}"
                                   Opacity="0.7" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1"
                                   Text="{Binding AddressLookup.ScannedLabel}"
                                   Opacity="0.6" FontSize="11"
                                   Margin="0,4,0,0" />
                      </Grid>

                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="{StaticResource AddrLookup.InspectInstance}"
                                Command="{Binding AddressLookup.InspectInstanceCommand}" />
                        <Button Content="{StaticResource AddrLookup.CopyInstance}"
                                Command="{Binding AddressLookup.CopyInstanceAddrCommand}" />
                        <!-- Phase 22e: push the lookup result (instance pointer
                             + resolved field) to CE's address list as a
                             parent AA + child memory record. Hidden when the
                             session has no AOBMaker bridge. -->
                        <Button Content="{StaticResource AddrLookup.SendToCe}"
                                Command="{Binding AddressLookup.SendToCeTableCommand}"
                                IsVisible="{Binding AddressLookup.HasAobMaker}"
                                ToolTip.Tip="{StaticResource AddrLookup.SendToCeTooltip}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
