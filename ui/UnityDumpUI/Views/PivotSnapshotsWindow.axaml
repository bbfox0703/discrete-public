<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnityDumpUI.ViewModels"
        x:Class="UnityDumpUI.Views.PivotSnapshotsWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="520" Height="440"
        WindowStartupLocation="CenterOwner"
        Title="Snapshots — pick which captures to pivot">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Close" Click="OnCloseClicked" Padding="14,4"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="11" Opacity="0.8"
               TextWrapping="Wrap"
               Text="Tick the captures to include in the pivot. Listed in capture-time order by default; click the Captured header to re-sort. The pivot keys by field value, so cross-session captures line up too."/>
    <Border Padding="0" Background="#1F808080" CornerRadius="3">
      <DataGrid Name="PivotSnapshotsGrid"
                ItemsSource="{Binding ClassPivot.SelectionRows}"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                IsReadOnly="False"
                GridLinesVisibility="Horizontal"
                CanUserResizeColumns="True"
                CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Use" Width="50" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Include, Mode=TwoWay}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Captured (time order)" Binding="{Binding DisplayLabel}"
                              IsReadOnly="True" Width="*" MinWidth="200"
                              SortMemberPath="CapturedAt" CanUserSort="True"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</Window>
