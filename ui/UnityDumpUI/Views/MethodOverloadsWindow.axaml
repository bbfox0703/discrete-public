<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnityDumpUI.ViewModels"
        x:Class="UnityDumpUI.Views.MethodOverloadsWindow"
        x:DataType="vm:MethodOverloadsViewModel"
        Width="1100" Height="540" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="avares://DiscreteUI/Assets/MainIcon.ico"
        Title="{StaticResource MethodOverloads.Title}">
  <DockPanel LastChildFill="True" Margin="12">

    <!-- Title row: which method we're enumerating -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0"
                 Text="{Binding TitleLabel}"
                 FontSize="14" FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <Button   Grid.Column="1"
                Content="{StaticResource MethodOverloads.Refresh}"
                Command="{Binding RefreshCommand}" />
    </Grid>

    <!-- Filter row: signature substring + AOB length -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0"
                 Text="{StaticResource MethodOverloads.SigFilterLabel}"
                 VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox   Grid.Column="1"
                 PlaceholderText="{StaticResource MethodOverloads.SigFilterWatermark}"
                 Text="{Binding SignatureFilter, Mode=TwoWay}" />
      <TextBlock Grid.Column="2"
                 Text="{StaticResource MethodOverloads.AobLengthLabel}"
                 VerticalAlignment="Center" Margin="14,0,8,0" />
      <NumericUpDown Grid.Column="3"
                     Value="{Binding AobLength, Mode=TwoWay}"
                     Minimum="8" Maximum="128" Increment="8"
                     ShowButtonSpinner="True" MinWidth="140" />
    </Grid>

    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}" Height="3" Margin="0,0,0,4" />

    <Border DockPanel.Dock="Top"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="#33D32F2F" BorderBrush="#88D32F2F"
            BorderThickness="1" CornerRadius="4" Padding="10,6"
            Margin="0,0,0,8">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFD32F2F" TextWrapping="Wrap" />
    </Border>

    <!-- Bottom action bar.
         Layout: status text pinned left (single line, ellipsised if too wide
         for the remaining space); right-side actions live in a WrapPanel so
         they reflow onto multiple rows when the window is narrowed below the
         all-on-one-line threshold. Order = Copy group → Push group → Close,
         mirroring the renamed labels in en.axaml.
         The Mono-only buttons (Copy/Push mono_register) sit next to their
         AOB counterparts because they're alternative resolutions of the same
         method; the user picks one or the other based on whether they want
         a DLL-free or AOB-scan path. -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock DockPanel.Dock="Left"
                 Text="{Binding StatusMessage}"
                 VerticalAlignment="Center"
                 Foreground="#FF7B7B7B"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap"
                 Margin="0,0,12,0" />
      <WrapPanel Orientation="Horizontal"
                 ItemSpacing="8" LineSpacing="6"
                 HorizontalAlignment="Right">
        <CheckBox Content="{StaticResource MethodOverloads.AutoActivate}"
                  IsChecked="{Binding AutoActivateInCe, Mode=TwoWay}"
                  IsVisible="{Binding HasAobMakerBridge}"
                  VerticalAlignment="Center" />
        <!-- Copy group: clipboard outputs. -->
        <Button Content="{StaticResource MethodOverloads.CopyAddresses}"
                Command="{Binding CopyAddressesCommand}" />
        <Button Content="{StaticResource MethodOverloads.CopyRegisterSymbol}"
                Command="{Binding CopyRegisterSymbolScriptCommand}"
                ToolTip.Tip="{StaticResource MethodOverloads.CopyRegisterSymbolTooltip}" />
        <Button Content="{StaticResource MethodOverloads.CopyAobScript}"
                Command="{Binding CopyAobScriptCommand}"
                ToolTip.Tip="{StaticResource MethodOverloads.CopyAobScriptTooltip}" />
        <!-- DLL-free Mono path: only surfaces when the live target is Mono.
             IL2CPP overloads have AOT addresses; mono_registerSymbolEx
             would fail at mono_findClass on the IL2CPP runtime. -->
        <Button Content="{StaticResource MethodOverloads.CopyMonoSymbolScript}"
                Command="{Binding CopyMonoSymbolScriptCommand}"
                IsVisible="{Binding IsMonoBackend}"
                ToolTip.Tip="{StaticResource MethodOverloads.CopyMonoSymbolScriptTooltip}" />
        <!-- Push group: same scripts but pushed into CE via AOBMaker. -->
        <Button Content="{StaticResource MethodOverloads.CreateAaInCe}"
                Command="{Binding CreateAaScriptInCeCommand}"
                IsVisible="{Binding HasAobMakerBridge}"
                Classes="accent" />
        <Button Content="{StaticResource MethodOverloads.CreateMonoSymbolInCe}"
                Command="{Binding CreateMonoSymbolInCeCommand}"
                IsVisible="{Binding ShowMonoCreateInCe}"
                ToolTip.Tip="{StaticResource MethodOverloads.CreateMonoSymbolInCeTooltip}" />
        <Button Content="{StaticResource MethodOverloads.Close}"
                Click="OnCloseClicked" />
      </WrapPanel>
    </DockPanel>

    <!-- Overload grid (multi-select via per-row checkbox) -->
    <DataGrid x:Name="OverloadsGrid"
              ItemsSource="{Binding Overloads}"
              IsReadOnly="False"
              AutoGenerateColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              GridLinesVisibility="Horizontal">
      <!-- Phase 19d: right-click any row → "Call method…" opens the
           MethodCallWindow seeded from that overload's signature. The
           CommandParameter is the row VM via $parent[DataGrid].SelectedItem
           (works because Avalonia's DataGrid auto-selects the right-clicked
           row before showing the context menu). -->
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{StaticResource MethodOverloads.CallMethodMenu}"
                    Command="{Binding CallMethodCommand}"
                    CommandParameter="{Binding $parent[DataGrid].SelectedItem}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <!-- DataGridCheckBoxColumn requires entering edit mode before the
             checkbox responds (double-click). Use a template column with a
             real CheckBox + Focusable=False so a single click toggles. -->
        <DataGridTemplateColumn Header="" Width="36" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:MethodOverloadRow">
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        Focusable="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{StaticResource MethodOverloads.ColSignature}" Width="Auto" MinWidth="140"
                            Binding="{Binding SignatureLabel}"
                            IsReadOnly="True"
                            SortMemberPath="SignatureLabel" CanUserSort="True"
                            FontFamily="Consolas,Cascadia Mono,monospace" />
        <DataGridTextColumn Header="{StaticResource MethodOverloads.ColReturn}" Width="120"
                            Binding="{Binding ReturnType}"
                            IsReadOnly="True"
                            SortMemberPath="ReturnType" CanUserSort="True" />
        <DataGridTextColumn Header="{StaticResource MethodOverloads.ColAddress}" Width="160"
                            Binding="{Binding Address}"
                            IsReadOnly="True"
                            SortMemberPath="Address" CanUserSort="True"
                            FontFamily="Consolas,Cascadia Mono,monospace" />
        <DataGridTextColumn Header="{StaticResource MethodOverloads.ColSuffix}" Width="120"
                            Binding="{Binding HumanSuffix}"
                            IsReadOnly="True"
                            SortMemberPath="HumanSuffix" CanUserSort="True"
                            FontFamily="Consolas,Cascadia Mono,monospace" />
        <DataGridTextColumn Header="{StaticResource MethodOverloads.ColModifiers}" Width="110"
                            Binding="{Binding ModifiersLabel}"
                            IsReadOnly="True"
                            SortMemberPath="ModifiersLabel" CanUserSort="True" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
