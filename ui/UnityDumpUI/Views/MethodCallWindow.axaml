<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnityDumpUI.ViewModels"
        x:Class="UnityDumpUI.Views.MethodCallWindow"
        x:DataType="vm:MethodCallViewModel"
        Width="780" Height="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="avares://DiscreteUI/Assets/MainIcon.ico"
        Title="{StaticResource MethodCall.Title}">
  <DockPanel LastChildFill="True" Margin="12">

    <!-- Title block: class + method + signature (read-only) -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto"
          Margin="0,0,0,8">
      <TextBlock Grid.Row="0" Grid.Column="0"
                 Text="{StaticResource MethodCall.ClassLabel}"
                 Foreground="#FF7B7B7B" VerticalAlignment="Center" />
      <TextBlock Grid.Row="0" Grid.Column="1"
                 Text="{Binding ClassDisplay}"
                 FontFamily="Consolas,Cascadia Mono,monospace"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="0,0,0,2" />

      <TextBlock Grid.Row="1" Grid.Column="0"
                 Text="{StaticResource MethodCall.MethodLabel}"
                 Foreground="#FF7B7B7B" VerticalAlignment="Center" />
      <TextBlock Grid.Row="1" Grid.Column="1"
                 Text="{Binding MethodDisplay}"
                 FontFamily="Consolas,Cascadia Mono,monospace"
                 VerticalAlignment="Center" Margin="0,0,0,2" />

      <TextBlock Grid.Row="2" Grid.Column="0"
                 Text="{StaticResource MethodCall.InstanceLabel}"
                 Foreground="#FF7B7B7B" VerticalAlignment="Center" />
      <TextBox   Grid.Row="2" Grid.Column="1"
                 Text="{Binding InstanceAddress, Mode=TwoWay}"
                 PlaceholderText="{StaticResource MethodCall.InstanceWatermark}"
                 FontFamily="Consolas,Cascadia Mono,monospace" />
    </Grid>

    <!-- Bottom action bar -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock DockPanel.Dock="Left"
                 Text="{Binding StatusMessage}"
                 VerticalAlignment="Center"
                 Foreground="#FF7B7B7B"
                 TextWrapping="NoWrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <!-- Phase 22e: push the current inputs to CE's address list as
             an AA script (via AOBMaker bridge). Hidden when the parent
             window didn't wire a bridge so the button doesn't tease a
             feature that won't work. -->
        <Button Content="{StaticResource MethodCall.SendToCeButton}"
                Command="{Binding SendToCeTableCommand}"
                IsVisible="{Binding HasAobMaker}"
                ToolTip.Tip="{StaticResource MethodCall.SendToCeTooltip}" />
        <Button Content="{StaticResource MethodCall.CallButton}"
                Command="{Binding CallCommand}"
                Classes="accent" />
        <Button Content="{StaticResource MethodCall.CloseButton}"
                Click="OnCloseClicked" />
      </StackPanel>
    </DockPanel>

    <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}" Height="3" Margin="0,4,0,0" />

    <!-- Result panel — shown only after a call lands -->
    <Border DockPanel.Dock="Bottom"
            IsVisible="{Binding HasResult}"
            BorderThickness="1" CornerRadius="4" Padding="10,8"
            Margin="0,8,0,0">
      <Border.Styles>
        <Style Selector="Border">
          <Setter Property="Background" Value="#332E7D32" />
          <Setter Property="BorderBrush" Value="#88388E3C" />
        </Style>
      </Border.Styles>
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{StaticResource MethodCall.ResultHeader}"
                     FontWeight="SemiBold" />
          <TextBlock Grid.Column="1"
                     Text="{Binding ResultElapsedLabel}"
                     Foreground="#FF7B7B7B" />
        </Grid>
        <!-- ok=true success row -->
        <Grid ColumnDefinitions="100,*"
              IsVisible="{Binding ResultOk}">
          <TextBlock Grid.Column="0" Foreground="#FF7B7B7B"
                     Text="{StaticResource MethodCall.ResultOk}" />
          <SelectableTextBlock Grid.Column="1"
                               Text="{Binding ResultReturnValue}"
                               FontFamily="Consolas,Cascadia Mono,monospace" />
        </Grid>
        <Grid ColumnDefinitions="100,*"
              IsVisible="{Binding ResultReturnType, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Grid.Column="0" Foreground="#FF7B7B7B" Text="returnType" />
          <SelectableTextBlock Grid.Column="1"
                               Text="{Binding ResultReturnType}"
                               FontFamily="Consolas,Cascadia Mono,monospace"
                               Foreground="#FF7B7B7B" />
        </Grid>
        <!-- managed exception row -->
        <Grid ColumnDefinitions="100,*"
              IsVisible="{Binding ResultException, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Grid.Column="0" Foreground="#FFD32F2F"
                     Text="{StaticResource MethodCall.ResultException}" />
          <SelectableTextBlock Grid.Column="1"
                               Text="{Binding ResultException}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas,Cascadia Mono,monospace"
                               Foreground="#FFD32F2F" />
        </Grid>
        <!-- protocol error row -->
        <Grid ColumnDefinitions="100,*"
              IsVisible="{Binding ResultError, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Grid.Column="0" Foreground="#FFD32F2F"
                     Text="{StaticResource MethodCall.ResultError}" />
          <SelectableTextBlock Grid.Column="1"
                               Text="{Binding ResultError}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas,Cascadia Mono,monospace"
                               Foreground="#FFD32F2F" />
        </Grid>
        <!-- diagnostic note -->
        <TextBlock Text="{Binding ResultNote}"
                   Foreground="#FFC09418"
                   TextWrapping="Wrap"
                   FontStyle="Italic"
                   IsVisible="{Binding ResultNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <!-- Params header -->
    <TextBlock DockPanel.Dock="Top"
               Text="{StaticResource MethodCall.ParamsHeader}"
               FontSize="13" FontWeight="SemiBold"
               Margin="0,8,0,4" />

    <!-- "no parameters" placeholder -->
    <TextBlock DockPanel.Dock="Top"
               Text="{StaticResource MethodCall.NoParams}"
               Foreground="#FF7B7B7B"
               IsVisible="{Binding HasNoParams}"
               Margin="4,4,0,0" />

    <!-- Param rows grid (filled by the VM's ObservableCollection) -->
    <DataGrid ItemsSource="{Binding Params}"
              IsVisible="{Binding HasParams}"
              IsReadOnly="False"
              AutoGenerateColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="False"
              GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource MethodCall.ParamColType}" Width="160"
                            Binding="{Binding TypeName, x:DataType=vm:MethodCallParamRow}"
                            IsReadOnly="True"
                            FontFamily="Consolas,Cascadia Mono,monospace" />
        <DataGridTextColumn Header="{StaticResource MethodCall.ParamColName}" Width="140"
                            Binding="{Binding Name, x:DataType=vm:MethodCallParamRow}"
                            IsReadOnly="True"
                            FontFamily="Consolas,Cascadia Mono,monospace" />
        <!-- Value editor: TextBox for everything in v1 (string, hex, number,
             "true"/"false"). Smart-typed editors (NumericUpDown, ComboBox
             for enums) deferred to 19d-2. -->
        <DataGridTemplateColumn Header="{StaticResource MethodCall.ParamColValue}" Width="*"
                                CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:MethodCallParamRow">
              <TextBox Text="{Binding ValueText, Mode=TwoWay}"
                       IsEnabled="{Binding !IsNull}"
                       FontFamily="Consolas,Cascadia Mono,monospace"
                       VerticalAlignment="Center"
                       Margin="0,2,0,2" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{StaticResource MethodCall.ParamColNull}" Width="60"
                                CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:MethodCallParamRow">
              <CheckBox IsChecked="{Binding IsNull, Mode=TwoWay}"
                        IsEnabled="{Binding IsReference}"
                        Focusable="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
