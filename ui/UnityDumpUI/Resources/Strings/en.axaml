<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    All UI strings live here. Reference via {StaticResource Key} in XAML.
    English only per Architecture.md Rule "UI Strings".
  -->
  <sys:String x:Key="App.Title">Unity CE Dumper</sys:String>
  <sys:String x:Key="App.BootstrapBanner">Phase 0 — Bootstrap. Ready.</sys:String>

  <!-- Phase 8 browser panels. -->
  <sys:String x:Key="Browser.AssembliesTitle">Assemblies</sys:String>
  <sys:String x:Key="Browser.ClassesTitle">Classes</sys:String>
  <sys:String x:Key="Browser.CollapsePaneTooltip">Collapse this pane (gives the space to the Inspector / Detail pane)</sys:String>
  <sys:String x:Key="Browser.ExpandPaneTooltip">Expand pane back</sys:String>
  <sys:String x:Key="Browser.FilterWatermark">filter…</sys:String>
  <sys:String x:Key="Browser.FilterFieldsWatermark">filter fields (name or type)…</sys:String>
  <sys:String x:Key="Browser.FilterMethodsWatermark">filter methods (name)…</sys:String>
  <sys:String x:Key="Inspector.FilterWatermark">filter walked fields (name or type)…</sys:String>
  <sys:String x:Key="Browser.Refresh">↻</sys:String>
  <sys:String x:Key="Browser.ShowInherited">Show inherited members</sys:String>
  <sys:String x:Key="Browser.FieldsTab">Fields</sys:String>
  <sys:String x:Key="Browser.MethodsTab">Methods</sys:String>
  <sys:String x:Key="Browser.ColName">Name</sys:String>
  <sys:String x:Key="Browser.ColOffset">Offset</sys:String>
  <sys:String x:Key="Browser.ColType">Type</sys:String>
  <sys:String x:Key="Browser.ColFlags">Flags</sys:String>
  <sys:String x:Key="Browser.ColStatic">static</sys:String>
  <sys:String x:Key="Browser.ColDeclaredIn">Declared in</sys:String>
  <sys:String x:Key="Browser.ColAddress">Address</sys:String>
  <sys:String x:Key="Browser.ColToken">Token</sys:String>
  <sys:String x:Key="Browser.InspectMenuItem">Inspect (find instances)…</sys:String>
  <sys:String x:Key="Browser.ExportSdkHeader">Export .h…</sys:String>
  <sys:String x:Key="Browser.ExportCsx">Export .csx…</sys:String>
  <sys:String x:Key="Browser.ExportCeXml">Export .CT…</sys:String>
  <sys:String x:Key="Browser.CopyCeXml">Copy CE XML</sys:String>
  <sys:String x:Key="Browser.CopyCeField">Copy CE field</sys:String>
  <sys:String x:Key="Browser.ExportOptions">Export options ▾</sys:String>
  <sys:String x:Key="Browser.OptDrilldownDepth">Drilldown depth</sys:String>
  <sys:String x:Key="Browser.OptArrayLimit">Array element limit</sys:String>
  <sys:String x:Key="Browser.OptCollapse">Collapse pointer/array nodes (CE XML)</sys:String>
  <sys:String x:Key="Browser.OptUseLiveData">Use live data in CE XML (real addresses, walks array elements)</sys:String>
  <sys:String x:Key="Browser.OptCeXmlBase">CE XML base address</sys:String>

  <!-- Phase 9 inspector panels. -->
  <sys:String x:Key="Inspector.Tab">Inspector</sys:String>
  <sys:String x:Key="Inspector.SetTarget">Inspect selected class</sys:String>
  <sys:String x:Key="Inspector.Find">Find instances</sys:String>
  <sys:String x:Key="Inspector.RefreshWalk">Re-walk</sys:String>
  <sys:String x:Key="Inspector.Clear">Clear</sys:String>
  <sys:String x:Key="Inspector.LimitLabel">Limit</sys:String>
  <sys:String x:Key="Inspector.AutoRefreshLabel">Auto refresh</sys:String>
  <sys:String x:Key="Inspector.AutoRefreshOff">Off</sys:String>
  <sys:String x:Key="Inspector.AutoRefresh250">250 ms</sys:String>
  <sys:String x:Key="Inspector.AutoRefresh1000">1 s</sys:String>
  <sys:String x:Key="Inspector.InstancesTitle">Instances</sys:String>
  <sys:String x:Key="Inspector.FieldsTitle">Walked fields</sys:String>
  <sys:String x:Key="Inspector.ClassPointerLabel">Class ptr</sys:String>
  <sys:String x:Key="Inspector.ColIndex">#</sys:String>
  <sys:String x:Key="Inspector.ColAddress">Address</sys:String>
  <sys:String x:Key="Inspector.ColValue">Value</sys:String>
  <sys:String x:Key="Inspector.NoTarget">No target — pick a class and press "Inspect selected class".</sys:String>
  <sys:String x:Key="Inspector.CopyCeXmlNode">Copy CE XML rooted here</sys:String>
  <sys:String x:Key="Inspector.CopyCeFieldNode">Copy CE field</sys:String>
  <sys:String x:Key="Inspector.ColActions">Actions</sys:String>
  <sys:String x:Key="Inspector.CopyAddrTooltip">Copy field address (e.g. 0x000001E5...)</sys:String>
  <sys:String x:Key="Inspector.CopyPtrTooltip">Copy pointer value (only meaningful for pointer-typed rows)</sys:String>
  <sys:String x:Key="Inspector.CopyNameTooltip">Copy field name</sys:String>
  <sys:String x:Key="Inspector.NavigateHexTooltip">Open Cheat Engine's Memory View at this address (requires AOBMaker plugin)</sys:String>
  <sys:String x:Key="Inspector.LookupAddressMenu">Find what's at this address…</sys:String>

  <!-- Phase 17c — Address Lookup tab (reverse address lookup; whatIsAt RPC). -->
  <sys:String x:Key="AddrLookup.Tab">Address Lookup</sys:String>
  <sys:String x:Key="AddrLookup.AddressLabel">Address:</sys:String>
  <sys:String x:Key="AddrLookup.AddressWatermark">paste a hex address (e.g. 0x000001E55B2518F0)…</sys:String>
  <sys:String x:Key="AddrLookup.LookupButton">Lookup</sys:String>
  <sys:String x:Key="AddrLookup.ClearButton">Clear</sys:String>
  <sys:String x:Key="AddrLookup.ScanLabel">Backward scan (bytes)</sys:String>
  <sys:String x:Key="AddrLookup.ScanTooltip">How far back from the queried address to look for an object header. 4 KB matches the DLL default; raise (capped at 16 KB) only if a known-large class isn't getting matched.</sys:String>
  <sys:String x:Key="AddrLookup.ResultHeader">Result</sys:String>
  <sys:String x:Key="AddrLookup.InstanceLabel">Instance:</sys:String>
  <sys:String x:Key="AddrLookup.ClassLabel">Class:</sys:String>
  <sys:String x:Key="AddrLookup.OffsetLabel">Field offset:</sys:String>
  <sys:String x:Key="AddrLookup.FieldLabel">Field:</sys:String>
  <sys:String x:Key="AddrLookup.NearestLabel">Nearest field:</sys:String>
  <sys:String x:Key="AddrLookup.KindLabel">Kind:</sys:String>
  <sys:String x:Key="AddrLookup.ScannedLabel">Scan:</sys:String>
  <sys:String x:Key="AddrLookup.InspectInstance">Inspect this instance</sys:String>
  <sys:String x:Key="AddrLookup.CopyInstance">Copy instance address</sys:String>
  <sys:String x:Key="AddrLookup.NoResult">No managed instance found in the scanned window. Try raising the backward scan, or check the address is from a live heap-resident object.</sys:String>
  <sys:String x:Key="AddrLookup.NotFoundReason">Reason:</sys:String>

  <!-- Connection bar. -->
  <sys:String x:Key="Conn.Connect">Connect</sys:String>
  <sys:String x:Key="Conn.Disconnect">Disconnect</sys:String>
  <sys:String x:Key="Conn.StatusLabel">Status:</sys:String>
  <sys:String x:Key="Conn.Inject">Pick &amp; inject…</sys:String>
  <sys:String x:Key="Conn.ProxyDeploy">Proxy Deploy…</sys:String>

  <!-- Proxy Deploy window (Phase 12c, redesigned to UE5CEDumper-style
       multi-select bulk panel). -->
  <sys:String x:Key="Deploy.Title">Proxy DLL Deploy</sys:String>
  <sys:String x:Key="Deploy.FilterWatermark">filter (name or path)…</sys:String>
  <sys:String x:Key="Deploy.ShowUnsupported">Show 32-bit / unsupported</sys:String>
  <sys:String x:Key="Deploy.Refresh">↻ Rescan</sys:String>
  <sys:String x:Key="Deploy.SelectAll">Select all</sys:String>
  <sys:String x:Key="Deploy.UnselectAll">Unselect all</sys:String>
  <sys:String x:Key="Deploy.InvertSelection">Invert</sys:String>
  <sys:String x:Key="Deploy.DefaultKindLabel">When installing:</sys:String>
  <sys:String x:Key="Deploy.InstallSelected">Install selected</sys:String>
  <sys:String x:Key="Deploy.UninstallSelected">Uninstall selected</sys:String>
  <sys:String x:Key="Deploy.UpdateAll">Update all deployed</sys:String>
  <sys:String x:Key="Deploy.UpdateAllTooltip">Re-install with the proxy kind currently in place — push fresh DLLs after rebuilding DiscreteUI.</sys:String>
  <sys:String x:Key="Deploy.ColName">Game</sys:String>
  <sys:String x:Key="Deploy.ColBackend">Backend</sys:String>
  <sys:String x:Key="Deploy.ColBitness">Bits</sys:String>
  <sys:String x:Key="Deploy.ColProxy">Proxy</sys:String>
  <sys:String x:Key="Deploy.ColStatus">Status</sys:String>
  <sys:String x:Key="Deploy.ColVersion">Version</sys:String>
  <sys:String x:Key="Deploy.ColLastMessage">Last operation</sys:String>
  <sys:String x:Key="Deploy.ColPath">Game .exe path</sys:String>

  <!-- Process picker dialog. -->
  <sys:String x:Key="Picker.Title">Pick Unity process</sys:String>
  <sys:String x:Key="Picker.FilterWatermark">filter (name or PID)…</sys:String>
  <sys:String x:Key="Picker.ShowAll">Show all processes</sys:String>
  <sys:String x:Key="Picker.Refresh">↻ Refresh</sys:String>
  <sys:String x:Key="Picker.InjectAndConnect">Inject &amp; Connect</sys:String>
  <sys:String x:Key="Picker.Cancel">Cancel</sys:String>
  <sys:String x:Key="Picker.ColPid">PID</sys:String>
  <sys:String x:Key="Picker.ColName">Process</sys:String>
  <sys:String x:Key="Picker.ColBackend">Backend</sys:String>
  <sys:String x:Key="Picker.ColPath">Path</sys:String>

  <!-- Handshake panel labels. -->
  <sys:String x:Key="Handshake.Title">Handshake</sys:String>
  <sys:String x:Key="Handshake.Engine">Engine</sys:String>
  <sys:String x:Key="Handshake.Backend">Backend</sys:String>
  <sys:String x:Key="Handshake.DllVariant">DLL variant</sys:String>
  <sys:String x:Key="Handshake.GameModule">Game module</sys:String>
  <sys:String x:Key="Handshake.UnityVersion">Unity version</sys:String>
  <sys:String x:Key="Handshake.MetadataVersion">Metadata version</sys:String>
  <sys:String x:Key="Handshake.AssembliesCount">Assemblies</sys:String>
  <sys:String x:Key="Handshake.Build">Build</sys:String>
  <sys:String x:Key="Handshake.Protocol">Protocol</sys:String>

  <!-- Phase 18c — Methods grid context menu + Method Overloads modal. -->
  <sys:String x:Key="Browser.MethodFindOverloadsMenu">Find overloads…</sys:String>

  <sys:String x:Key="MethodOverloads.Title">Method overloads</sys:String>
  <sys:String x:Key="MethodOverloads.Refresh">Refresh</sys:String>
  <sys:String x:Key="MethodOverloads.SigFilterLabel">Signature filter</sys:String>
  <sys:String x:Key="MethodOverloads.SigFilterWatermark">substring narrows by signature, e.g. Vector3</sys:String>
  <sys:String x:Key="MethodOverloads.AobLengthLabel">AOB bytes</sys:String>
  <sys:String x:Key="MethodOverloads.ColSignature">Signature</sys:String>
  <sys:String x:Key="MethodOverloads.ColReturn">Returns</sys:String>
  <sys:String x:Key="MethodOverloads.ColAddress">Address</sys:String>
  <sys:String x:Key="MethodOverloads.ColSuffix">Suffix</sys:String>
  <sys:String x:Key="MethodOverloads.ColModifiers">Modifiers</sys:String>
  <sys:String x:Key="MethodOverloads.CopyAobScript">Copy AOB AA script</sys:String>
  <sys:String x:Key="MethodOverloads.CopyRegisterSymbol">Copy registerSymbol script</sys:String>
  <sys:String x:Key="MethodOverloads.CopyAddresses">Copy addresses</sys:String>
  <sys:String x:Key="MethodOverloads.Close">Close</sys:String>
</ResourceDictionary>
