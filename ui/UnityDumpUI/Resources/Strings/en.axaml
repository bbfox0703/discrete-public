<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    All UI strings live here. Reference via {StaticResource Key} in XAML.
    English only per Architecture.md Rule "UI Strings".
  -->
  <sys:String x:Key="App.Title">Unity CE Dumper</sys:String>
  <sys:String x:Key="App.BootstrapBanner">Phase 0 — Bootstrap. Ready.</sys:String>
  <!-- Dev-tool reminder on the connection bar. End-user CE tables
       should NOT ship DiscreteUI.exe — they should embed the backend
       DLL inside the .CT file instead (see scripts/ce_table_bootstrap.lua). -->
  <sys:String x:Key="App.DevToolWarning">Dev tool · not for distribution</sys:String>
  <sys:String x:Key="App.DevToolWarningTooltip">DiscreteUI is a developer / power-user tool. For CE-table distribution to end users, embed the backend DLL inside the .CT file using the Mode-B bootstrap pattern — see scripts/ce_table_bootstrap.lua + scripts/README.md "Deployment for CE-table publishers".</sys:String>

  <!-- Phase 8 browser panels. -->
  <sys:String x:Key="Browser.AssembliesTitle">Assemblies</sys:String>
  <sys:String x:Key="Browser.ClassesTitle">Classes</sys:String>
  <sys:String x:Key="Browser.CollapsePaneTooltip">Collapse this pane (gives the space to the Inspector / Detail pane)</sys:String>
  <sys:String x:Key="Browser.ExpandPaneTooltip">Expand pane back</sys:String>
  <sys:String x:Key="Browser.FilterWatermark">filter…</sys:String>
  <sys:String x:Key="Browser.FilterFieldsWatermark">filter fields (name or type)…</sys:String>
  <sys:String x:Key="Browser.FilterMethodsWatermark">filter methods (name)…</sys:String>
  <sys:String x:Key="Inspector.FilterWatermark">filter walked fields (name or type)…</sys:String>
  <sys:String x:Key="Browser.Refresh">↻</sys:String>
  <sys:String x:Key="Browser.ShowInherited">Show inherited members</sys:String>
  <sys:String x:Key="Browser.FieldsTab">Fields</sys:String>
  <sys:String x:Key="Browser.MethodsTab">Methods</sys:String>
  <sys:String x:Key="Browser.ColName">Name</sys:String>
  <sys:String x:Key="Browser.ColOffset">Offset</sys:String>
  <sys:String x:Key="Browser.ColType">Type</sys:String>
  <sys:String x:Key="Browser.ColFlags">Flags</sys:String>
  <sys:String x:Key="Browser.ColStatic">static</sys:String>
  <sys:String x:Key="Browser.ColDeclaredIn">Declared in</sys:String>
  <sys:String x:Key="Browser.ColAddress">Address</sys:String>
  <sys:String x:Key="Browser.ColToken">Token</sys:String>
  <sys:String x:Key="Browser.InspectMenuItem">Inspect (find instances)…</sys:String>
  <sys:String x:Key="Browser.CopyClassNameMenu">Copy class name</sys:String>
  <sys:String x:Key="Browser.ExportSdkHeader">Export .h…</sys:String>
  <sys:String x:Key="Browser.ExportCsx">Export .csx…</sys:String>
  <sys:String x:Key="Browser.ExportCeXml">Export .CT…</sys:String>
  <sys:String x:Key="Browser.CopyCeXml">Copy CE XML</sys:String>
  <sys:String x:Key="Browser.CopyCeField">Copy CE field</sys:String>
  <sys:String x:Key="Browser.CopyFieldNameMenu">Copy field name</sys:String>
  <sys:String x:Key="Browser.CopyFieldTypeMenu">Copy type</sys:String>
  <sys:String x:Key="Browser.CopyFieldDeclaredInMenu">Copy "Declared in"</sys:String>
  <sys:String x:Key="Browser.CopyMethodNameMenu">Copy method name</sys:String>
  <sys:String x:Key="Browser.CopyMethodAddressMenu">Copy address</sys:String>
  <sys:String x:Key="Browser.CopyMethodDeclaredInMenu">Copy "Declared in"</sys:String>
  <sys:String x:Key="Browser.ExportOptions">Export options ▾</sys:String>
  <sys:String x:Key="Browser.OptDrilldownDepth">Drilldown depth</sys:String>
  <sys:String x:Key="Browser.OptArrayLimit">Array element limit</sys:String>
  <sys:String x:Key="Browser.OptCollapse">Collapse pointer/array nodes (CE XML)</sys:String>
  <sys:String x:Key="Browser.OptUseLiveData">Use live data in CE XML (real addresses, walks array elements)</sys:String>
  <sys:String x:Key="Browser.OptCeXmlBase">CE XML base address</sys:String>

  <!-- Phase 9 inspector panels. -->
  <sys:String x:Key="Inspector.Tab">Inspector</sys:String>
  <sys:String x:Key="Inspector.SetTarget">Inspect selected class</sys:String>
  <sys:String x:Key="Inspector.Find">Find instances</sys:String>
  <sys:String x:Key="Inspector.RefreshWalk">Re-walk</sys:String>
  <sys:String x:Key="Inspector.Clear">Clear</sys:String>
  <sys:String x:Key="Inspector.LimitLabel">Limit</sys:String>
  <sys:String x:Key="Inspector.AutoRefreshLabel">Auto refresh</sys:String>
  <sys:String x:Key="Inspector.AutoRefreshOff">Off</sys:String>
  <sys:String x:Key="Inspector.AutoRefresh250">250 ms</sys:String>
  <sys:String x:Key="Inspector.AutoRefresh1000">1 s</sys:String>
  <sys:String x:Key="Inspector.InstancesTitle">Instances</sys:String>
  <sys:String x:Key="Inspector.FieldsTitle">Walked fields</sys:String>
  <sys:String x:Key="Inspector.ClassPointerLabel">Class ptr</sys:String>
  <sys:String x:Key="Inspector.CopyClassNameTooltip">Copy fully-qualified class name (namespace.name)</sys:String>
  <sys:String x:Key="Inspector.CopyClassAddressTooltip">Copy class pointer address (0x...)</sys:String>
  <sys:String x:Key="Inspector.ColIndex">#</sys:String>
  <sys:String x:Key="Inspector.ColAddress">Address</sys:String>
  <sys:String x:Key="Inspector.ColValue">Value</sys:String>
  <sys:String x:Key="Inspector.NoTarget">No target — pick a class and press "Inspect selected class".</sys:String>
  <sys:String x:Key="Inspector.CopyCeXmlNode">Copy CE XML rooted here</sys:String>
  <sys:String x:Key="Inspector.CopyCeFieldNode">Copy CE field</sys:String>
  <sys:String x:Key="Inspector.ColActions">Actions</sys:String>
  <sys:String x:Key="Inspector.CopyAddrTooltip">Copy field address (e.g. 0x000001E5...)</sys:String>
  <sys:String x:Key="Inspector.CopyPtrTooltip">Copy pointer value (only meaningful for pointer-typed rows)</sys:String>
  <sys:String x:Key="Inspector.CopyNameTooltip">Copy field name</sys:String>
  <sys:String x:Key="Inspector.NavigateHexTooltip">Open Cheat Engine's Memory View at this address (requires AOBMaker plugin)</sys:String>
  <sys:String x:Key="Inspector.LookupAddressMenu">Find what's at this address…</sys:String>
  <!-- Phase 21a — reverse-property lookup. Right-click any value-typed
       Inspector row to list this field's address + value across every live
       instance of the current target class. Bails with a soft error when
       the selected row crosses a pointer-traversal or collection-element
       ancestor (see InspectorFieldOffsetResolver). -->
  <sys:String x:Key="Inspector.ListFieldAcrossInstancesMenu">List this field across instances…</sys:String>
  <!-- Phase 21b — Inspector field write-back. Right-click any value-typed
       primitive leaf to overwrite its storage in the host process via the
       new setInstanceField RPC. Hidden / disabled for reference / value-
       struct / collection rows (those need GC-root marshaling, deferred). -->
  <sys:String x:Key="Inspector.WriteFieldMenu">Write value…</sys:String>

  <!-- Phase 21b — Field write modal. -->
  <sys:String x:Key="FieldWrite.Title">Write field value</sys:String>
  <sys:String x:Key="FieldWrite.FieldLabel">Field</sys:String>
  <sys:String x:Key="FieldWrite.TypeLabel">Type</sys:String>
  <sys:String x:Key="FieldWrite.AddressLabel">Address</sys:String>
  <sys:String x:Key="FieldWrite.CurrentLabel">Current</sys:String>
  <sys:String x:Key="FieldWrite.NewValueLabel">New value</sys:String>
  <sys:String x:Key="FieldWrite.WriteButton">Write</sys:String>
  <sys:String x:Key="FieldWrite.CancelButton">Cancel</sys:String>
  <sys:String x:Key="FieldWrite.UnsupportedNote">This field's type isn't writable in v1. Reference types (System.String, object pointers), arrays/lists, and value-struct types like Vector3 are deferred to v2 — they need GC-root marshaling.</sys:String>

  <!-- Phase 21a — Field-across-instances modal. -->
  <sys:String x:Key="FieldAcross.Title">Field across live instances</sys:String>
  <sys:String x:Key="FieldAcross.HeaderLabel">Field</sys:String>
  <sys:String x:Key="FieldAcross.ClassLabel">Class</sys:String>
  <sys:String x:Key="FieldAcross.OffsetLabel">Offset</sys:String>
  <sys:String x:Key="FieldAcross.TypeLabel">Type</sys:String>
  <sys:String x:Key="FieldAcross.CountLabel">Matches</sys:String>
  <sys:String x:Key="FieldAcross.RefreshButton">Refresh</sys:String>
  <sys:String x:Key="FieldAcross.CloseButton">Close</sys:String>
  <sys:String x:Key="FieldAcross.ColInstance">Instance</sys:String>
  <sys:String x:Key="FieldAcross.ColFieldAddress">Field address</sys:String>
  <sys:String x:Key="FieldAcross.ColValue">Value</sys:String>
  <sys:String x:Key="FieldAcross.CopyInstanceMenu">Copy instance address</sys:String>
  <sys:String x:Key="FieldAcross.CopyFieldAddressMenu">Copy field address</sys:String>
  <sys:String x:Key="FieldAcross.CopyValueMenu">Copy value</sys:String>
  <sys:String x:Key="FieldAcross.ValueFilterLabel">Filter value</sys:String>
  <sys:String x:Key="FieldAcross.ValueFilterWatermark">substring match — e.g. 99, "Background", true</sys:String>
  <sys:String x:Key="FieldAcross.UnsupportedTitle">Reverse lookup not supported</sys:String>
  <sys:String x:Key="Inspector.CallMethodOnInstanceMenu">Call method on this instance… (switch to Methods)</sys:String>
  <sys:String x:Key="Inspector.CopyInstanceAddressMenu">Copy address to clipboard</sys:String>

  <!-- Phase 17c — Address Lookup tab (reverse address lookup; whatIsAt RPC). -->
  <sys:String x:Key="AddrLookup.Tab">Address Lookup</sys:String>

  <!-- Phase 25 — cross-class symbol finder. -->
  <sys:String x:Key="SymbolFinder.Tab">Symbol Finder</sys:String>
  <sys:String x:Key="SymbolFinder.AssemblyLabel">Assembly</sys:String>
  <sys:String x:Key="SymbolFinder.SearchAllUserAssemblies">Search all user assemblies</sys:String>
  <sys:String x:Key="SymbolFinder.SearchAllUserAssembliesTooltip">When checked, the picker is ignored and the search runs across every loaded assembly except Unity engine modules (UnityEngine.*, Unity.*) and the .NET / Mono base class libraries (System.*, mscorlib, netstandard, Microsoft.*, Mono.*).</sys:String>
  <sys:String x:Key="SymbolFinder.PatternWatermark">name substring (case-insensitive), e.g. MaxHP</sys:String>
  <sys:String x:Key="SymbolFinder.IncludeFields">Fields</sys:String>
  <sys:String x:Key="SymbolFinder.IncludeMethods">Methods</sys:String>
  <sys:String x:Key="SymbolFinder.LimitLabel">Limit</sys:String>
  <sys:String x:Key="SymbolFinder.SearchButton">Search</sys:String>
  <sys:String x:Key="SymbolFinder.ColKind">Kind</sys:String>
  <sys:String x:Key="SymbolFinder.ColAssembly">Assembly</sys:String>
  <sys:String x:Key="SymbolFinder.ColClass">Class</sys:String>
  <sys:String x:Key="SymbolFinder.ColMember">Member</sys:String>
  <sys:String x:Key="SymbolFinder.ColType">Type</sys:String>
  <sys:String x:Key="SymbolFinder.ColOffset">Offset</sys:String>
  <sys:String x:Key="SymbolFinder.ColAddress">Address</sys:String>
  <sys:String x:Key="SymbolFinder.NavigateMenu">Navigate to this in Browser</sys:String>
  <sys:String x:Key="SymbolFinder.CopyClassMenu">Copy class name</sys:String>
  <sys:String x:Key="SymbolFinder.CopyMemberMenu">Copy member name</sys:String>

  <!-- Phase 20b — Scene Explorer tab. -->
  <sys:String x:Key="Scene.Tab">Scene</sys:String>
  <sys:String x:Key="Scene.PatternWatermark">name substring (leave empty for first N), e.g. Player</sys:String>
  <sys:String x:Key="Scene.LimitLabel">Limit</sys:String>
  <sys:String x:Key="Scene.SearchButton">Search</sys:String>
  <sys:String x:Key="Scene.InspectMenu">Inspect this GameObject (switch to Inspector)</sys:String>
  <sys:String x:Key="Scene.CopyAddressMenu">Copy address</sys:String>
  <sys:String x:Key="Scene.CopyNameMenu">Copy name</sys:String>
  <sys:String x:Key="AddrLookup.AddressLabel">Address:</sys:String>
  <sys:String x:Key="AddrLookup.AddressWatermark">paste a hex address (e.g. 0x000001E55B2518F0)…</sys:String>
  <sys:String x:Key="AddrLookup.LookupButton">Lookup</sys:String>
  <sys:String x:Key="AddrLookup.ClearButton">Clear</sys:String>
  <sys:String x:Key="AddrLookup.ScanLabel">Backward scan (bytes)</sys:String>
  <sys:String x:Key="AddrLookup.ScanTooltip">How far back from the queried address to look for an object header. 4 KB matches the DLL default; raise (capped at 16 KB) only if a known-large class isn't getting matched.</sys:String>
  <sys:String x:Key="AddrLookup.ResultHeader">Result</sys:String>
  <sys:String x:Key="AddrLookup.InstanceLabel">Instance:</sys:String>
  <sys:String x:Key="AddrLookup.ClassLabel">Class:</sys:String>
  <sys:String x:Key="AddrLookup.OffsetLabel">Field offset:</sys:String>
  <sys:String x:Key="AddrLookup.FieldLabel">Field:</sys:String>
  <sys:String x:Key="AddrLookup.NearestLabel">Nearest field:</sys:String>
  <sys:String x:Key="AddrLookup.KindLabel">Kind:</sys:String>
  <sys:String x:Key="AddrLookup.ScannedLabel">Scan:</sys:String>
  <sys:String x:Key="AddrLookup.InspectInstance">Inspect this instance</sys:String>
  <sys:String x:Key="AddrLookup.CopyInstance">Copy instance address</sys:String>
  <!-- Phase 22e: push lookup result to CE's address list. -->
  <sys:String x:Key="AddrLookup.SendToCe">Send to CE Table…</sys:String>
  <sys:String x:Key="AddrLookup.SendToCeTooltip">Push the resolved instance pointer + field offsets to the open CE table as a parent AA-script entry plus child memory records. Requires "Load Discrete Bridge" enabled in CE.</sys:String>
  <sys:String x:Key="AddrLookup.NoResult">No managed instance found in the scanned window. Try raising the backward scan, or check the address is from a live heap-resident object.</sys:String>
  <sys:String x:Key="AddrLookup.NotFoundReason">Reason:</sys:String>

  <!-- Connection bar. -->
  <sys:String x:Key="Conn.Connect">Connect</sys:String>
  <sys:String x:Key="Conn.Disconnect">Disconnect</sys:String>
  <sys:String x:Key="Conn.StatusLabel">Status:</sys:String>
  <sys:String x:Key="Conn.Inject">Pick &amp; inject…</sys:String>
  <sys:String x:Key="Conn.ProxyDeploy">Proxy Deploy…</sys:String>
  <sys:String x:Key="Conn.ToolsMenu">Tools ▾</sys:String>

  <!-- Phase 22d: Tools menu — AOBMaker-backed CT mutation entries. -->
  <sys:String x:Key="Tools.InjectDiscreteBridge">Inject Discrete Bridge into CE Table…</sys:String>
  <sys:String x:Key="Tools.InjectDiscreteBridgeTooltip">Push the 7 bridge lua modules + a "Load Discrete Bridge" AA-script entry into the currently-open CE table via the AOBMaker plugin pipe. Cheat Engine must be running with the AOBMaker plugin loaded; you can have an empty table.</sys:String>
  <sys:String x:Key="Tools.AobMakerStatusLabel">AOBMaker:</sys:String>
  <sys:String x:Key="Tools.AobMakerConnected">connected</sys:String>
  <sys:String x:Key="Tools.AobMakerNotConnected">not connected</sys:String>

  <!-- Proxy Deploy window (Phase 12c, redesigned to UE5CEDumper-style
       multi-select bulk panel). -->
  <sys:String x:Key="Deploy.Title">Proxy DLL Deploy</sys:String>
  <sys:String x:Key="Deploy.FilterWatermark">filter (name or path)…</sys:String>
  <sys:String x:Key="Deploy.ShowUnsupported">Show 32-bit / unsupported</sys:String>
  <sys:String x:Key="Deploy.Refresh">↻ Rescan</sys:String>
  <sys:String x:Key="Deploy.SelectAll">Select all</sys:String>
  <sys:String x:Key="Deploy.UnselectAll">Unselect all</sys:String>
  <sys:String x:Key="Deploy.InvertSelection">Invert</sys:String>
  <sys:String x:Key="Deploy.DefaultKindLabel">When installing:</sys:String>
  <sys:String x:Key="Deploy.InstallSelected">Install selected</sys:String>
  <sys:String x:Key="Deploy.UninstallSelected">Uninstall selected</sys:String>
  <sys:String x:Key="Deploy.UpdateAll">Update all deployed</sys:String>
  <sys:String x:Key="Deploy.UpdateAllTooltip">Re-install with the proxy kind currently in place — push fresh DLLs after rebuilding DiscreteUI.</sys:String>
  <sys:String x:Key="Deploy.ColName">Game</sys:String>
  <sys:String x:Key="Deploy.ColBackend">Backend</sys:String>
  <sys:String x:Key="Deploy.ColBitness">Bits</sys:String>
  <sys:String x:Key="Deploy.ColProxy">Proxy</sys:String>
  <sys:String x:Key="Deploy.ColStatus">Status</sys:String>
  <sys:String x:Key="Deploy.ColVersion">Version</sys:String>
  <sys:String x:Key="Deploy.ColLastMessage">Last operation</sys:String>
  <sys:String x:Key="Deploy.ColPath">Game .exe path</sys:String>

  <!-- Process picker dialog. -->
  <sys:String x:Key="Picker.Title">Pick Unity process</sys:String>
  <sys:String x:Key="Picker.FilterWatermark">filter (name or PID)…</sys:String>
  <sys:String x:Key="Picker.ShowAll">Show all processes</sys:String>
  <sys:String x:Key="Picker.Refresh">↻ Refresh</sys:String>
  <sys:String x:Key="Picker.InjectAndConnect">Inject &amp; Connect</sys:String>
  <sys:String x:Key="Picker.Cancel">Cancel</sys:String>
  <sys:String x:Key="Picker.ColPid">PID</sys:String>
  <sys:String x:Key="Picker.ColName">Process</sys:String>
  <sys:String x:Key="Picker.ColBackend">Backend</sys:String>
  <sys:String x:Key="Picker.ColPath">Path</sys:String>

  <!-- Handshake panel labels. -->
  <sys:String x:Key="Handshake.Title">Handshake</sys:String>
  <sys:String x:Key="Handshake.Engine">Engine</sys:String>
  <sys:String x:Key="Handshake.Backend">Backend</sys:String>
  <sys:String x:Key="Handshake.DllVariant">DLL variant</sys:String>
  <sys:String x:Key="Handshake.GameModule">Game module</sys:String>
  <sys:String x:Key="Handshake.UnityVersion">Unity version</sys:String>
  <sys:String x:Key="Handshake.MetadataVersion">Metadata version</sys:String>
  <sys:String x:Key="Handshake.AssembliesCount">Assemblies</sys:String>
  <sys:String x:Key="Handshake.Build">Build</sys:String>
  <sys:String x:Key="Handshake.Protocol">Protocol</sys:String>

  <!-- Phase 18c / 19d — Methods grid context menu + Method Overloads modal. -->
  <sys:String x:Key="Browser.MethodFindOverloadsMenu">Find overloads…</sys:String>
  <sys:String x:Key="Browser.MethodCallMethodMenu">Call method… (pick overload)</sys:String>

  <sys:String x:Key="MethodOverloads.Title">Method overloads</sys:String>
  <sys:String x:Key="MethodOverloads.Refresh">Refresh</sys:String>
  <sys:String x:Key="MethodOverloads.SigFilterLabel">Signature filter</sys:String>
  <sys:String x:Key="MethodOverloads.SigFilterWatermark">substring narrows by signature, e.g. Vector3</sys:String>
  <sys:String x:Key="MethodOverloads.AobLengthLabel">AOB bytes</sys:String>
  <sys:String x:Key="MethodOverloads.ColSignature">Signature</sys:String>
  <sys:String x:Key="MethodOverloads.ColReturn">Returns</sys:String>
  <sys:String x:Key="MethodOverloads.ColAddress">Address</sys:String>
  <sys:String x:Key="MethodOverloads.ColSuffix">Suffix</sys:String>
  <sys:String x:Key="MethodOverloads.ColModifiers">Modifiers</sys:String>
  <!-- Bottom-bar actions, grouped by mechanism. "Copy …" puts an AA script
       (or raw addresses) on the clipboard; "Push … to CE" sends the same
       script through AOBMaker into CE's address list. Mechanism keywords
       (aobscan / registersymbol / mono_register) match the underlying CE
       commands so the user sees what each path emits. -->
  <sys:String x:Key="MethodOverloads.CopyAddresses">Copy: addresses</sys:String>
  <sys:String x:Key="MethodOverloads.CopyRegisterSymbol">Copy: registersymbol</sys:String>
  <sys:String x:Key="MethodOverloads.CopyAobScript">Copy: aobscan</sys:String>
  <sys:String x:Key="MethodOverloads.CreateAaInCe">Push aobscan to CE</sys:String>
  <sys:String x:Key="MethodOverloads.AutoActivate">Auto-activate</sys:String>
  <sys:String x:Key="MethodOverloads.Close">Close</sys:String>
  <sys:String x:Key="MethodOverloads.CallMethodMenu">Call method…</sys:String>
  <!-- DLL-free Mono path (helper file lives in the CT — Tools → Inject Discrete Bridge ships it) -->
  <sys:String x:Key="MethodOverloads.CopyMonoSymbolScript">Copy: mono_register</sys:String>
  <sys:String x:Key="MethodOverloads.CopyMonoSymbolScriptTooltip">DLL-free: generates an AA that calls mono_registerSymbolEx via CE's built-in Mono API. Mono targets only. Run Tools → Inject Discrete Bridge first to ship mono_registersymbol_helpers.lua into the cheat table.</sys:String>
  <sys:String x:Key="MethodOverloads.CreateMonoSymbolInCe">Push mono_register to CE</sys:String>
  <sys:String x:Key="MethodOverloads.CreateMonoSymbolInCeTooltip">Push the mono_register AA into CE's address list via AOBMaker. Same DLL-free Mono path as the Copy button — no UnityCEDumper DLL needed.</sys:String>

  <!-- Phase 19d — Call Method dialog -->
  <sys:String x:Key="MethodCall.Title">Call method</sys:String>
  <sys:String x:Key="MethodCall.ClassLabel">Class</sys:String>
  <sys:String x:Key="MethodCall.MethodLabel">Method</sys:String>
  <sys:String x:Key="MethodCall.SignatureLabel">Signature</sys:String>
  <sys:String x:Key="MethodCall.InstanceLabel">Instance address</sys:String>
  <sys:String x:Key="MethodCall.InstanceWatermark">0x... — leave empty for static methods</sys:String>
  <sys:String x:Key="MethodCall.RunOnMainThread">Run on Unity main thread (recommended for engine APIs)</sys:String>
  <sys:String x:Key="MethodCall.RunOnMainThreadTooltip">When checked, the call is queued onto the Unity main thread via the runtime_invoke hook (Phase 20-MT). Required for any UnityEngine.* method that touches the scene graph (Transform.parent, GameObject.name, etc.) — calling those from the pipe worker thread freezes the game. Pure-managed methods (Math.Abs / String.Concat / Convert.ToByte) run faster with this OFF.</sys:String>
  <sys:String x:Key="MethodCall.ParamsHeader">Parameters</sys:String>
  <sys:String x:Key="MethodCall.ParamColType">Type</sys:String>
  <sys:String x:Key="MethodCall.ParamColName">Name</sys:String>
  <sys:String x:Key="MethodCall.ParamColValue">Value</sys:String>
  <sys:String x:Key="MethodCall.ParamColNull">null</sys:String>
  <sys:String x:Key="MethodCall.NoParams">(no parameters)</sys:String>
  <sys:String x:Key="MethodCall.CallButton">Call</sys:String>
  <sys:String x:Key="MethodCall.CloseButton">Close</sys:String>
  <!-- Phase 22e: Send-to-CE button. Only visible when an AOBMaker bridge
       is wired (i.e. CE is open with the plugin loaded). -->
  <sys:String x:Key="MethodCall.SendToCeButton">Send to CE Table…</sys:String>
  <sys:String x:Key="MethodCall.SendToCeTooltip">Push the current method-call inputs to the open CE table as an AA-script entry. End-user toggles the entry's checkbox to repeat the call. Requires "Load Discrete Bridge" enabled in CE.</sys:String>
  <sys:String x:Key="MethodCall.ResultHeader">Result</sys:String>
  <sys:String x:Key="MethodCall.ResultOk">Returned</sys:String>
  <sys:String x:Key="MethodCall.ResultException">Managed exception</sys:String>
  <sys:String x:Key="MethodCall.ResultError">Error</sys:String>
  <sys:String x:Key="MethodCall.ResultElapsed">elapsed</sys:String>
  <sys:String x:Key="MethodCall.ResultNull">(null)</sys:String>
  <sys:String x:Key="MethodCall.ResultVoid">(void)</sys:String>
</ResourceDictionary>
