<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnityDumpUI.App"
             RequestedThemeVariant="Default">
  <!--
    RequestedThemeVariant="Default" → follow system theme (per project decision).
    No in-app dark/light toggle.
  -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://UnityDumpUI/Resources/Strings/en.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
