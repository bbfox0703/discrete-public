<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UnityDumpUI</RootNamespace>
    <!-- Repo is "discrete"; ship the EXE under that name. The C# root
         namespace + project directory stay UnityDumpUI to keep the
         existing using-tree and source-gen contracts intact. -->
    <AssemblyName>DiscreteUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- PE icon resource — surfaces in File Explorer, taskbar, alt-tab
         (before the window-level Icon property loads). The same .ico is
         also packaged as an avares resource below so runtime XAML can
         set Window.Icon to it. -->
    <ApplicationIcon>Assets\MainIcon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Native AOT (per docs/plan.md). Off during normal `dotnet build`,
         enabled with -p:PublishAot=true on `dotnet publish`. -->
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <TrimMode>partial</TrimMode>

    <!-- Avalonia 12 requirement: must be false for Native AOT. -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- Compiled XAML bindings only (no reflection — required for AOT). -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- LibraryImport source generator (WindowsDllInjector / WindowsProcessEnumerator)
         emits unsafe blocks. Required so its generated code compiles. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- IL3053: third-party AOT analysis warnings from Avalonia/MicroCom (safe; covered by TrimmerRootAssembly).
         IL2104: DataGrid trim warning — preserved via TrimmerRootAssembly below. -->
    <NoWarn>$(NoWarn);IL3053;IL2104</NoWarn>

    <!-- =====================================================================
         Version metadata. Major/Minor/Patch must stay in sync with the
         project() VERSION clause in the root CMakeLists.txt — both sides
         read build_number.txt for the auto-incremented 4th digit. The
         resulting string is embedded as the PE FileVersion (visible in File
         Explorer's Properties pane), as the AssemblyVersion / FileVersion /
         InformationalVersion attributes (readable at runtime via reflection),
         and printed at UI startup as a log banner so each ui/init/current.log
         unambiguously identifies which DiscreteUI.exe build wrote it.
         ===================================================================== -->
    <VerMajor>0</VerMajor>
    <VerMinor>1</VerMinor>
    <VerPatch>0</VerPatch>
    <BuildNumberFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\build_number.txt'))</BuildNumberFile>
    <VerBuild Condition="Exists('$(BuildNumberFile)')">$([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim())</VerBuild>
    <VerBuild Condition="'$(VerBuild)' == ''">0</VerBuild>

    <Version>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</Version>
    <AssemblyVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</AssemblyVersion>
    <FileVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</FileVersion>
    <InformationalVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</InformationalVersion>
    <Product>Discrete</Product>
    <Company>Discrete</Company>
    <Description>Unity Engine Dumper UI (Mono + IL2CPP backends, Cheat Engine bridge)</Description>
    <!-- AssemblyTitle drives the PE FileDescription field (Description column
         in File Explorer); defaults to AssemblyName otherwise. -->
    <AssemblyTitle>Discrete UI (Mono + IL2CPP)</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Let the xUnit project assert on internal regression seams (e.g.
         ValueSearchViewModel.ParallelArg and the scan-status note helpers)
         without widening the public API. Mirrors Core's IVT to the same
         test assembly. -->
    <InternalsVisibleTo Include="UnityDumpUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 12 — Windows-only build. We deliberately do NOT reference
         Avalonia.Desktop (the cross-platform metapackage), because it drags
         in Avalonia.X11 + Avalonia.FreeDesktop + Tmds.DBus.Protocol — all
         dead on win-x64 but still present in the trimmed assembly graph,
         which makes ILC emit "will always throw" diagnostics for the
         Linux entry points whose DBus types were trimmed away. Avalonia.Win32
         is the bare Windows backend. -->
    <!-- $(AvaloniaVersion) / $(SkiaSharpVersion) / $(HarfBuzzSharpVersion) are
         defined in ../Directory.Build.props — read the ⚠ block there BEFORE
         bumping any of them. Avalonia.Angle.Windows.Natives is versioned
         independently (its own date-stamped scheme), so it stays literal. -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Angle.Windows.Natives" Version="2.1.27548.20260419" />
    <PackageReference Include="Avalonia.Win32" Version="$(AvaloniaVersion)" />
    <!-- Avalonia.Desktop used to bring Skia + HarfBuzz in transitively. With
         Desktop dropped, we have to reference both explicitly — Skia is the
         rendering backend; HarfBuzz is the text shaper. AppBuilder.Setup
         throws "No text shaping system configured" if HarfBuzz isn't
         registered (Avalonia 12 breaking change — UsePlatformDetect used to
         wire it in for free; UseSkia by itself does not). -->
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <!-- Avalonia.Controls.DataGrid is NOT part of $(AvaloniaVersion): it ships
         from its own repo (AvaloniaUI/Avalonia.Controls.DataGrid) on its own
         cadence, so its patch number legitimately runs ahead of Avalonia core
         (12.1.2 vs core's newest 12.1.1 — core has no 12.1.2). Same carve-out
         as Avalonia.Angle.Windows.Natives above.
         Kept at 12.1.2 deliberately: 12.1.0 → 12.1.2 is three commits, two of
         which are scrolling/layout fixes this app's grids depend on —
         "vertical scrollbar LargeChange synchronization" and "scroll chaining
         at layout-rounded boundaries". The 2026-08-18 density pass leans on
         exactly that behaviour (Auto-width columns overflowing into horizontal
         scroll, reveal strips re-laying the grid out on toggle).
         It declares Avalonia >= 12.1.0, i.e. the same open-ended lower bound
         that hid the SkiaSharp drift — so if core ever moves, re-check this
         pin by hand; NuGet will not. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />

    <!-- AOT-friendly MVVM via source generators ([ObservableProperty], [RelayCommand]).
         Avalonia.ReactiveUI is NOT used: it has no v12 release and depends on reflection. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HarfBuzzSharp" Version="$(HarfBuzzSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="$(HarfBuzzSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="$(HarfBuzzSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="$(HarfBuzzSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="$(HarfBuzzSharpVersion)" />
    <PackageReference Include="MicroCom.Runtime" Version="0.11.6" />
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityDumpUI.Core\UnityDumpUI.Core.csproj" />
  </ItemGroup>

  <!-- Native AOT static CRT — `build.cmd publish` should produce an exe
       that runs on a bare Windows install without VC++ Redistributable.
       The redist provides vcruntime140.dll + msvcp140.dll; swap msvcrt
       and vcruntime for their static counterparts (libcmt, libvcruntime)
       so those symbols inline into the .exe. UCRT (ucrtbase.dll) stays
       dynamic — it's a Windows 10/11 OS component, not a redist payload,
       and the .NET AOT targets pin /DEFAULTLIB:ucrt.lib at the end of
       link.rsp anyway (overriding any /NODEFAULTLIB:ucrt.lib we'd add).
       Only fires when PublishAot=true so Debug / Release single-file
       publishes keep the dynamic CRT. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <LinkerArg Include="/NODEFAULTLIB:msvcrt.lib" />
    <LinkerArg Include="/NODEFAULTLIB:msvcrtd.lib" />
    <LinkerArg Include="/NODEFAULTLIB:vcruntime.lib" />
    <LinkerArg Include="/NODEFAULTLIB:vcruntimed.lib" />
    <LinkerArg Include="/DEFAULTLIB:libvcruntime.lib" />
    <LinkerArg Include="/DEFAULTLIB:libcmt.lib" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\**" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- AOT trimmer roots: Avalonia loads platform/render backends via reflection;
       without these, the trimmer drops them and the app NREs at startup. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Avalonia" />
    <TrimmerRootAssembly Include="Avalonia.Base" />
    <TrimmerRootAssembly Include="Avalonia.Markup" />
    <TrimmerRootAssembly Include="Avalonia.Markup.Xaml" />
    <TrimmerRootAssembly Include="Avalonia.MicroCom" />
    <TrimmerRootAssembly Include="Avalonia.Controls" />
    <TrimmerRootAssembly Include="Avalonia.Controls.DataGrid" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="Avalonia.Win32" />
    <TrimmerRootAssembly Include="Avalonia.Win32.Automation" />
    <TrimmerRootAssembly Include="Avalonia.Skia" />
    <TrimmerRootAssembly Include="Avalonia.Fonts.Inter" />
    <TrimmerRootAssembly Include="MicroCom.Runtime" />
  </ItemGroup>
</Project>
