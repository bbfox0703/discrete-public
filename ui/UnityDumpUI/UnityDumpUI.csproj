<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UnityDumpUI</RootNamespace>
    <!-- Repo is "discrete"; ship the EXE under that name. The C# root
         namespace + project directory stay UnityDumpUI to keep the
         existing using-tree and source-gen contracts intact. -->
    <AssemblyName>DiscreteUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Native AOT (per docs/plan.md). Off during normal `dotnet build`,
         enabled with -p:PublishAot=true on `dotnet publish`. -->
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <TrimMode>partial</TrimMode>

    <!-- Avalonia 12 requirement: must be false for Native AOT. -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- Compiled XAML bindings only (no reflection — required for AOT). -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- LibraryImport source generator (WindowsDllInjector / WindowsProcessEnumerator)
         emits unsafe blocks. Required so its generated code compiles. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- IL3053: third-party AOT analysis warnings from Avalonia/MicroCom (safe; covered by TrimmerRootAssembly).
         IL2104: DataGrid trim warning — preserved via TrimmerRootAssembly below. -->
    <NoWarn>$(NoWarn);IL3053;IL2104</NoWarn>

    <!-- =====================================================================
         Version metadata. Major/Minor/Patch must stay in sync with the
         project() VERSION clause in the root CMakeLists.txt — both sides
         read build_number.txt for the auto-incremented 4th digit. The
         resulting string is embedded as the PE FileVersion (visible in File
         Explorer's Properties pane), as the AssemblyVersion / FileVersion /
         InformationalVersion attributes (readable at runtime via reflection),
         and printed at UI startup as a log banner so each ui/init/current.log
         unambiguously identifies which DiscreteUI.exe build wrote it.
         ===================================================================== -->
    <VerMajor>0</VerMajor>
    <VerMinor>1</VerMinor>
    <VerPatch>0</VerPatch>
    <BuildNumberFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\build_number.txt'))</BuildNumberFile>
    <VerBuild Condition="Exists('$(BuildNumberFile)')">$([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim())</VerBuild>
    <VerBuild Condition="'$(VerBuild)' == ''">0</VerBuild>

    <Version>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</Version>
    <AssemblyVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</AssemblyVersion>
    <FileVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</FileVersion>
    <InformationalVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</InformationalVersion>
    <Product>UnityCEDumper</Product>
    <Company>UnityCEDumper</Company>
    <Description>Unity Engine Dumper UI (Mono + IL2CPP backends, Cheat Engine bridge)</Description>
    <!-- AssemblyTitle drives the PE FileDescription field (Description column
         in File Explorer); defaults to AssemblyName otherwise. -->
    <AssemblyTitle>UnityCEDumper UI (Mono + IL2CPP)</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 12 -->
    <PackageReference Include="Avalonia"               Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop"       Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter"   Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />

    <!-- AOT-friendly MVVM via source generators ([ObservableProperty], [RelayCommand]).
         Avalonia.ReactiveUI is NOT used: it has no v12 release and depends on reflection. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />

    <!-- Override transitive Tmds.DBus.Protocol to dodge NU1903 (CVE in 0.90.x).
         Linux-only dependency; we ship win-x64 but NuGet still audits it. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityDumpUI.Core\UnityDumpUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\**" />
  </ItemGroup>

  <!-- AOT trimmer roots: Avalonia loads platform/render backends via reflection;
       without these, the trimmer drops them and the app NREs at startup. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Avalonia" />
    <TrimmerRootAssembly Include="Avalonia.Base" />
    <TrimmerRootAssembly Include="Avalonia.Markup" />
    <TrimmerRootAssembly Include="Avalonia.Markup.Xaml" />
    <TrimmerRootAssembly Include="Avalonia.MicroCom" />
    <TrimmerRootAssembly Include="Avalonia.Controls" />
    <TrimmerRootAssembly Include="Avalonia.Controls.DataGrid" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="Avalonia.Desktop" />
    <TrimmerRootAssembly Include="Avalonia.Win32" />
    <TrimmerRootAssembly Include="Avalonia.Win32.Automation" />
    <TrimmerRootAssembly Include="Avalonia.Skia" />
    <TrimmerRootAssembly Include="Avalonia.Fonts.Inter" />
    <TrimmerRootAssembly Include="MicroCom.Runtime" />
  </ItemGroup>
</Project>
