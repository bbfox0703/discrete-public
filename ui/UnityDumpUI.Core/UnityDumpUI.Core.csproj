<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Core: engine-agnostic models, services, platform interfaces.
    Per Architecture.md Rule "Platform Abstraction": Core must NEVER contain
    direct platform-specific code. P/Invoke, Registry, OS commands all live
    behind interfaces declared here and implemented in UnityDumpUI.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UnityDumpUI.Core</RootNamespace>
    <AssemblyName>UnityDumpUI.Core</AssemblyName>

    <!-- Version metadata mirrors UnityDumpUI.csproj — synced with the
         project() VERSION in the root CMakeLists.txt + build_number.txt. -->
    <VerMajor>0</VerMajor>
    <VerMinor>1</VerMinor>
    <VerPatch>0</VerPatch>
    <BuildNumberFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\build_number.txt'))</BuildNumberFile>
    <VerBuild Condition="Exists('$(BuildNumberFile)')">$([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim())</VerBuild>
    <VerBuild Condition="'$(VerBuild)' == ''">0</VerBuild>

    <Version>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</Version>
    <AssemblyVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</AssemblyVersion>
    <FileVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</FileVersion>
    <InformationalVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</InformationalVersion>
    <Product>UnityCEDumper</Product>
    <Company>UnityCEDumper</Company>
    <Description>Unity Engine Dumper UI core (engine-agnostic models, services, platform interfaces)</Description>
    <AssemblyTitle>UnityCEDumper UI core</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase 22a: AobMakerBridge has a test-only ctor that overrides the
         pipe name, so the test rig can spin up a fake NamedPipeServerStream
         on a per-test GUID-suffixed pipe (no collision with a real AOBMaker
         install on the dev box). -->
    <InternalsVisibleTo Include="UnityDumpUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 22b: embed the 7 CE Lua bridge scripts so DiscreteUI can
         push them into a currently-open CE table via AOBMaker plugin's
         InjectTableFile (Phase 22a). LogicalName uses a stable prefix so
         BridgeLuaResources.cs can enumerate by suffix without depending on
         the physical Include path (scripts/ lives outside the project tree).
         Mirrors UE5CEDumper's HelperLuaResource pattern, scaled from 1 to 7
         files. -->
    <EmbeddedResource Include="..\..\scripts\utils.lua">
      <LogicalName>UnityDumpUI.Core.Resources.Bridge.utils.lua</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\scripts\unity_dump.lua">
      <LogicalName>UnityDumpUI.Core.Resources.Bridge.unity_dump.lua</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\scripts\unity_dissect.lua">
      <LogicalName>UnityDumpUI.Core.Resources.Bridge.unity_dissect.lua</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\scripts\unity_symbols.lua">
      <LogicalName>UnityDumpUI.Core.Resources.Bridge.unity_symbols.lua</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\scripts\unity_addrfind.lua">
      <LogicalName>UnityDumpUI.Core.Resources.Bridge.unity_addrfind.lua</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\scripts\unity_invoke.lua">
      <LogicalName>UnityDumpUI.Core.Resources.Bridge.unity_invoke.lua</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\scripts\unity_scene.lua">
      <LogicalName>UnityDumpUI.Core.Resources.Bridge.unity_scene.lua</LogicalName>
    </EmbeddedResource>
    <!-- DLL-free Mono symbol register helpers. Used by the
         Methods-tab overload picker's "Copy mono_register* AA script"
         action: the generated AA pulls this file out of the CT via
         findTableFile and chunk-loads it, so end users get
         registerSymbol() without injecting the Unity dumper DLL. -->
    <EmbeddedResource Include="..\..\scripts\mono_registersymbol_helpers.lua">
      <LogicalName>UnityDumpUI.Core.Resources.Bridge.mono_registersymbol_helpers.lua</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
