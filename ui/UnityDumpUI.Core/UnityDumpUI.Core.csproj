<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Core: engine-agnostic models, services, platform interfaces.
    Per Architecture.md Rule "Platform Abstraction": Core must NEVER contain
    direct platform-specific code. P/Invoke, Registry, OS commands all live
    behind interfaces declared here and implemented in UnityDumpUI.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UnityDumpUI.Core</RootNamespace>
    <AssemblyName>UnityDumpUI.Core</AssemblyName>

    <!-- Version metadata mirrors UnityDumpUI.csproj — synced with the
         project() VERSION in the root CMakeLists.txt + build_number.txt. -->
    <VerMajor>0</VerMajor>
    <VerMinor>1</VerMinor>
    <VerPatch>0</VerPatch>
    <BuildNumberFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\build_number.txt'))</BuildNumberFile>
    <VerBuild Condition="Exists('$(BuildNumberFile)')">$([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim())</VerBuild>
    <VerBuild Condition="'$(VerBuild)' == ''">0</VerBuild>

    <Version>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</Version>
    <AssemblyVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</AssemblyVersion>
    <FileVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</FileVersion>
    <InformationalVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</InformationalVersion>
    <Product>UnityCEDumper</Product>
    <Company>UnityCEDumper</Company>
    <Description>Unity Engine Dumper UI core (engine-agnostic models, services, platform interfaces)</Description>
    <AssemblyTitle>UnityCEDumper UI core</AssemblyTitle>
  </PropertyGroup>
</Project>
