; winmm.def — public exports for the winmm.dll proxy. Aliases the
; Proxy_<symbol> internal C functions defined in winmm.cpp to their
; public winmm.dll names. See version.def for the why.

LIBRARY winmm

EXPORTS
    timeGetTime              = Proxy_timeGetTime
    timeBeginPeriod          = Proxy_timeBeginPeriod
    timeEndPeriod            = Proxy_timeEndPeriod
    timeGetDevCaps           = Proxy_timeGetDevCaps
    timeGetSystemTime        = Proxy_timeGetSystemTime
    timeKillEvent            = Proxy_timeKillEvent
    timeSetEvent             = Proxy_timeSetEvent

    mciSendStringA           = Proxy_mciSendStringA
    mciSendStringW           = Proxy_mciSendStringW
    mciSendCommandA          = Proxy_mciSendCommandA
    mciSendCommandW          = Proxy_mciSendCommandW
    mciGetDeviceIDA          = Proxy_mciGetDeviceIDA
    mciGetDeviceIDW          = Proxy_mciGetDeviceIDW

    waveOutOpen              = Proxy_waveOutOpen
    waveOutClose             = Proxy_waveOutClose
    waveOutPrepareHeader     = Proxy_waveOutPrepareHeader
    waveOutUnprepareHeader   = Proxy_waveOutUnprepareHeader
    waveOutWrite             = Proxy_waveOutWrite
    waveOutReset             = Proxy_waveOutReset
    waveOutGetNumDevs        = Proxy_waveOutGetNumDevs
    waveOutGetDevCapsA       = Proxy_waveOutGetDevCapsA
    waveOutGetDevCapsW       = Proxy_waveOutGetDevCapsW
    waveOutGetPosition       = Proxy_waveOutGetPosition
    waveOutGetErrorTextA     = Proxy_waveOutGetErrorTextA
    waveOutGetErrorTextW     = Proxy_waveOutGetErrorTextW
    waveOutPause             = Proxy_waveOutPause
    waveOutRestart           = Proxy_waveOutRestart
    waveOutGetVolume         = Proxy_waveOutGetVolume
    waveOutSetVolume         = Proxy_waveOutSetVolume
    waveOutGetID             = Proxy_waveOutGetID
    waveOutMessage           = Proxy_waveOutMessage

    ; waveIn* — UnityPlayer.dll statically imports all of these; missing any
    ; one of them stops the game from starting at all.
    waveInGetNumDevs         = Proxy_waveInGetNumDevs
    waveInGetDevCapsA        = Proxy_waveInGetDevCapsA
    waveInGetDevCapsW        = Proxy_waveInGetDevCapsW
    waveInOpen               = Proxy_waveInOpen
    waveInClose              = Proxy_waveInClose
    waveInPrepareHeader      = Proxy_waveInPrepareHeader
    waveInUnprepareHeader    = Proxy_waveInUnprepareHeader
    waveInAddBuffer          = Proxy_waveInAddBuffer
    waveInStart              = Proxy_waveInStart
    waveInStop               = Proxy_waveInStop
    waveInReset              = Proxy_waveInReset
    waveInGetPosition        = Proxy_waveInGetPosition
    waveInGetErrorTextA      = Proxy_waveInGetErrorTextA
    waveInGetErrorTextW      = Proxy_waveInGetErrorTextW
    waveInMessage            = Proxy_waveInMessage

    midiOutGetNumDevs        = Proxy_midiOutGetNumDevs
    midiOutGetDevCapsA       = Proxy_midiOutGetDevCapsA
    midiOutGetDevCapsW       = Proxy_midiOutGetDevCapsW
    midiOutOpen              = Proxy_midiOutOpen
    midiOutClose             = Proxy_midiOutClose
    midiOutShortMsg          = Proxy_midiOutShortMsg
    midiOutLongMsg           = Proxy_midiOutLongMsg
    midiOutPrepareHeader     = Proxy_midiOutPrepareHeader
    midiOutUnprepareHeader   = Proxy_midiOutUnprepareHeader
    midiOutReset             = Proxy_midiOutReset

    midiInGetNumDevs         = Proxy_midiInGetNumDevs
    midiInGetDevCapsA        = Proxy_midiInGetDevCapsA
    midiInGetDevCapsW        = Proxy_midiInGetDevCapsW
    midiInOpen               = Proxy_midiInOpen
    midiInClose              = Proxy_midiInClose
    midiInStart              = Proxy_midiInStart
    midiInStop               = Proxy_midiInStop
    midiInReset              = Proxy_midiInReset

    midiStreamOpen           = Proxy_midiStreamOpen
    midiStreamClose          = Proxy_midiStreamClose
    midiStreamOut            = Proxy_midiStreamOut
    midiStreamPause          = Proxy_midiStreamPause
    midiStreamRestart        = Proxy_midiStreamRestart
    midiStreamStop           = Proxy_midiStreamStop
    midiStreamProperty       = Proxy_midiStreamProperty
    midiStreamPosition       = Proxy_midiStreamPosition

    joyGetNumDevs            = Proxy_joyGetNumDevs
    joyGetPos                = Proxy_joyGetPos
    joyGetPosEx              = Proxy_joyGetPosEx
    joyGetDevCapsA           = Proxy_joyGetDevCapsA
    joyGetDevCapsW           = Proxy_joyGetDevCapsW

    mixerGetNumDevs          = Proxy_mixerGetNumDevs
    mixerOpen                = Proxy_mixerOpen
    mixerClose               = Proxy_mixerClose
    mixerGetLineInfoA        = Proxy_mixerGetLineInfoA
    mixerGetLineInfoW        = Proxy_mixerGetLineInfoW
    mixerGetLineControlsA    = Proxy_mixerGetLineControlsA
    mixerGetLineControlsW    = Proxy_mixerGetLineControlsW
    mixerGetControlDetailsA  = Proxy_mixerGetControlDetailsA
    mixerGetControlDetailsW  = Proxy_mixerGetControlDetailsW
    mixerSetControlDetails   = Proxy_mixerSetControlDetails

    mmioOpenA                = Proxy_mmioOpenA
    mmioOpenW                = Proxy_mmioOpenW
    mmioClose                = Proxy_mmioClose
    mmioRead                 = Proxy_mmioRead
    mmioWrite                = Proxy_mmioWrite
    mmioSeek                 = Proxy_mmioSeek
    mmioDescend              = Proxy_mmioDescend
    mmioAscend               = Proxy_mmioAscend

    PlaySoundA               = Proxy_PlaySoundA
    PlaySoundW               = Proxy_PlaySoundW
