#pragma once

// Auto-generated by CMake from BuildInfo.h.in — DO NOT EDIT.
//
// Provides build-time version constants for every C++ target (backend
// DLLs + proxy DLLs + metadata-cli). Also referenced by version.rc.in
// to populate the PE VERSIONINFO resource so File Explorer / DLL
// dependency walkers / `Get-ItemProperty` show the same version a log
// banner would print.

// Product version. Major / Minor / Patch from project(... VERSION ...)
// in the root CMakeLists.txt. Build comes from build_number.txt and is
// auto-incremented by build.ps1 — never hand-edit.
#define UNITYCEDUMPER_VER_MAJOR  @VER_MAJOR@
#define UNITYCEDUMPER_VER_MINOR  @VER_MINOR@
#define UNITYCEDUMPER_VER_PATCH  @VER_PATCH@
#define UNITYCEDUMPER_VER_BUILD  @BUILD_NUMBER@

#define UNITYCEDUMPER_GIT_HASH        "@GIT_COMMIT_HASH@"
#define UNITYCEDUMPER_GIT_SHORT       "@GIT_COMMIT_SHORT@"
#define UNITYCEDUMPER_GIT_DIRTY_FLAG  @GIT_IS_DIRTY@
#define UNITYCEDUMPER_BUILD_TIMESTAMP "@BUILD_TIMESTAMP@"
#define UNITYCEDUMPER_BUILD_CONFIG    "@CMAKE_BUILD_TYPE@"

// "0.1.0.135" — used by version.rc and matches the FileVersion in PE.
#define UNITYCEDUMPER_FILE_VERSION_STRING \
    "@VER_MAJOR@.@VER_MINOR@.@VER_PATCH@.@BUILD_NUMBER@"

// "0.1.0.135 abc1234 (Release, 2026-05-05T21:00:00Z)"
// Used in log banners so each per-PID log unambiguously identifies which
// DLL build wrote it.
#define UNITYCEDUMPER_BUILD_BANNER \
    UNITYCEDUMPER_FILE_VERSION_STRING " " UNITYCEDUMPER_GIT_SHORT \
    " (" UNITYCEDUMPER_BUILD_CONFIG ", " UNITYCEDUMPER_BUILD_TIMESTAMP ")"
